<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="application-version" content="35">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
<title>@venturerer III: Pokermon Edition</title>
<link href="https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=VT323&display=swap" rel="stylesheet">
<style>
:root{
  --g:#c8b888;--dg:#7a6a4a;--bg:#080604;--am:#c8a84e;
  --re:#cc4444;--cy:#55bbcc;--mg:#bb66cc;--ye:#ccbb44;--bl:#6699cc;
  --bdr:#3a2e1e;
  --zone-accent:#c8a84e;
  --zone-view-bg:#08080e;
  --zone-view-floor:#121214;
  --zone-view-tint:rgba(200,168,78,0.05);
  --zone-view-vignette:rgba(0,0,0,0.22);
  --zone-map-bg:rgba(8,8,10,0.82);
  --zone-map-wall:#4a4a50;
  --zone-map-floor:#1a150e;
  --zone-map-grid:rgba(80,65,40,0.25);
  --zone-battle-sky-top:#ebe7f2;
  --zone-battle-sky-bot:#e1dae8;
  --zone-battle-ground-top:#d2c6b6;
  --zone-battle-ground-bottom:#a68e6b;
  --zone-battle-glow:rgba(255,255,255,0.22);
  --zone-battle-ground-shade:rgba(0,0,0,0.08);
}
*{box-sizing:border-box;margin:0;padding:0;}
html,body{height:100%;}
body{
  background:#080604;color:#c8b888;
  font-family:'Share Tech Mono',monospace;font-size:13px;
  display:flex;flex-direction:column;align-items:center;
  justify-content:flex-start;overflow:hidden;height:100vh;
}

#wrap{width:min(1180px,calc(100vw - 8px));display:flex;flex-direction:column;height:100vh;}

#hdr{
  font-family:'VT323',monospace;font-size:20px;color:#c8a84e;
  letter-spacing:3px;text-shadow:0 0 8px rgba(200,168,78,0.5);text-align:center;
  padding:3px 0 3px;flex-shrink:0;
}
#hdr .zone-tag{display:inline-block;margin-left:12px;color:var(--zone-accent);font-size:.74em;letter-spacing:2px;opacity:.96;vertical-align:middle;}

.scr{display:none;flex:1;min-height:0;}
/* Scrollbar styling */
::-webkit-scrollbar {
  width: 6px;
  height: 6px;
}
::-webkit-scrollbar-track {
  background: #0a0806;
}
::-webkit-scrollbar-thumb {
  background: #3a2e1e;
  border-radius: 3px;
}
::-webkit-scrollbar-thumb:hover {
  background: #5a4e3e;
}
* {
  scrollbar-width: thin;
  scrollbar-color: #3a2e1e #0a0806;
}
/* TITLE */
#s-title{flex-direction:column;align-items:center;justify-content:center;gap:14px;text-align:center;padding:18px 12px;}
#s-title.on{display:flex;}
#s-title.title-death{justify-content:flex-start;gap:10px;padding-top:26px;}
#s-title.title-death #t-art-img{max-width:min(300px,70vw)!important;opacity:.95;}
#s-title.title-death > div[style*="font-size:28px"]{margin-top:0!important;}
#s-title.title-death #death-msg,
#s-title.title-death #score-table{width:min(760px,92vw);max-width:min(760px,92vw);}
#s-title.title-death #score-table{max-height:min(34vh,260px);overflow-y:auto;border:2px solid #3a2e1e;background:linear-gradient(180deg,#14100a,#0a0806);padding:12px 16px;box-shadow:0 0 24px rgba(0,0,0,0.32);}
#s-title.title-death .blink{margin-top:2px;}
#t-art{font-family:'VT323',monospace;font-size:48px;letter-spacing:6px;color:#c8a84e;
  text-shadow:0 0 12px rgba(200,168,78,0.5),0 0 30px rgba(200,168,78,.2);}
.t-sub{font-size:12px;color:#7a6a4a;line-height:2;}

/* DUNGEON - first person */
#s-dun.on{display:grid;grid-template-columns:1fr 236px;grid-template-rows:1fr 84px;gap:6px;padding:0 0 6px;}
#view-wrap{grid-column:1;grid-row:1;border:2px solid #3a2e1e;background:#000;overflow:hidden;position:relative;}
#view-canvas{width:100%;height:100%;display:block;image-rendering:pixelated;}
#compass{display:none;}
#minimap-wrap{margin-top:auto;padding-top:8px;display:flex;flex-direction:column;align-items:flex-end;gap:4px;}
#minimap{position:static;width:132px;height:132px;border:2px solid rgba(58,46,30,.65);background:rgba(0,0,0,.45);box-shadow:0 0 10px rgba(0,0,0,.45);image-rendering:pixelated;align-self:flex-end;}
#minimap-label{display:none;}

#stat-col{grid-column:2;grid-row:1/3;border:2px solid #3a2e1e;background:linear-gradient(180deg,#14100a,#0a0806);padding:6px;overflow:hidden;display:flex;flex-direction:column;gap:1px;}
#log-wrap{grid-column:1;grid-row:2;border:2px solid #3a2e1e;background:linear-gradient(180deg,#14100a,#0a0806);padding:3px 6px;overflow:hidden;}
#log-inner{font-size:11px;line-height:1.45;overflow-y:auto;height:100%;}

/* COMBAT */
#s-cmb.on{
  display:grid;
  grid-template-columns:minmax(0,1fr) 356px;
  grid-template-rows:252px minmax(0,1fr);
  gap:8px;
  padding:0 0 4px;
  min-height:0;
  height:100%;
  overflow:hidden;
}
#e-panel{
  grid-column:1;
  grid-row:1;
  border:2px solid #3a2e1e;
  background:linear-gradient(180deg,#1a140f 0%,#100a08 55%,#0b0806 100%);
  padding:0;
  overflow:hidden;
  position:relative;
  min-height:0;
}
#battlefield{
  position:relative;
  width:100%;
  height:100%;
  background:linear-gradient(180deg,var(--zone-battle-sky-top) 0%,var(--zone-battle-sky-bot) 64%,var(--zone-battle-ground-top) 64%,var(--zone-battle-ground-bottom) 100%);
}
#battlefield::before{
  content:'';
  position:absolute;
  inset:0;
  background:linear-gradient(180deg,var(--zone-battle-glow),transparent 18%,transparent 78%,var(--zone-battle-ground-shade));
  pointer-events:none;
}
#battlefield::after{
  content:'';
  position:absolute;
  left:0; right:0; bottom:0;
  height:38%;
  background:linear-gradient(180deg,rgba(255,255,255,0.02),var(--zone-battle-ground-shade));
  pointer-events:none;
}
#b-panel{
  grid-column:2;
  grid-row:1;
  border:2px solid #3a2e1e;
  background:linear-gradient(180deg,#16110c,#0d0907);
  padding:8px;
  overflow:hidden;
  display:flex;
  flex-direction:column;
  min-height:0;
}
.c-hudbox{
  min-width:0;
  background:rgba(246,242,248,0.97);
  color:#161214;
  border:4px solid #2b2016;
  box-shadow:3px 3px 0 rgba(43,32,22,0.28);
  padding:8px 10px 7px;
  font-family:'VT323',monospace;
}
.c-name{
  font-size:22px;
  letter-spacing:1px;
  line-height:1;
  white-space:nowrap;
  overflow:hidden;
  text-overflow:ellipsis;
}
.c-sub{
  font-size:16px;
  line-height:1.05;
  color:#3b3024;
  display:flex;
  gap:10px;
  align-items:center;
  margin-top:3px;
}
.c-sub.player-sub{justify-content:space-between;}
.c-hp-row{display:flex;align-items:center;gap:6px;margin-top:6px;}
.c-hp-lbl{font-size:18px;line-height:1;color:#21180f;min-width:24px;}
.c-hp-track{flex:1;height:11px;border:3px solid #2b2016;background:#f5f2f4;box-shadow:inset 0 0 0 1px rgba(0,0,0,0.08);}
.c-hp-fill{height:100%;background:linear-gradient(90deg,#4fd475,#8ae37d);}
.c-hp-fill.enemy{background:linear-gradient(90deg,#d6b443,#f0d86a);}
.c-hp-num,.c-hp-numline{font-size:17px;line-height:1;color:#21180f;text-align:right;margin-top:3px;display:flex;justify-content:flex-end;}
.c-statusline{min-height:14px;font-size:13px;line-height:1.1;color:#5d4632;margin-top:4px;}
#battlefield .c-hudbox{position:absolute;z-index:0;min-width:0;max-width:240px;background:rgba(246,242,248,0.88);backdrop-filter:blur(1px);box-shadow:3px 3px 0 rgba(43,32,22,0.22);}
#battlefield .c-hudbox.enemy{top:10px;right:12px;width:174px;}
#battlefield .c-hudbox.player{left:12px;bottom:74px;width:198px;}
#battlefield .c-hudbox .c-name{font-size:15px;}
#battlefield .c-hudbox .c-sub{font-size:12px;gap:6px;}
#battlefield .c-hudbox .c-hp-row{margin-top:4px;}
#battlefield .c-hudbox .c-hp-lbl{font-size:13px;min-width:18px;}
#battlefield .c-hudbox .c-hp-track{height:7px;border-width:2px;}
#battlefield .c-hudbox .c-hp-num,#battlefield .c-hudbox .c-hp-numline{font-size:12px;}
#enemy-sprite-wrap,#player-sprite-wrap{position:absolute;display:flex;align-items:flex-end;justify-content:center;z-index:1;pointer-events:none;}
#enemy-sprite-wrap{top:56px;right:38px;width:234px;height:152px;}
#player-sprite-wrap{left:18px;bottom:-2px;width:212px;height:140px;}
#e-art{width:198px;height:132px;image-rendering:pixelated;background:transparent;display:block;}
#p-art{width:178px;height:116px;image-rendering:pixelated;background:transparent;display:block;}
.battle-shadow{position:absolute;left:50%;transform:translateX(-50%);background:rgba(0,0,0,0.14);border-radius:50%;filter:blur(1px);}
#enemy-shadow{bottom:10px;width:116px;height:16px;}
#player-shadow{bottom:8px;width:108px;height:12px;}
#turn-ind{
  font-family:'VT323',monospace;
  font-size:18px;
  letter-spacing:2px;
  text-align:center;
  white-space:nowrap;
  z-index:3;
  padding:3px 10px;
  background:rgba(17,12,9,0.68);
  border:1px solid rgba(58,46,30,0.55);
  border-radius:6px;
  justify-self:start;
  display:inline-block;
}
.ti-p{color:#f3ebcf}.ti-e{color:#ff8f8f;animation:pulsered .7s infinite alternate;}
#c-int{
  position:absolute;
  left:50%;
  top:12px;
  transform:translateX(-50%);
  font-size:12px;
  color:#fff3d2;
  min-height:16px;
  max-width:58%;
  overflow:hidden;
  text-overflow:ellipsis;
  white-space:nowrap;
  z-index:3;
  text-align:center;
  text-shadow:0 1px 3px rgba(0,0,0,0.72);
}
#battle-side-text{display:flex;flex-direction:column;min-height:0;gap:6px;height:100%;}
#battle-side-head{display:flex;justify-content:space-between;align-items:baseline;gap:8px;}
#battle-note{font-size:10px;color:var(--dg);line-height:1.45;}
#b-panel #c-log{
  font-size:15px;
  line-height:1.05;
  overflow-y:auto;
  flex:1;
  min-height:0;
  max-height:none;
  font-family:'VT323',monospace;
  color:#efe5c7;
  border:2px solid #3a2e1e;
  background:rgba(255,255,255,.03);
  padding:8px 9px;
}
#b-panel #c-log.compact{font-size:15px;}
#cmb-bot{
  grid-column:1 / 3;
  grid-row:2;
  border:2px solid #3a2e1e;
  background:linear-gradient(180deg,#14100a,#0a0806);
  display:grid;
  grid-template-columns:minmax(0,1fr) 356px;
  overflow:hidden;
  min-height:0;
}
#p-stats-wrap{
  grid-column:2;
  padding:8px 10px;
  border-left:1px solid #3a2e1e;
  overflow:hidden;
  display:flex;
  flex-direction:column;
  gap:8px;
  min-width:0;
  min-height:0;
}
#c-log-wrap{
  grid-column:1;
  padding:6px 8px 8px;
  overflow:hidden;
  display:flex;
  flex-direction:column;
  min-width:0;
  gap:6px;
  min-height:0;
}
#c-log-wrap #board{flex:1 1 auto;min-height:178px;overflow-y:auto;}
#board-title-note{font-size:9px;color:var(--dg);margin-top:-1px;line-height:1.25;}
#hand-preview{font-family:'VT323',monospace;font-size:17px;line-height:1.05;color:#f4d35e;border:1px solid #5c4a22;background:rgba(255,214,98,.06);padding:6px 8px;min-height:30px;display:flex;align-items:center;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
#p-stats-wrap .phdr{margin-bottom:0;}
#p-stats-wrap .sl{display:flex;justify-content:space-between;align-items:end;margin:0;padding:5px 0;border-bottom:1px solid rgba(58,46,30,.55);font-size:11px;gap:10px;}
#p-stats-wrap .sl:last-child{border-bottom:none;}
#p-stats-wrap .sk{display:block;font-size:10px;}
#p-stats-wrap .sv,#p-stats-wrap .sv-g,#p-stats-wrap .sv-sh{display:block;font-size:18px;color:#efe5c7;}
#p-stats-wrap #c-abuf{font-size:18px;line-height:1;color:#ff8888;display:block;}
#p-stats-wrap #c-dodge{font-size:18px;line-height:1;display:block;}
#s-cmb #board{min-height:178px;padding:7px 8px;overflow-y:auto;overflow-x:hidden;border:2px solid #3a2e1e;background:rgba(0,0,0,.12);}
.pk-top{font-size:11px;}
.pk-hand{min-height:92px;gap:6px;}
.pk-actions{gap:6px;}
.pk-btn{font-size:16px;padding:3px 9px;}
.pk-help{font-size:10px;}
.hit-shake{animation:hitshake .22s linear 1;}
.panel-flash{animation:panelflash .22s linear 1;}
.play-pulse{animation:playpulse .24s ease-out 1;}
@keyframes hitshake{0%{transform:translate(0,0)}20%{transform:translate(-3px,1px)}40%{transform:translate(3px,-1px)}60%{transform:translate(-2px,0)}80%{transform:translate(2px,1px)}100%{transform:translate(0,0)}}
@keyframes panelflash{0%{filter:brightness(1)}35%{filter:brightness(1.22)}100%{filter:brightness(1)}}
@keyframes playpulse{0%{transform:translateY(0)}45%{transform:translateY(-3px)}100%{transform:translateY(0)}}
@media (max-width: 1100px){
  #s-cmb.on{grid-template-columns:minmax(0,1fr) 248px;grid-template-rows:236px minmax(0,1fr);}
  #enemy-sprite-wrap{right:18px;width:208px;height:142px;}
  #e-art{width:178px;height:118px;}
  #player-sprite-wrap{left:10px;bottom:-2px;width:182px;height:120px;}
  #p-art{width:154px;height:100px;}
  .c-name{font-size:20px;}
}
/* TREASURE */
#s-trs.on{display:grid;grid-template-columns:196px 1fr;grid-template-rows:1fr 84px;gap:6px;padding:0 0 4px;}
#trs-info{grid-column:1;grid-row:1;border:2px solid #3a2e1e;background:linear-gradient(180deg,#14100a,#0a0806);padding:9px;overflow:hidden;display:flex;flex-direction:column;gap:4px;}
#trs-bwrap{grid-column:2;grid-row:1;border:2px solid #3a2e1e;background:linear-gradient(180deg,#181109,#0a0806);padding:10px;display:flex;flex-direction:column;overflow:hidden;align-items:center;justify-content:center;}
#trs-bot{grid-column:1/3;grid-row:2;border:2px solid #3a2e1e;background:linear-gradient(180deg,#14100a,#0a0806);padding:6px 10px;display:flex;align-items:center;gap:12px;overflow:hidden;}
#trs-log{font-size:12px;line-height:1.5;overflow-y:auto;flex:1;max-height:72px;}

/* VICTORY */
#s-vic.on{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14px;text-align:center;padding:20px;}

/* SHOP OVERLAY */
#shop-overlay{
  display:none;position:fixed;inset:0;z-index:500;
  background:rgba(0,0,0,.88);align-items:center;justify-content:center;
}
#shop-overlay.on{display:flex;}
#shop-box{border:2px solid #3a2e1e;background:linear-gradient(180deg,#14100a,#0a0806);padding:14px 18px;min-width:460px;max-width:700px;overflow:hidden;}
.shop-row{display:flex;align-items:center;gap:8px;padding:4px 6px;border-bottom:1px solid #3a2e1e;border-left:3px solid transparent;cursor:pointer;user-select:none;transition:background .12s ease,border-color .12s ease;}
.shop-row:hover{background:#120d07;}
.shop-row.shop-sel{border-left-color:#c8a84e;background:#1a1408;}
.shop-info{flex:1;min-width:0;}
.shop-name{color:#c8a84e;font-size:12px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.shop-desc{color:#7a6a4a;font-size:9px;line-height:1.2;}
.shop-cost{color:#c8a84e;font-size:11px;white-space:nowrap;flex-shrink:0;}
#shop-items-list{display:flex;flex-direction:column;gap:0;}
.shop-actionbar{display:flex;justify-content:flex-end;gap:10px;flex-wrap:wrap;margin-top:10px;}
.shop-action{padding:5px 10px;border:1px solid #3a2e1e;background:linear-gradient(180deg,#171108,#0d0906);color:var(--g);cursor:pointer;user-select:none;font-family:'VT323',monospace;font-size:18px;letter-spacing:1px;}
.shop-action:hover{background:#1a1408;}
.shop-action.disabled{opacity:.45;cursor:not-allowed;}
.shop-hint{margin-top:6px;font-size:11px;color:var(--dg);line-height:1.35;text-align:left;}

/* BOARD */
#board,#trs-board{touch-action:none;
  display:inline-grid;
  grid-template-columns:repeat(7,38px);
  grid-template-rows:repeat(7,38px);
  gap:2px;border:2px solid #3a2e1e;padding:3px;
  background:linear-gradient(135deg,#1a140c,#0e0a06);flex-shrink:0;
  box-shadow:inset 0 0 12px rgba(0,0,0,0.6);
}
.bt{
  width:38px;height:38px;display:flex;align-items:center;justify-content:center;
  font-family:'Share Tech Mono',monospace;font-size:21px;
  background:linear-gradient(145deg,#4a3c2a,#2e2418,#3a2e20);
  border:1px solid #1a1408;
  box-shadow:inset 1px 1px 0 rgba(140,120,80,0.18),inset -1px -1px 0 rgba(0,0,0,0.3);
  cursor:default;user-select:none;
  text-shadow:0 1px 2px rgba(0,0,0,0.7);
  position:relative;
}
.bt::before{
  content:'';position:absolute;inset:0;
  background:linear-gradient(180deg,rgba(140,120,80,0.08) 0%,transparent 40%,rgba(0,0,0,0.12) 100%);
  pointer-events:none;
}
.bt[data-t=ATK]{color:#ff6644;text-shadow:0 0 6px rgba(255,60,40,0.4),0 1px 2px rgba(0,0,0,0.8);}
.bt[data-t=DEF]{color:#6699ff;text-shadow:0 0 6px rgba(60,100,255,0.4),0 1px 2px rgba(0,0,0,0.8);}
.bt[data-t=MAG]{color:#dd66ff;text-shadow:0 0 6px rgba(200,60,255,0.4),0 1px 2px rgba(0,0,0,0.8);}
.bt[data-t=HLT]{color:#55cc55;text-shadow:0 0 6px rgba(60,200,60,0.4),0 1px 2px rgba(0,0,0,0.8);}
.bt[data-t=SKL]{color:#ddcc44;text-shadow:0 0 6px rgba(220,200,40,0.4),0 1px 2px rgba(0,0,0,0.8);}
.bt.cur{border:2px solid #c8a84e!important;box-shadow:0 0 8px rgba(200,168,78,0.5),inset 0 0 6px rgba(200,168,78,0.15)!important;z-index:1;}
.bt.sel{background:linear-gradient(145deg,#7a6430,#5a4820,#6a5428)!important;color:#fff!important;border-color:#c8a84e!important;box-shadow:0 0 12px rgba(200,168,78,0.6),inset 0 0 8px rgba(255,220,100,0.2)!important;}
.bt.hint{border-color:#665500!important;box-shadow:0 0 5px #aa8800;}
.bt.flash{background:#fff!important;color:#000!important;border-color:#fff!important;box-shadow:0 0 16px rgba(255,255,255,0.6)!important;}

/* POKER COMBAT */
#s-cmb #board{
  display:flex;
  flex-direction:column;
  gap:8px;
  width:100%;
  min-height:0;
  padding:8px;
  border:2px solid #3a2e1e;
  background:linear-gradient(180deg,#161008,#0b0906);
  box-shadow:inset 0 0 14px rgba(0,0,0,0.55);
  flex:1;
}
.pk-hand{display:flex;flex-wrap:wrap;gap:8px;align-items:flex-start;min-height:94px;}
.pk-top{display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;font-size:11px;color:#9f8e67;}
.pk-tag{color:#c8a84e;letter-spacing:1px;}
.pk-card{
  width:54px;height:78px;padding:5px 4px 4px;
  border:2px solid #443521;border-radius:8px;
  background:linear-gradient(180deg,#f4ead2,#d8c8a0);
  color:#111;display:flex;flex-direction:column;justify-content:space-between;align-items:center;
  font-family:'Share Tech Mono',monospace;cursor:pointer;user-select:none;
  box-shadow:0 3px 10px rgba(0,0,0,.35), inset 0 1px 0 rgba(255,255,255,.4);
  transition:transform .12s ease, box-shadow .12s ease, border-color .12s ease;
}
.pk-card:hover{transform:translateY(-2px);}
.pk-card.pk-cur{border-color:#c8a84e;box-shadow:0 0 0 2px rgba(200,168,78,.35),0 5px 16px rgba(0,0,0,.45);}
.pk-card.pk-sel{transform:translateY(-8px);border-color:#f4d35e;box-shadow:0 0 14px rgba(244,211,94,.5),0 10px 20px rgba(0,0,0,.45);}
.pk-rank{font-size:18px;line-height:1;letter-spacing:0;}
.pk-suit{font-size:22px;line-height:1;}
.pk-mini{font-size:9px;opacity:.75;align-self:flex-start;line-height:1;}
.pk-mini-b{font-size:9px;opacity:.75;align-self:flex-end;line-height:1;transform:rotate(180deg);}
.pk-s-S .pk-suit,.pk-s-S .pk-mini,.pk-s-S .pk-mini-b,.pk-s-S .pk-rank{color:#4e79c9;}
.pk-s-H .pk-suit,.pk-s-H .pk-mini,.pk-s-H .pk-mini-b,.pk-s-H .pk-rank{color:#c53b3b;}
.pk-s-C .pk-suit,.pk-s-C .pk-mini,.pk-s-C .pk-mini-b,.pk-s-C .pk-rank{color:#3ea74f;}
.pk-s-D .pk-suit,.pk-s-D .pk-mini,.pk-s-D .pk-mini-b,.pk-s-D .pk-rank{color:#d0b43e;}
.pk-actions{display:flex;flex-wrap:wrap;gap:8px;align-items:center;}
.pk-btn{
  font-family:'VT323',monospace;font-size:20px;letter-spacing:1px;
  padding:5px 12px;border:1px solid #5e4c24;border-radius:6px;
  background:linear-gradient(180deg,#2b2112,#171008);color:#d7c79d;cursor:pointer;
}
.pk-btn:disabled{opacity:.35;cursor:not-allowed;}
.pk-btn.pk-pri{color:#f4d35e;border-color:#8a6d1f;}
.pk-btn.pk-go{color:#83e68a;border-color:#2f7d39;}
.pk-btn.pk-sel{box-shadow:0 0 0 2px rgba(200,168,78,.28);}
.pk-help{font-size:10px;color:#7f7256;}
.pk-empty{font-size:12px;color:#8e7f5e;padding:18px 8px;border:1px dashed #4b3b22;border-radius:8px;text-align:center;}


/* SHARED */
.phdr{font-family:'VT323',monospace;font-size:15px;color:#c8a84e;letter-spacing:2px;
  border-bottom:1px solid #3a2e1e;margin-bottom:3px;padding-bottom:1px;
  white-space:nowrap;overflow:hidden;flex-shrink:0;}
.sl{display:flex;justify-content:space-between;margin:1px 0;font-size:11px;
  white-space:nowrap;overflow:hidden;gap:4px;}
.sk{color:#7a6a4a;flex-shrink:0;}
.sv{color:#c8b888;overflow:hidden;text-overflow:ellipsis;}
.sv-hp{color:var(--re)}.sv-mp{color:var(--bl)}.sv-xp{color:var(--mg)}.sv-g{color:var(--am)}.sv-sh{color:var(--cy)}
.bar{background:#1a140c;border:1px solid #3a2e1e;height:6px;margin:1px 0 3px;overflow:hidden;flex-shrink:0;}
.bf{height:100%;transition:width .3s;}
.bf-hp{background:var(--re)}.bf-mp{background:var(--bl)}.bf-xp{background:var(--mg)}.bf-am{background:var(--am)}
.bf-mp.low-mp{background:var(--re)!important;animation:mpflash .35s 3;}
@keyframes mpflash{0%,100%{opacity:1}50%{opacity:.15}}
.btn{font-family:'VT323',monospace;font-size:17px;background:linear-gradient(145deg,#3a2e20,#241c12);border:1px solid #3a2e1e;
  color:#c8b888;padding:3px 12px;letter-spacing:1px;white-space:nowrap;}
.btn-am{border-color:#6a5a2e;color:#c8a84e;}

#turn-ind{font-family:'VT323',monospace;font-size:17px;letter-spacing:2px;text-align:center;
  white-space:nowrap;flex-shrink:0;}
.ti-p{color:#c8b888}.ti-e{color:#cc4444;animation:pulsered .7s infinite alternate;}
@keyframes pulsered{from{text-shadow:none}to{text-shadow:0 0 10px #cc4444}}

.l-n{color:#7a6a4a}.l-e{color:#c8b888}.l-c{color:#c8a84e}.l-d{color:#cc4444}
.l-l{color:#c8a84e}.l-s{color:#55bbcc}.l-w{color:#bb66cc}
.l-atk{color:#cc4444}.l-def{color:#6699cc}.l-mag{color:#bb66cc}.l-hlt{color:#55aa55}
.l-skl{color:#ccbb44}.l-win{color:#c8a84e}

.sts{font-size:10px;padding:0 3px;margin:1px;display:inline-block;border:1px solid;}
.sts-burn{color:#ff6600;border-color:#ff6600}.sts-stun{color:var(--ye);border-color:var(--ye)}
@keyframes blink{50%{opacity:0}}.blink{animation:blink 1s step-end infinite;color:#c8a84e;}

/* FONT SIZE TUNE-UP */
body{font-size:17px!important;}
#hdr{font-size:30px!important;padding:8px 0 6px!important;}
.t-sub{font-size:18px!important;line-height:2.2!important;}
#log-inner,#trs-log{font-size:17px!important;line-height:1.65!important;}
.phdr{font-size:24px!important;}
.sl,#p-stats-wrap .sl,.pk-top{font-size:17px!important;line-height:1.5!important;}
#p-stats-wrap .sk,.pk-help,.shop-desc,#battle-note,#board-title-note,.pk-mini,.pk-mini-b,.sts{font-size:14px!important;line-height:1.45!important;}
.shop-name,.shop-cost{font-size:18px!important;}
#b-panel #c-log,#b-panel #c-log.compact{font-size:22px!important;line-height:1.15!important;}
#hand-preview{font-size:24px!important;min-height:42px!important;padding:8px 10px!important;}
#p-stats-wrap .sv,#p-stats-wrap .sv-g,#p-stats-wrap .sv-sh,#p-stats-wrap #c-abuf,#p-stats-wrap #c-dodge{font-size:24px!important;}
.pk-btn,.btn{font-size:24px!important;padding:6px 14px!important;}
.pk-empty{font-size:18px!important;}
#turn-ind{font-size:24px!important;}
#c-int{font-size:18px!important;top:14px!important;max-width:70%!important;}
.c-name{font-size:30px!important;}
.c-sub{font-size:22px!important;}
.c-hp-lbl{font-size:22px!important;}
.c-hp-num,.c-hp-numline{font-size:21px!important;}
.c-statusline{font-size:17px!important;min-height:18px!important;}
#battlefield .c-hudbox.enemy{width:220px!important;}
#battlefield .c-hudbox.player{width:248px!important;}
#battlefield .c-hudbox .c-name{font-size:20px!important;}
#battlefield .c-hudbox .c-sub{font-size:16px!important;}
#battlefield .c-hudbox .c-hp-lbl{font-size:16px!important;}
#battlefield .c-hudbox .c-hp-num,#battlefield .c-hudbox .c-hp-numline{font-size:15px!important;}
#s-title div[style*="font-size:28px"]{font-size:40px!important;}
#death-msg{font-size:18px!important;line-height:2.1!important;}
#s-title .blink,#s-vic .blink{font-size:30px!important;}
#score-table{font-size:16px!important;}
#score-table div{font-size:16px!important;line-height:2.05!important;}
#s-dun [style*="font-size:10px"],#s-trs [style*="font-size:10px"],#shop-overlay [style*="font-size:10px"],#pause-overlay [style*="font-size:11px"]{font-size:15px!important;}
#s-dun [style*="font-size:11px"],#s-trs [style*="font-size:11px"],#shop-overlay [style*="font-size:11px"]{font-size:16px!important;}
#s-dun [style*="font-size:12px"],#s-trs [style*="font-size:12px"],#shop-overlay [style*="font-size:12px"],#pause-overlay [style*="font-size:12px"]{font-size:17px!important;}
#s-dun [style*="font-size:13px"],#s-trs [style*="font-size:13px"],#shop-overlay [style*="font-size:13px"],#pause-overlay [style*="font-size:13px"],#s-vic [style*="font-size:13px"]{font-size:18px!important;}
#s-dun [style*="font-size:14px"],#s-trs [style*="font-size:14px"],#shop-overlay [style*="font-size:14px"],#pause-overlay [style*="font-size:14px"]{font-size:19px!important;}
#s-dun [style*="font-size:16px"],#s-trs [style*="font-size:16px"],#shop-overlay [style*="font-size:16px"],#pause-overlay [style*="font-size:14px"],#s-vic [style*="font-size:16px"]{font-size:22px!important;}
#shop-overlay [style*="font-size:22px"],#pause-overlay .phdr{font-size:28px!important;}
#s-vic div[style*="font-size:44px"]{font-size:60px!important;}
#shop-overlay img[alt="Shop"]{width:min(100%,420px)!important;}
@media (max-width: 1100px){
  #wrap{width:min(100vw - 8px,1080px)!important;}
  #s-dun.on{grid-template-columns:1fr 214px!important;grid-template-rows:1fr 82px!important;}
  #s-cmb.on{grid-template-columns:minmax(0,1fr) 320px!important;}
  #cmb-bot{grid-template-columns:minmax(0,1fr) 320px!important;}
  #shop-box{min-width:min(92vw,420px)!important;max-width:92vw!important;}
}


/* UI balance pass: keep overall fonts large, but make poker cards fit again */
.pk-hand{gap:10px!important;min-height:130px!important;align-items:flex-start!important;overflow-x:auto;overflow-y:visible!important;overflow:visible!important;padding-top:10px!important;padding-bottom:8px!important;}
.pk-card{
  width:72px!important;
  height:102px!important;
  padding:6px 6px 5px!important;
  border-radius:10px!important;
}
.pk-rank{font-size:26px!important;line-height:.92!important;letter-spacing:0!important;
  text-shadow:0 0 1px rgba(68,44,20,.72),0 1px 0 rgba(68,44,20,.42)!important;
}
.pk-suit{font-size:28px!important;line-height:.9!important;
  text-shadow:0 0 1px rgba(68,44,20,.72),0 1px 0 rgba(68,44,20,.42)!important;
}
.pk-mini,.pk-mini-b{font-size:12px!important;line-height:1!important;opacity:.98!important;
  text-shadow:0 0 1px rgba(68,44,20,.68),0 1px 0 rgba(68,44,20,.38)!important;
}
.pk-top{font-size:18px!important;line-height:1.25!important;}
.pk-help{font-size:16px!important;line-height:1.35!important;display:block;max-width:100%!important;}
.pk-actions{gap:10px!important;align-items:flex-start!important;flex-wrap:wrap!important;}
#s-cmb #board{padding:12px 10px 10px!important;overflow-y:auto!important;overflow-x:auto!important;}



/* Stronger current-card visibility */
@keyframes pkcurpulse{
  0%,100%{filter:brightness(1)}
  50%{filter:brightness(1.06)}
}
.pk-card.pk-cur{
  border-color:#d24c43!important;
  transform:translateY(-3px) scale(1.02)!important;
  box-shadow:
    0 0 0 3px rgba(210,76,67,.96),
    0 0 0 6px rgba(255,227,184,.16),
    0 8px 20px rgba(0,0,0,.48)!important;
  animation:pkcurpulse .9s ease-in-out infinite;
}
.pk-card.pk-sel{
  transform:translateY(-10px)!important;
  border-color:#f4d35e!important;
  box-shadow:
    0 0 0 3px rgba(244,211,94,.78),
    0 0 18px rgba(244,211,94,.42),
    0 12px 22px rgba(0,0,0,.48)!important;
}
.pk-card.pk-cur.pk-sel{
  border-color:#ff695b!important;
  box-shadow:
    0 0 0 3px rgba(255,105,91,1),
    0 0 0 6px rgba(244,211,94,.62),
    0 0 20px rgba(255,105,91,.40),
    0 12px 24px rgba(0,0,0,.52)!important;
}


/* UI cleanup */
#debug,
#debug-panel,
.debug,
.debug-panel,
#btn-remove-monsters,
#remove-monsters,
.remove-monsters{
  display:none !important;
}


/* v25: reliable scoring and boss reward choices */
#enemy-rule{font-size:14px;line-height:1.4;color:#ffe29a;background:#211a12;border-left:3px solid #d5aa49;padding:6px 10px;margin-bottom:6px;}
.pk-card.pk-ignored{opacity:.48;filter:saturate(.3);}
.pk-card.pk-scoring::after{content:'SCORES';position:absolute;bottom:22px;left:0;right:0;text-align:center;font-size:11px;font-weight:bold;color:#302000;background:#ffe29a;}
.pk-card:focus-visible,.pk-btn:focus-visible,.reward-card:focus-visible{outline:3px solid #91dbff;outline-offset:3px;}
.pk-btn:disabled{opacity:.4;cursor:not-allowed;}
#s-reward.on{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:18px;padding:24px;overflow:auto;}
#s-reward h2{font-family:'VT323',monospace;font-size:36px;color:#ffe29a;}
#s-reward p{font-size:16px;text-align:center;}
.reward-heading{font-size:14px;letter-spacing:4px;color:#bdaa78;}
#reward-cards{display:flex;gap:18px;max-width:100%;flex-wrap:wrap;justify-content:center;}
.reward-card{position:relative;display:flex;flex-direction:column;align-items:center;gap:18px;width:250px;min-height:290px;padding:24px 20px;border:2px solid #655037;border-radius:12px;background:linear-gradient(160deg,#2c213d,#100d13);color:#e9dbba;font:16px/1.5 'Share Tech Mono',monospace;cursor:pointer;text-align:center;}
.reward-current{border-color:#ffdb78;box-shadow:0 0 0 3px #ffdb7828;transform:translateY(-4px);}
.reward-number{position:absolute;left:12px;top:8px;color:#ad9875;}
.reward-icon{font-size:38px;}.reward-card strong{color:#ffdb78;}.reward-card em{font-size:14px;color:#b6a58c;margin-top:auto;}
#vault-cashout{margin-top:12px;white-space:normal;line-height:1.5;}
@media(max-width:700px){#s-reward.on{justify-content:flex-start}.reward-card{min-height:0;width:100%;gap:8px;padding:16px}.reward-icon{font-size:25px}}
@media(prefers-reduced-motion:reduce){.pk-card,.reward-card{transition:none!important;}.hit-shake,.panel-flash,.play-pulse{animation:none!important;}}


/* v26: mana tricks and resumable runs */
#autosave-error{color:#ffbdac;font-size:14px;padding:6px;text-align:center;}
#save-menu{display:flex;flex-wrap:wrap;gap:10px;justify-content:center;max-width:720px;}
#save-menu [hidden]{display:none!important;}#save-message{flex-basis:100%;font-size:14px;line-height:1.5;text-align:center;color:#c5b994;}
#pause-save-note{font-size:14px;line-height:1.5;margin:10px 0;max-width:310px;color:#c5b994;}
.pk-tricks{padding:8px 10px;border:1px solid #514168;border-radius:8px;background:#17111f;display:flex;gap:10px;align-items:center;flex-wrap:wrap;font-size:14px;line-height:1.4;}
.trick-options{flex-basis:100%;display:flex;flex-wrap:wrap;gap:8px;}.trick-current{outline:2px solid #c8b5ff;outline-offset:2px;}
.trick-note{color:#d4c0e9;font-size:14px;}.pk-tricks .pk-btn{padding:6px 10px!important;font-size:14px!important;}

/* v27: torchlit stone, brass details and readable game controls. */
:root{--bg:#090d15;--bdr:#343c49;--dg:#a49c88;--g:#e6dcc5;--am:#e7ba64;}
body{background:radial-gradient(ellipse at 50% 0,#202434 0,#090d15 62%);color:#e6dcc5;}
#wrap{width:min(1320px,calc(100vw - 28px));gap:8px;padding-bottom:12px;}
#hdr{font-size:27px!important;letter-spacing:3px;padding:12px 0 5px!important;color:#edca85;}
#hdr .zone-tag{border-left:1px solid #665b43;padding-left:14px;font-size:.62em;}
#view-wrap,#e-panel,#b-panel,#stat-col,#log-wrap,#cmb-bot,#trs-info,#trs-bwrap{border:1px solid #414652;border-radius:10px;box-shadow:0 8px 24px #0005,inset 0 1px #ffffff08;}
#view-wrap{background:#0a0d13;}
#view-canvas{object-fit:contain;}
#stat-col,#p-stats-wrap,#trs-info{background:linear-gradient(145deg,#1d212c,#10141d);padding:14px;}
#stat-col{overflow-y:auto;gap:5px;}
.phdr{color:#dbb978;letter-spacing:2px;font-size:21px!important;border-bottom-color:#3f4149;}
.sk{color:#b4ab99;}.sv,.sv-g{font-variant-numeric:tabular-nums;}
.bar{height:8px;border:1px solid #444854;border-radius:3px;background:#080b11;overflow:hidden;}
.bf{transition:width .3s ease;}
#log-wrap,#b-panel{background:linear-gradient(135deg,#171c26,#0e121a);}
#log-inner{font-size:15px!important;line-height:1.6!important;}
#minimap{border:1px solid #59606b;border-radius:5px;box-shadow:0 3px 14px #0006;}
#s-cmb.on{grid-template-columns:minmax(0,1fr) 300px;grid-template-rows:minmax(270px,36vh) minmax(0,1fr);gap:10px;}
#e-panel{isolation:isolate;}
#battlefield{background-image:url('data:image/png;base64,