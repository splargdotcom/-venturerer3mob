');background-size:cover;background-position:center 44%;image-rendering:pixelated;}
#battlefield::before{background:linear-gradient(180deg,#06091242,transparent 50%,#07091235);z-index:0;}
#battlefield::after{height:100%;background:radial-gradient(ellipse at 48% 35%,#ffc76a0c,transparent 60%);z-index:0;}
#battlefield .c-hudbox{z-index:3;background:linear-gradient(150deg,#141c2aef,#0a1019f0);border:1px solid #b39458;border-radius:6px;color:#f1e4c7;box-shadow:0 5px 16px #0008;padding:9px 12px;backdrop-filter:none;}
#battlefield .c-hudbox.enemy{top:14px;left:14px;right:auto;width:210px!important;}
#battlefield .c-hudbox.player{left:auto;right:14px;bottom:14px;width:210px!important;}
#battlefield .c-name{color:#f4d692;font-size:19px!important;letter-spacing:1px;}
#battlefield .c-sub,#battlefield .c-hp-lbl,#battlefield .c-hp-num,#battlefield .c-hp-numline,#battlefield .c-statusline{color:#dfd7c5;}
#battlefield .c-hp-track{background:#060a12;border:1px solid #505b68;height:8px;border-radius:2px;overflow:hidden;}
#battlefield .c-hp-fill{transition:width .35s ease;background:linear-gradient(90deg,#239783,#82d49b);}
#battlefield .c-hp-fill.enemy{background:linear-gradient(90deg,#a64836,#f1a268);}
#c-pmp-b{background:linear-gradient(90deg,#40599e,#94b9f1)!important;}
#enemy-sprite-wrap{top:auto;right:10%;bottom:26%;width:28%;height:48%;z-index:2;animation:enemy-breathe 3.6s ease-in-out infinite;}
#player-sprite-wrap{left:10%;bottom:4%;width:28%;height:50%;z-index:2;}
#e-art,#p-art{height:100%;width:100%;object-fit:contain;filter:drop-shadow(1px 2px 0 #0007);}
.battle-shadow{background:#0008;filter:blur(2px);}
#c-int{top:12px!important;left:auto;right:12px;transform:none;max-width:calc(100% - 252px)!important;font-size:16px!important;line-height:1.35;white-space:normal;padding:6px 8px;border-radius:4px;background:#0b111de6;border:1px solid #4c4e59;color:#f4dbc0;}
#b-panel{padding:13px;}
#b-panel #c-log,#b-panel #c-log.compact{font-size:18px!important;line-height:1.4!important;}
#battle-note{font-size:12px!important;color:#b6b0a1;}
#turn-ind{border-radius:4px;padding:7px;font-size:23px!important;letter-spacing:2px;}
.ti-p{background:#18352e;color:#b9ebcf;border:1px solid #356653;}.ti-e{background:#412324;color:#ffd0b5;border:1px solid #825043;}
#cmb-bot{background:#121722;border:1px solid #414652;grid-template-columns:minmax(0,1fr) 185px;}
#c-log-wrap{padding:12px;gap:7px;}
#s-cmb #board{background:linear-gradient(145deg,#161d27,#0e151e);border:1px solid #34424e;border-radius:7px;padding:10px 12px!important;}
#p-stats-wrap{border-left:1px solid #363e48;gap:6px;border-radius:0 10px 10px 0;}
#p-stats-wrap .sl{border-bottom:1px solid #343b45;}
#hand-preview{font-size:22px!important;line-height:1.35;white-space:normal;min-height:42px!important;border:1px solid #706044;border-radius:5px;background:#332b1a66;color:#f5d894;padding:7px 10px!important;}
#enemy-rule{font-size:14px;background:#201c20;border-left-color:#cc9a63;color:#eac8a1;border-radius:3px;}
#board-title-note{color:#b2ac9d;font-size:14px!important;}
.pk-top{font-size:15px!important;color:#ddd3c0;gap:14px;}.pk-tag{color:#aca68e;font-size:12px;}
.pk-hand{gap:10px!important;padding-top:15px!important;padding-bottom:10px!important;}
.pk-card{position:relative;border:1px solid #98866b!important;border-radius:6px!important;background:linear-gradient(160deg,#fff8e7,#e3d8bf)!important;box-shadow:0 4px 0 #5b4d3e,0 8px 14px #0006!important;}
.pk-card.pk-cur{outline:2px solid #83c7df;outline-offset:3px;border-color:#b8dbe3!important;box-shadow:0 4px 0 #4a6a78,0 8px 14px #0006!important;}
.pk-card.pk-sel{border-color:#ffce73!important;box-shadow:0 4px 0 #9a7336,0 0 0 2px #f0bf60,0 10px 18px #0006!important;}
.pk-card.pk-cur.pk-sel{outline:2px solid #83c7df;outline-offset:5px;}
.pk-card.pk-scoring::after{top:-9px;bottom:auto;left:8px;right:8px;border-radius:3px;padding:1px;font-size:10px;letter-spacing:.6px;background:#ffd684;color:#382b13;}
.pk-card.pk-ignored{opacity:.42;}
.pk-card .pk-rank,.pk-card .pk-suit,.pk-card .pk-mini,.pk-card .pk-mini-b{text-shadow:none!important;}
.pk-s-S .pk-rank,.pk-s-S .pk-suit,.pk-s-S .pk-mini,.pk-s-S .pk-mini-b{color:#234b73;}
.pk-s-H .pk-rank,.pk-s-H .pk-suit,.pk-s-H .pk-mini,.pk-s-H .pk-mini-b{color:#a52e38;}
.pk-s-D .pk-rank,.pk-s-D .pk-suit,.pk-s-D .pk-mini,.pk-s-D .pk-mini-b{color:#885717;}
.pk-s-C .pk-rank,.pk-s-C .pk-suit,.pk-s-C .pk-mini,.pk-s-C .pk-mini-b{color:#255d49;}
.pk-btn,.btn{font:20px/1.25 'VT323',monospace!important;letter-spacing:.7px;padding:8px 14px!important;border:1px solid #697078;border-radius:5px;background:linear-gradient(#2b3341,#1b2330);color:#e5dfd0;box-shadow:0 2px 0 #070a10;transition:background .15s,transform .15s;}
.pk-btn:hover:not(:disabled){background:linear-gradient(#394556,#293544);border-color:#c5b284;transform:translateY(-1px);}
.pk-btn.pk-go{background:linear-gradient(#345749,#233c34);border-color:#749b7d;color:#e3f3dc;}
.pk-btn.pk-pri{color:#f3d594;border-color:#a88b54;}
.pk-btn:active:not(:disabled){transform:translateY(1px);box-shadow:none;}
.pk-btn:disabled{opacity:.38;}
.pk-tricks{background:#211d2c;border-color:#514964;padding:8px;border-radius:5px;}
.pk-help{font-size:14px!important;line-height:1.5!important;color:#bdb5a6;}
.control-help{flex-basis:100%;}summary{cursor:pointer;color:#c8b98f;padding:4px 0;font-size:13px;letter-spacing:.8px;}
#s-title{background:radial-gradient(ellipse at 50% 35%,#24263499,transparent 65%);overflow-y:auto;}
#s-title .blink{font-size:23px!important;color:#ddbd7a;letter-spacing:2px;}
#save-menu{padding-top:6px;}#save-message{color:#bdb39e;}
#pause-overlay>div,#shop-box{background:linear-gradient(145deg,#212632,#101620)!important;border:1px solid #9b8254!important;border-radius:12px;box-shadow:0 24px 80px #000b!important;}
#trs-board{border:1px solid #51475f;background:linear-gradient(145deg,#242033,#14121e)!important;}
.reward-card{background:linear-gradient(150deg,#292b3e,#151b27);border-color:#5e6177;border-radius:8px;}
.battle-number{position:absolute;z-index:8;pointer-events:none;font:bold 36px/1 'VT323',monospace;color:#fff0d6;text-shadow:2px 2px #27151d,-1px -1px #27151d;animation:battle-rise .9s ease-out forwards;}
.battle-number.enemy{right:23%;top:35%;}.battle-number.player{left:23%;bottom:32%;}.battle-number.heal{color:#a9f3bc;}
@keyframes battle-rise{0%{opacity:0;transform:translateY(8px) scale(.8)}15%{opacity:1;transform:translateY(0) scale(1.2)}75%{opacity:1}100%{opacity:0;transform:translateY(-42px) scale(1)}}
@keyframes enemy-breathe{0%,100%{transform:translateY(0)}50%{transform:translateY(-2px)}}
@media(max-height:760px) and (min-width:901px){#s-cmb.on{grid-template-rows:250px minmax(0,1fr);}#hdr{font-size:23px!important;padding:6px 0!important;}#wrap{gap:5px;}}
@media(max-width:1100px) and (min-width:901px){#s-cmb.on{grid-template-columns:minmax(0,1fr) 255px!important;}#battlefield .c-hudbox.enemy,#battlefield .c-hudbox.player{width:180px!important;}#c-int{max-width:calc(100% - 214px)!important;}}
@media(max-width:900px){
 body{height:auto;min-height:100dvh;overflow-y:auto;}
 #wrap{height:auto;min-height:100dvh;width:calc(100vw - 16px);padding-bottom:12px;}
 #hdr{font-size:23px!important;letter-spacing:1px;}
 #s-cmb.on{height:auto;grid-template-columns:minmax(0,1fr)!important;grid-template-rows:320px auto auto;overflow:visible;}
 #e-panel{grid-column:1;grid-row:1;}#b-panel{grid-column:1;grid-row:2;max-height:190px;min-height:150px;}
 #cmb-bot{grid-column:1;grid-row:3;grid-template-columns:minmax(0,1fr);}
 #p-stats-wrap{grid-column:1;display:flex;flex-direction:row;flex-wrap:wrap;gap:8px 20px;border-left:0;border-top:1px solid #363e48;border-radius:0;}
 #p-stats-wrap .phdr{display:none;}#p-stats-wrap .sl{gap:12px;}
 #c-log-wrap{grid-column:1;overflow:visible;}#s-cmb #board{overflow:auto!important;min-height:260px;}
 .pk-hand{flex-wrap:wrap!important;justify-content:center!important;}
 #s-dun.on{grid-template-columns:minmax(0,1fr)!important;grid-template-rows:auto auto auto!important;height:auto;}
 #view-wrap{grid-column:1;grid-row:1;aspect-ratio:8/5;}#stat-col{grid-column:1;grid-row:3;max-height:360px;}#log-wrap{grid-column:1;grid-row:2;height:92px;}
 #s-title{min-height:88dvh;}#s-trs.on{grid-template-columns:minmax(0,1fr);grid-template-rows:auto auto auto;height:auto;}
 #trs-info{grid-column:1;grid-row:2;}#trs-bwrap{grid-column:1;grid-row:1;overflow:auto;}#trs-bot{grid-column:1;grid-row:3;min-height:100px;}
 #trs-board{grid-template-columns:repeat(7,minmax(30px,1fr))!important;grid-template-rows:repeat(7,60px)!important;gap:4px!important;padding:6px!important;}
 #trs-board .bt{width:100%!important;height:60px!important;}
}
@media(max-width:520px){#battlefield .c-hudbox.enemy,#battlefield .c-hudbox.player{width:160px!important;padding:6px 8px;}#battlefield .c-name{font-size:17px!important;}#c-int{max-width:calc(100% - 196px)!important;font-size:14px!important;}.pk-card{width:62px!important;height:94px!important;}.pk-hand{gap:8px!important;}#save-menu{flex-direction:column;}#s-title div[style*="font-size:28px"]{font-size:30px!important;}}
@media(prefers-reduced-motion:reduce){#enemy-sprite-wrap,.battle-number{animation:none!important;}.pk-btn,.bf,.c-hp-fill{transition:none!important;}}

/* v28: one scene, one hand, one row of actions. */
#s-cmb.on{grid-template-columns:minmax(0,1fr)!important;grid-template-rows:minmax(245px,36vh) auto minmax(0,1fr);gap:0;}
#e-panel{grid-column:1;grid-row:1;border-radius:10px 10px 0 0;border-bottom:0;}
#battlefield{background-position:center 45%;}
#battlefield .c-hudbox.enemy{left:18px;top:18px;}#battlefield .c-hudbox.player{right:18px;bottom:18px;}
#enemy-sprite-wrap{right:22%;height:52%;bottom:20%;width:24%;}
#player-sprite-wrap{left:21%;height:52%;bottom:5%;width:24%;}
#combat-status{grid-column:1;grid-row:2;display:flex;align-items:center;flex-wrap:wrap;gap:6px 18px;padding:10px 16px;background:#111a27;border:1px solid #414652;border-top-color:#333d4a;border-radius:0 0 8px 8px;}
#combat-status #turn-ind{padding:0;border:0;background:none;font-size:18px!important;letter-spacing:1px;white-space:nowrap;}
#combat-status #c-int{position:static;max-width:none!important;transform:none;background:none;border:none;padding:0;font-size:16px!important;line-height:1.4;color:#e7d7ba;text-align:left;flex:1;min-width:150px;}
#combat-status #enemy-rule{font-size:13px;line-height:1.4;border:0;background:none;margin:0;padding:0;color:#cda78d;}
#combat-effects{font-size:14px;color:#a6d9c4;}
#combat-effects:empty,#enemy-rule:empty{display:none;}
#cmb-bot{grid-column:1;grid-row:3;display:flex;flex-direction:column;overflow-y:auto;min-height:0;border:0;background:none;box-shadow:none;padding-top:9px;}
#c-log-wrap{padding:0;overflow:visible;display:flex;flex-direction:column;gap:0;flex-shrink:0;}
#c-log-wrap>.phdr,#board-title-note{display:none;}
#hand-preview{border:0;background:none;justify-content:center;text-align:center;padding:7px 10px!important;min-height:34px!important;font-size:21px!important;color:#ead0a0;}
#s-cmb #board{border:0;box-shadow:none;background:none;min-height:0;padding:0 12px 8px!important;overflow:visible!important;}
.pk-hand{justify-content:center!important;flex-wrap:wrap!important;gap:12px!important;padding:14px 0 12px!important;min-height:0;}
.pk-card{border-radius:5px!important;}.pk-card.pk-scoring::after{display:none;}
.pk-card.pk-sel{box-shadow:0 3px 0 #806334,0 0 0 1px #e2b661,0 6px 12px #0006!important;}
.pk-card.pk-cur{outline:1px solid #83c7df;outline-offset:3px;}
.pk-card.pk-cur.pk-sel{outline:1px solid #83c7df;outline-offset:4px;}
.pk-actions{justify-content:center;gap:10px!important;flex-wrap:wrap!important;}
.pk-actions .pk-btn{min-width:130px;font-size:19px!important;padding:8px 15px!important;}
.pk-actions .pk-go{min-width:164px;}
.pk-tricks{max-width:780px;margin:12px auto 2px;padding:12px;}
#combat-details{flex-shrink:0;margin:2px 12px 10px;border-top:1px solid #303846;color:#bdb5a6;}
#combat-details>summary{list-style-position:inside;text-align:center;padding:10px;font-size:13px;letter-spacing:.5px;color:#9ea6b1;}
.combat-detail-grid{display:grid;grid-template-columns:minmax(0,1fr) 180px;gap:12px;max-width:950px;margin:0 auto;padding:10px 0;}
#combat-details #b-panel{grid-column:1;grid-row:1;min-height:190px;max-height:260px;border:0;border-radius:5px;box-shadow:none;padding:12px;}
#combat-details #battle-note{display:none;}
#combat-details #c-log{font-size:16px!important;line-height:1.5!important;}
#combat-details #p-stats-wrap{grid-column:2;grid-row:1;border:0;border-radius:5px;padding:12px;display:flex;flex-direction:column;}
#combat-details #p-stats-wrap .phdr{display:none;}
#artifact-info,.combat-help{grid-column:1/-1;font-size:14px;line-height:1.6;}
#artifact-info h3{font-size:15px;color:#d9bf8c;margin-bottom:6px;}.combat-help p{margin:6px 0;}
#combat-details .pk-btn{font-size:16px!important;}
@media(max-height:760px) and (min-width:901px){#s-cmb.on{grid-template-rows:235px auto minmax(0,1fr);}.pk-hand{padding-top:10px!important;padding-bottom:8px!important;}.pk-card{height:94px!important;}}
@media(max-width:900px){#s-cmb.on{grid-template-columns:minmax(0,1fr)!important;grid-template-rows:300px auto auto;height:auto;overflow:visible;}#cmb-bot{overflow:visible;}#combat-status{padding:8px 12px;gap:6px 12px;}#combat-status #enemy-rule{flex-basis:100%;}#combat-details #b-panel{min-height:180px;}#enemy-sprite-wrap{right:18%;}#player-sprite-wrap{left:16%;}}
@media(max-width:520px){#s-cmb.on{grid-template-rows:280px auto auto;}#battlefield .c-hudbox.enemy{left:10px;top:10px;}#battlefield .c-hudbox.player{right:10px;bottom:10px;}#enemy-sprite-wrap{right:9%;height:43%;bottom:33%;width:28%;}#player-sprite-wrap{left:9%;height:44%;bottom:3%;width:28%;}.pk-actions .pk-btn,.pk-actions .pk-go{min-width:0;flex:1;font-size:17px!important;padding:8px!important;}.pk-hand{gap:9px!important;}.combat-detail-grid{grid-template-columns:1fr;}#combat-details #p-stats-wrap{grid-column:1;grid-row:2;flex-direction:row;flex-wrap:wrap;}#combat-details #p-stats-wrap .sl{gap:10px;}#hand-preview{font-size:19px!important;}}

</style>
<style>
/* Combat clarity: cyan pointer follows cursor; gold lift marks selection. */
.pk-card.pk-cur,.pk-card.pk-cur.pk-sel{outline:3px solid #99e8ff!important;outline-offset:4px;z-index:2;}
.pk-card.pk-cur::before{content:"";position:absolute;left:50%;top:-16px;transform:translateX(-50%);border-left:5px solid transparent;border-right:5px solid transparent;border-top:6px solid #99e8ff;pointer-events:none;}
.pk-card.pk-sel{transform:translateY(-8px)!important;border-color:#d59b34!important;box-shadow:0 4px 0 #92611c,0 0 0 2px #e2b661,0 7px 12px #0006!important;}
.pk-card.pk-ignored{opacity:1;}
.pk-card.pk-ignored .pk-rank,.pk-card.pk-ignored .pk-suit{opacity:.38;}
#e-art.impact-hit,#p-art.impact-hit{animation:character-impact .28s ease-out;}
@keyframes character-impact{0%{filter:brightness(2.2) drop-shadow(0 0 5px #ffe3a3);transform:translateX(-3px)}35%{filter:brightness(1.35);transform:translateX(2px)}100%{filter:drop-shadow(1px 2px 0 #0007);transform:translateX(0)}}
.battle-number{padding:3px 7px;border-radius:5px;background:#111a24dc;font-size:38px;white-space:nowrap;}
.battle-number.player.damage{color:#ffb8ab;}
.battle-number.burn{color:#ffc283;font-size:28px;}
.battle-number.notice{color:#bde9ff;font-size:25px;}
.battle-number.heavy{font-size:46px;color:#ffe098;}
@media(prefers-reduced-motion:reduce){#e-art.impact-hit,#p-art.impact-hit{animation:none!important;}.battle-number{animation:none!important;}.pk-card{transition:none!important;}}
</style>
<style>
/* v31: readable sidebar and combat information on the matching side. */
#stat-col>*{flex-shrink:0;}
#stat-col .sl{min-height:25px;overflow:visible;align-items:center;line-height:1.45!important;}
#stat-col .phdr{white-space:normal;line-height:1.3;}
#stat-col .sv{overflow:visible;}
#stat-col .explore-help{font-size:15px!important;line-height:1.6!important;letter-spacing:0;color:#aab6c4;margin:8px 0;}
#stat-col .explore-help p{margin:0 0 5px;}
#stat-col #minimap-wrap{margin-top:auto;padding-top:10px;}
#battlefield .c-hudbox.player{left:18px;right:auto;top:18px;bottom:auto;}
#battlefield .c-hudbox.enemy{right:18px;left:auto;top:18px;bottom:auto;}
#battlefield .c-hudbox{width:190px!important;}
@media(max-width:700px){
 #battlefield .c-hudbox{width:145px!important;padding:7px 9px;}
 #battlefield .c-hudbox.player{left:10px;top:10px;}
 #battlefield .c-hudbox.enemy{right:10px;top:10px;}
 #battlefield .c-hudbox .c-name{font-size:17px!important;}
 #player-sprite-wrap{left:12%;bottom:3%;height:43%;width:26%;}
 #enemy-sprite-wrap{right:12%;bottom:5%;height:43%;width:26%;}
}
</style>
<style>
#player-sprite-wrap{animation:hero-breathe 3s ease-in-out infinite;transform-origin:50% 100%;}
@keyframes hero-breathe{0%,100%{transform:translateY(0) scaleY(1)}50%{transform:translateY(-1px) scaleY(1.015)}}
#player-sprite-wrap.hero-cast{animation:hero-cast .46s ease-out;}
@keyframes hero-cast{0%{transform:rotate(-3deg) translateX(-3px)}40%{transform:rotate(3deg) translateX(7px)}100%{transform:none}}
.flying-card{position:absolute;z-index:7;pointer-events:none;width:25px;height:35px;display:flex;align-items:center;justify-content:center;border:1px solid #a68a50;border-radius:3px;background:#fff2d4;color:#24384c;font:20px/1 'VT323',monospace;box-shadow:0 0 10px #edca8577;animation:card-flight .36s ease-in both;}
@keyframes card-flight{0%{opacity:0;transform:translate(0,0) rotate(-20deg) scale(.7)}12%{opacity:1}55%{opacity:1;transform:translate(calc(var(--dx)*.52),calc(var(--dy)*.52 - 35px)) rotate(25deg) scale(1)}100%{opacity:0;transform:translate(var(--dx),var(--dy)) rotate(100deg) scale(.6)}}
@media(prefers-reduced-motion:reduce){#player-sprite-wrap{animation:none!important;}.flying-card{display:none;}}
</style>
</head>
<body>
<div id="wrap">
  <div id="hdr">⚔  @venturerer III  ⚔</div><div id="autosave-error" role="status" hidden></div>

  <!-- TITLE -->
  <div id="s-title" class="scr on">
    <img id="t-art-img" style="max-width:min(480px,90vw);image-rendering:auto;border:2px solid #3a2e1e;box-shadow:0 0 30px rgba(0,0,0,0.8);" src="data:image/jpeg;base64,