const TEX_DOORS = {};
setTimeout(() => {
  for(const type of ['wood','stone','metal']){
    const img = SPRITE_IMGS['door_'+type];
    if(img && img.complete){
TEX_DOORS['door_'+type] = new Uint8ClampedArray(TEX_SZ*TEX_SZ*4);
      TEX_DOORS['door_'+type].set(loadTexFromImage(img));
    }
  }
}, 300);

