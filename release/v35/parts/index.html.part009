" alt="@venturerer III">
    <div style="font-family:'VT323',monospace;font-size:28px;color:#c8a84e;letter-spacing:4px;margin-top:-8px;">@venturerer III</div>
    <div id="death-msg" style="display:none;color:#cc4444;font-size:13px;line-height:2;border:2px solid #3a2e1e;background:linear-gradient(180deg,#14100a,#0a0806);padding:8px 18px;font-family:'Share Tech Mono',monospace;"></div>
    <div class="blink" style="font-size:22px;letter-spacing:3px;">ENTER = BEGIN  ·  F = ENDLESS</div>
    <div id="save-menu">
      <button id="continue-run" class="pk-btn pk-go" onclick="continueRun()" hidden>CONTINUE</button>
      <button class="pk-btn" onclick="requestNewRun(false)">NEW RUN · N / X</button>
      <button class="pk-btn" onclick="requestNewRun(true)">ENDLESS · F / Y</button>
      <p id="save-message" role="status"></p>
    </div>
    <div id="score-table" style="margin-top:6px;text-align:left;min-width:290px;"></div>
  </div>

  <!-- DUNGEON (first person) -->
  <div id="s-dun" class="scr">
    <div id="view-wrap">
      <canvas id="view-canvas" width="640" height="400"></canvas>
      <div id="compass">N</div>
    </div>
    <div id="stat-col">
      <div class="phdr">@venturerer</div>
      <div class="sl"><span class="sk">FLOOR</span><span class="sv" id="d-fl">1</span></div>
      <div class="sl"><span class="sk">LEVEL</span><span class="sv" id="d-lv">1</span></div>
      <div class="sl"><span class="sk">EXP</span><span class="sv-xp" id="d-xp">0/100</span></div>
      <div class="bar"><div class="bf bf-xp" id="d-xp-b" style="width:0%"></div></div>
      <div class="sl"><span class="sk">HP</span><span class="sv-hp" id="d-hp">80/80</span></div>
      <div class="bar"><div class="bf bf-hp" id="d-hp-b" style="width:100%"></div></div>
      <div class="sl"><span class="sk">MP</span><span class="sv-mp" id="d-mp">30/30</span></div>
      <div class="bar"><div class="bf bf-mp" id="d-mp-b" style="width:100%"></div></div>
      <div class="sl"><span class="sk">ATK</span><span class="sv" id="d-atk">8</span></div>
      <div class="sl"><span class="sk">DEF</span><span class="sv" id="d-def">3</span></div>
      <div class="sl"><span class="sk">GOLD</span><span class="sv-g" id="d-gld">0</span></div>
      <div class="sl"><span class="sk">KILLS</span><span class="sv" id="d-kls">0</span></div>
      <hr style="border-color:var(--bdr);margin:4px 0">
      <div style="color:var(--dg);font-size:10px;line-height:1.8">
        MOVE: WASD / ARROWS / PAD<br>
        UP/W: NORTH<br>
        RIGHT/D: EAST<br>
        DOWN/S: SOUTH<br>
        LEFT/A: WEST<br>
        ENTER/F/SPACE · PAD A/X: USE DOOR<br>
        P/START: PAUSE<br>
        M: MUSIC
      </div>
      <div id="minimap-wrap">
        <canvas id="minimap" width="132" height="132"></canvas>
        <div id="minimap-label">MAP</div>
      </div>
    </div>
    <div id="log-wrap"><div id="log-inner"></div></div>
  </div>

  <!-- COMBAT -->
  <div id="s-cmb" class="scr">
    <div id="e-panel">
      <div id="battlefield">
        
        <div class="c-hudbox enemy">
          <div class="c-name" id="c-ename">GOBLIN</div>
          <div class="c-sub"><span>LV <span id="c-elv">1</span></span><span style="display:none">ATK <span id="c-eatk">6</span></span><span style="display:none">DEF <span id="c-edef">1</span></span></div>
          <div class="c-hp-row"><span class="c-hp-lbl">HP:</span><div class="c-hp-track"><div class="c-hp-fill enemy" id="c-ehp-b" style="width:100%"></div></div></div>
          <div class="c-hp-num" id="c-ehp">30/30</div>
          <div class="c-hp-row" id="c-emp-row" style="display:none"><span class="c-hp-lbl">MP:</span><div class="c-hp-track"><div class="c-hp-fill" id="c-emp-b" style="width:100%"></div></div></div>
          <div class="c-hp-num" id="c-emp" style="display:none">0/0</div>
          <div id="c-ests" class="c-statusline"></div>
        </div>
        <div class="c-hudbox player">
          <div class="c-name">@VENTURERER</div>
          <div class="c-sub player-sub"><span>LV <span id="c-plv">1</span></span><span>PLAYER</span></div>
          <div class="c-hp-row"><span class="c-hp-lbl">HP</span><div class="c-hp-track"><div class="c-hp-fill" id="c-php-b" style="width:100%"></div></div></div>
          <div class="c-hp-numline"><span id="c-php">80/80</span></div>
          <div class="c-hp-row"><span class="c-hp-lbl">MP</span><div class="c-hp-track"><div class="c-hp-fill" id="c-pmp-b" style="width:100%"></div></div></div>
          <div class="c-hp-numline"><span id="c-pmp">30/30</span></div>
        </div>
        <div id="enemy-sprite-wrap">
          <div id="enemy-shadow" class="battle-shadow"></div>
          <canvas id="e-art" width="236" height="144"></canvas>
        </div>
        <div id="player-sprite-wrap">
          <div id="player-shadow" class="battle-shadow"></div>
          <canvas id="p-art" width="252" height="160"></canvas>
        </div>
      </div>
    </div>
    
    <div id="combat-status"><div id="turn-ind" class="ti-p">YOUR TURN</div><div id="c-int"></div><div id="enemy-rule" role="note"></div><span id="combat-effects"></span></div>
    <div id="cmb-bot">
      <div id="c-log-wrap">
        <div class="phdr" style="font-size:13px;">YOUR HAND</div>
        <div id="board-title-note"></div>
        
        <div id="hand-preview" aria-live="polite">SELECT 1–5 CARDS TO PREVIEW YOUR HAND</div>
        <div id="board"></div>
      </div>
      
    <details id="combat-details"><summary>Battle details &amp; help</summary><div class="combat-detail-grid"><div id="b-panel">
      <div id="battle-side-text">
        <div id="battle-side-head">
          <div class="phdr" style="margin:0;border:none;">BATTLE LOG</div>
          <span id="c-cbo" style="display:none;color:var(--ye);font-size:16px;font-family:'VT323',monospace;"></span>
        </div>
        
        <div id="battle-note">[← →] MOVE &nbsp; [ENTER] SELECT &nbsp; [R] REDRAW &nbsp; [F] PLAY</div>
        <div id="c-log" class="compact"></div>
      </div>
    </div><div id="p-stats-wrap">
        <div class="phdr" style="font-size:13px;">BATTLE INFO</div>
        <div class="sl"><span class="sk">SHIELD</span><span class="sv-sh" id="c-shld">0</span></div>
        <div class="sl"><span class="sk">ATK×</span><span id="c-abuf" style="color:#ff8888;">1.0</span></div>
        <div class="sl"><span class="sk">DODGE</span><span id="c-dodge" style="color:var(--cy);">—</span></div>
        <div class="sl"><span class="sk">FLOOR</span><span class="sv" id="c-floor">1</span></div>
        <div class="sl"><span class="sk">GOLD</span><span class="sv-g" id="c-pgold">0</span></div>
      </div><div id="artifact-info"></div><div class="combat-help"><p>← → move · Enter/Space select · F play · R redraw · T tricks · C/Esc clear · 1–9 pick</p><p>Controller: A play · X select · Y redraw · LB tricks · B clear · Start pause</p><p>Scoring suits: ♠ damage · ♥ guard/heal · ♦ MP · ♣ gold/buff. Three scoring Clubs stun. Unchanged hands with a redraw available gain stand pat: +10% and +1 MP.</p><button class="pk-btn" onclick="S.pokerSelected=[];renderPokerBoard();pokerUpdateSummary();">Clear selection</button></div></div></details></div>
  </div>

  <!-- TREASURE -->
  <div id="s-trs" class="scr">
    <div id="trs-info">
      <div class="phdr">TREASURE VAULT</div>
      <div class="sl"><span class="sk">TURNS LEFT</span><span class="sv-g" id="trs-turns">8</span></div>
      <div class="sl"><span class="sk">GOLD FOUND</span><span class="sv-g" id="trs-gold">0</span></div>
      <div class="sl"><span class="sk">HP HEALED</span><span class="sv-hp" id="trs-hp">0</span></div>
      <hr style="border-color:var(--bdr);margin:5px 0">
      <div style="color:var(--dg);font-size:10px;line-height:1.85">
        <span style="color:var(--re)">♠</span> ATK = GOLD<br>
        <span style="color:var(--bl)">◆</span> DEF = SHIELD<br>
        <span style="color:var(--mg)">★</span> MAG = MP restore<br>
        <span style="color:var(--g)">♥</span> HLT = HEAL<br>
        <span style="color:var(--ye)">♣</span> SKL = GOLD x2
      </div>
      <div style="margin-top:auto;padding-top:6px;">
        <div style="color:var(--cy);font-size:12px;text-align:center;letter-spacing:1px;">[ Q ] TAKE LOOT &amp; LEAVE</div>
      </div>
    </div>
    <div id="trs-bwrap">
      <div style="display:flex;justify-content:space-between;align-items:baseline;margin-bottom:3px;flex-shrink:0;">
        <div class="phdr" style="margin:0;border:none;">MATCH FOR LOOT</div>
        <span id="trs-cbo" style="color:var(--am);font-size:16px;font-family:'VT323',monospace;"></span>
      </div>
      <div style="font-size:10px;color:var(--dg);margin-bottom:4px;flex-shrink:0;">
        <span style="color:var(--re)">♠ATK</span>&nbsp;
        <span style="color:var(--bl)">◆DEF</span>&nbsp;
        <span style="color:var(--mg)">★MAG</span>&nbsp;
        <span style="color:var(--g)">♥HLT</span>&nbsp;
        <span style="color:var(--ye)">♣SKL</span>
        &nbsp;<span style="color:var(--dg)">ARROWS + ENTER</span>
      </div>
      <div id="trs-board"></div>
    </div>
    <div id="trs-bot">
      <div id="trs-log"></div>
    </div>
  </div>

  <div id="s-reward" class="scr">
    <div class="reward-heading">BOSS DEFEATED</div>
    <h2>Choose your artifact</h2>
    <p>One reward. Yours for the rest of this run.</p>
    <div id="reward-cards"></div>
    <p>← → choose · Enter / A claim · 1–3 quick pick</p>
  </div>
  <!-- VICTORY -->
  <div id="s-vic" class="scr">
    <div style="color:var(--am);font-family:'VT323',monospace;font-size:44px;letter-spacing:3px;text-shadow:0 0 14px var(--am);">THE KING IS SLAIN</div>
    <div id="vic-st" style="color:var(--dg);font-size:13px;line-height:2.1;"></div>
    <div class="blink" style="font-size:22px;">*** GLORY ETERNAL ***</div>
    <div style="color:var(--dg);font-size:13px;letter-spacing:2px;margin-top:8px;">PRESS ENTER OR A TO PLAY AGAIN</div>
  </div>
</div>

<!-- PAUSE -->
<div id="pause-overlay" style="display:none;position:fixed;inset:0;z-index:600;background:rgba(8,6,4,.92);align-items:center;justify-content:center;">
  <div style="border:2px solid #3a2e1e;background:linear-gradient(180deg,#14100a,#0a0806);padding:20px 28px;min-width:260px;text-align:center;box-shadow:0 0 30px rgba(0,0,0,0.6);">
    <div class="phdr" style="font-size:22px;letter-spacing:4px;margin-bottom:14px;">II PAUSED</div>
    <button id="save-quit" class="pk-btn pk-go" onclick="suspendRun()">SAVE &amp; TITLE · Q / LB</button>
    <p id="pause-save-note" role="status"></p>
    <div id="pause-music-row" style="display:flex;justify-content:space-between;align-items:center;padding:8px 0;border-bottom:1px solid #3a2e1e;">
      <span style="color:#7a6a4a;font-size:13px;">MUSIC</span>
      <span id="pause-music-val" style="color:#c8a84e;font-size:14px;letter-spacing:2px;">ON</span>
    </div>
    <div style="display:flex;justify-content:space-between;align-items:center;padding:8px 0;border-bottom:1px solid #3a2e1e;margin-bottom:8px;">
      <span style="color:#7a6a4a;font-size:13px;">SWAP HINTS</span>
      <span id="pause-hints-val" style="color:#c8a84e;font-size:14px;letter-spacing:2px;">ON</span>
    </div>
    <div style="color:#7a6a4a;font-size:11px;line-height:2;margin-top:10px;">
      <button class="pk-btn" onclick="closePause()">RESUME · ENTER / A</button><br>M = TOGGLE MUSIC<br>
      H = TOGGLE HINTS<br>
      P / ENTER / A / B = RESUME<br>
      Y = MUSIC · X = HINTS
    </div>
  </div>
</div>

<!-- SHOP -->
<div id="shop-overlay">
  <div id="shop-box">
    <div style="display:flex;justify-content:center;margin:0 0 8px 0;">
      <img id="shop-scene-img" src="data:image/png;base64," alt="Shop" style="width:min(100%,320px);height:auto;image-rendering:pixelated;border:2px solid #3a2e1e;background:#0a0806;box-shadow:0 0 16px rgba(0,0,0,.38);" />
    </div>
    <div style="display:flex;justify-content:space-between;margin-bottom:8px;">
      <div>
        <span style="color:var(--dg);font-size:12px;">GOLD:</span>
        <span class="sv-g" id="shop-gold-disp" style="font-size:13px;">0</span>
      </div>
      <div>
        <span style="color:var(--dg);font-size:12px;">HP:</span>
        <span class="sv-hp" id="shop-hp-disp" style="font-size:13px;">0</span>
      </div>
      <div>
        <span style="color:var(--dg);font-size:12px;">MP:</span>
        <span class="sv-mp" id="shop-mp-disp" style="font-size:13px;">0</span>
      </div>
    </div>
    <div id="shop-items-list"></div>
    <div style="margin-top:8px;display:flex;justify-content:center;align-items:center;">
      <div style="color:var(--dg);font-size:10px;line-height:1.4;text-align:center;">
        ↑↓ NAVIGATE &nbsp;·&nbsp; ENTER BUY &nbsp;·&nbsp; R REROLL &nbsp;·&nbsp; ESC LEAVE
      </div>
    </div>
  </div>
</div>

<script>
'use strict';

/* ═══════════════════════════════════════
   AUDIO ENGINE + CHIPTUNE
═══════════════════════════════════════ */
let _ac=null;
const ac=()=>{if(!_ac)_ac=new(window.AudioContext||window.webkitAudioContext)();return _ac;};
let _masterGain=null,_musicGain=null;
function getMasterGain(){
  if(!_masterGain){
    const ctx=ac();
    _masterGain=ctx.createGain();_masterGain.gain.value=1.0;
    _masterGain.connect(ctx.destination);
    _musicGain=ctx.createGain();_musicGain.gain.value=0.28;
    _musicGain.connect(_masterGain);
  }
  return{master:_masterGain,music:_musicGain};
}
function tone(f,dur,type='square',vol=0.09,delay=0){
  try{
    const ctx=ac(),t=ctx.currentTime+delay;
    const o=ctx.createOscillator(),g=ctx.createGain();
    o.connect(g);g.connect(getMasterGain().master);
    o.type=type;o.frequency.setValueAtTime(f,t);
    g.gain.setValueAtTime(vol,t);
    g.gain.exponentialRampToValueAtTime(0.001,t+dur);
    o.start(t);o.stop(t+dur+0.01);
  }catch(e){}
}
const N={C3:131,D3:147,E3:165,F3:175,G3:196,A3:220,B3:247,
  C4:262,D4:294,E4:330,F4:349,G4:392,A4:440,B4:494,
  C5:523,D5:587,E5:659,F5:698,G5:784,A5:880,B5:988,C6:1047,_:0};

const TUNE_DUN={bpm:112,loop:true,ch:[
  {type:'square',vol:0.13,oct:0,notes:[
    N.E5,.25,N.D5,.25,N.C5,.5,N.E5,.25,N.D5,.25,N.A4,.5,
    N.C5,.25,N.B4,.25,N.A4,.5,N.G4,.5,N._,.5,
    N.A4,.25,N.G4,.25,N.F4,.5,N.A4,.25,N.G4,.25,N.E4,.5,
    N.G4,.25,N.F4,.25,N.E4,.5,N.C4,.5,N._,.5,
    N.E5,.5,N.F5,.5,N.G5,.5,N.E5,.5,
    N.D5,.5,N.C5,.5,N.B4,.25,N.C5,.25,N.D5,.5,
    N.E5,.5,N.G5,.5,N.A5,.5,N._,.5,
    N.G5,.25,N.F5,.25,N.E5,.5,N.C5,.75,N._,.25,
  ]},
  {type:'square',vol:0.09,oct:-1,notes:[
    N.A3,.5,N._,.5,N.A3,.5,N._,.5,N.F3,.5,N._,.5,N.C4,.5,N._,.5,
    N.E3,.5,N._,.5,N.E3,.5,N._,.5,N.C3,.5,N._,.5,N.G3,.5,N._,.5,
    N.A3,.5,N._,.5,N.C4,.5,N._,.5,N.F3,.5,N._,.5,N.G3,.5,N._,.5,
    N.A3,.5,N._,.5,N.E4,.5,N._,.5,N.A3,.75,N._,.5,N.A3,.25,N._,.5,
  ]},
  {type:'triangle',vol:0.06,oct:0,notes:[
    N.A4,.25,N.C5,.25,N.E5,.25,N.A5,.25,N.A4,.25,N.C5,.25,N.E5,.25,N.A5,.25,
    N.F4,.25,N.A4,.25,N.C5,.25,N.F5,.25,N.F4,.25,N.A4,.25,N.C5,.25,N.F5,.25,
    N.E4,.25,N.G4,.25,N.B4,.25,N.E5,.25,N.E4,.25,N.G4,.25,N.B4,.25,N.E5,.25,
    N.C4,.25,N.E4,.25,N.G4,.25,N.C5,.25,N.C4,.25,N.E4,.25,N.G4,.25,N.C5,.25,
    N.A4,.25,N.C5,.25,N.E5,.25,N.A5,.25,N.A4,.25,N.C5,.25,N.E5,.25,N.A5,.25,
    N.F4,.25,N.A4,.25,N.C5,.25,N.F5,.25,N.G4,.25,N.B4,.25,N.D5,.25,N.G5,.25,
    N.A4,.25,N.E5,.25,N.A5,.25,N.E5,.25,N.C5,.25,N.E5,.25,N.G5,.25,N.E5,.25,
    N.D5,.25,N.A4,.25,N.F5,.25,N.A4,.25,N.A4,.5,N._,.25,N.A4,.25,
  ]},
]};
const TUNE_CMB={bpm:160,loop:true,ch:[
  {type:'square',vol:0.13,oct:0,notes:[
    N.E5,.25,N.E5,.25,N.E5,.25,N._,.25,N.E5,.25,N._,.25,N.E5,.25,N._,.25,
    N.D5,.25,N.D5,.25,N.D5,.25,N._,.25,N.D5,.25,N._,.25,N.C5,.5,
    N.B4,.25,N.B4,.25,N.B4,.25,N._,.25,N.C5,.25,N.D5,.25,N.E5,.5,
    N.A4,.5,N.E5,.5,N.D5,.25,N.C5,.25,N.B4,.5,
    N.E5,.25,N.G5,.25,N.A5,.5,N.G5,.25,N.E5,.25,N.D5,.5,
    N.C5,.5,N.E5,.5,N.G5,.25,N.A5,.25,N.B5,.5,
    N.A5,.25,N.G5,.25,N.E5,.5,N.D5,.25,N.C5,.25,N.B4,.5,
    N.A4,.5,N._,.25,N.E5,.25,N.A5,.5,
  ]},
  {type:'sawtooth',vol:0.07,oct:-1,notes:[
    N.A3,.25,N._,.25,N.A3,.25,N._,.25,N.A3,.25,N._,.25,N.E3,.25,N._,.25,
    N.D3,.25,N._,.25,N.D3,.25,N._,.25,N.D3,.25,N._,.25,N.A3,.25,N._,.25,
    N.E3,.25,N._,.25,N.E3,.25,N._,.25,N.E3,.25,N._,.25,N.B3,.25,N._,.25,
    N.A3,.25,N._,.25,N.A3,.25,N._,.25,N.E4,.25,N._,.25,N.A3,.25,N._,.25,
    N.A3,.25,N._,.25,N.C4,.25,N._,.25,N.D4,.25,N._,.25,N.A3,.25,N._,.25,
    N.C4,.25,N._,.25,N.E4,.25,N._,.25,N.G4,.25,N._,.25,N.E4,.25,N._,.25,
    N.A3,.5,N.E4,.5,N.D4,.25,N.C4,.25,N.B3,.5,
    N.A3,.5,N._,.5,N.E4,.5,N._,.5,
  ]},
]};

let _music={playing:false,tune:null,startT:0,handles:[],fadingOut:false};
function playTune(tune){
  stopMusic(true);if(!tune)return;
  const ctx=ac();const{music}=getMasterGain();
  _music.playing=true;_music.tune=tune;_music.handles=[];
  function scheduleLoop(startT){
    if(!_music.playing||_music.tune!==tune)return;
    const bps=tune.bpm/60;const oH=[];let loopDur=0;
    for(const ch of tune.ch){
      let t=startT;const ns=ch.notes;
      for(let i=0;i<ns.length-1;i+=2){
        const freq=ns[i],beats=ns[i+1],dur=beats/bps;
        if(freq>0){try{
          const o=ctx.createOscillator(),g=ctx.createGain();
          o.connect(g);g.connect(music);o.type=ch.type;o.frequency.value=freq;
          const on=Math.max(0.001,dur*0.82);
          g.gain.setValueAtTime(0,t);g.gain.linearRampToValueAtTime(ch.vol,t+0.01);
          g.gain.setValueAtTime(ch.vol,t+on-0.01);g.gain.linearRampToValueAtTime(0,t+on);
          o.start(t);o.stop(t+dur+0.05);oH.push(o);
        }catch(e){}}
        t+=dur;
      }
      loopDur=Math.max(loopDur,t-startT);
    }
    _music.handles.push(...oH);
    if(tune.loop){
      const nId=setTimeout(()=>scheduleLoop(startT+loopDur),Math.max(100,(loopDur-0.3)*1000));
      _music.handles.push({_to:nId,stop:()=>clearTimeout(nId)});
    }
  }
  scheduleLoop(ctx.currentTime+0.05);
}
function stopMusic(immediate=false){
  _music.playing=false;
  for(const h of _music.handles){if(h._to!==undefined)clearTimeout(h._to);else try{h.stop();}catch(e){}}
  _music.handles=[];
}
function fadeOutMusic(){
  if(!_music.playing)return;
  const{music}=getMasterGain();const ctx=ac();
  music.gain.setValueAtTime(music.gain.value,ctx.currentTime);
  music.gain.linearRampToValueAtTime(0,ctx.currentTime+0.8);
  setTimeout(()=>{stopMusic(true);music.gain.value=0.28;},900);
}
function setMusic(which){
  if(!S.musicOn){stopMusic(true);return;}
  if(_music.playing&&_music.tune===(which==='cmb'?TUNE_CMB:TUNE_DUN))return;
  if(which==='cmb')playTune(TUNE_CMB);
  else if(which==='dun')playTune(TUNE_DUN);
  else{fadeOutMusic();}
}
