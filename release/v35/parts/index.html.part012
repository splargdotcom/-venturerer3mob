SPRITE_IMG_B64.hero_battle='';
const SPRITE_IMGS = {};
// Pre-load all image sprites from base64
(function(){
  for(const [key, b64] of Object.entries(SPRITE_IMG_B64)){
    const img = new Image();
    img.src = 'data:image/png;base64,' + b64;
    SPRITE_IMGS[key] = img;
  }
})();

/* ═══════════════════════════════════════
   PROCEDURAL STONE TEXTURES (64x64)
   Can be overridden via SPRITE_IMG_B64 keys: wall_tex, floor_tex, ceil_tex
═══════════════════════════════════════ */
const TEX_SZ = 64;
const TEX_WALL = new Uint8ClampedArray(TEX_SZ * TEX_SZ * 4);
const TEX_FLOOR = new Uint8ClampedArray(TEX_SZ * TEX_SZ * 4);
const TEX_CEIL = new Uint8ClampedArray(TEX_SZ * TEX_SZ * 4);
let TEX_WALL_IMG = null, TEX_FLOOR_IMG = null, TEX_CEIL_IMG = null;

function genStoneTex(buf, baseR, baseG, baseB, mortarR, mortarG, mortarB, brickRows, brickCols, variation) {
  const S = TEX_SZ;
  const bh = S / brickRows, bw = S / brickCols;
  for (let y = 0; y < S; y++) {
    for (let x = 0; x < S; x++) {
      const row = Math.floor(y / bh);
      const off = (row % 2) ? bw * 0.5 : 0;
      const bx = (x + off) % S;
      const col = Math.floor(bx / bw);
      const fy = (y % bh) / bh, fx = (bx % bw) / bw;
      // Mortar check
      const mw = 0.06;
      const isMortar = fy < mw || fy > 1 - mw || fx < mw || fx > 1 - mw;
      // Pseudo-random per brick
      const seed = ((row * 7919 + col * 104729) & 0xFFFF);
      const brickVar = ((seed & 0xFF) / 255 - 0.5) * variation;
      // Noise within brick
      const nx = ((x * 13 + y * 37 + seed) & 0xFF) / 255;
      const noise = (nx - 0.5) * variation * 0.4;
      const i = (y * S + x) * 4;
      if (isMortar) {
        buf[i] = mortarR; buf[i+1] = mortarG; buf[i+2] = mortarB;
      } else {
        const v = 1.0 + brickVar + noise;
        buf[i]   = Math.min(255, Math.max(0, Math.floor(baseR * v)));
        buf[i+1] = Math.min(255, Math.max(0, Math.floor(baseG * v)));
        buf[i+2] = Math.min(255, Math.max(0, Math.floor(baseB * v)));
      }
      buf[i+3] = 255;
    }
  }
}

function loadTexFromImage(img) {
  const c = document.createElement('canvas');
  c.width = TEX_SZ; c.height = TEX_SZ;
  const cx = c.getContext('2d');
  cx.imageSmoothingEnabled = false;
  cx.drawImage(img, 0, 0, TEX_SZ, TEX_SZ);
  return cx.getImageData(0, 0, TEX_SZ, TEX_SZ).data;
}

function initTextures() {
  // Grey stone wall - cool blue-grey
  genStoneTex(TEX_WALL, 95, 92, 98, 28, 28, 32, 4, 3, 0.22);
  // Grey stone floor - slightly warmer grey
  genStoneTex(TEX_FLOOR, 78, 76, 72, 22, 22, 24, 3, 3, 0.18);
  // Dark stone ceiling - cool dark grey
  genStoneTex(TEX_CEIL, 55, 54, 60, 18, 18, 22, 3, 4, 0.20);
  // Override with user textures if provided
  function overrideTexIfReady(img, buf) {
    if (!img) return;
    function apply() {
      const d = loadTexFromImage(img);
      buf.set(d);
    }
    if (img.complete && img.naturalWidth > 0) {
      apply();
    } else {
      img.onload = apply;
    }
  }
  overrideTexIfReady(SPRITE_IMGS['wall_tex'], TEX_WALL);
  overrideTexIfReady(SPRITE_IMGS['floor_tex'], TEX_FLOOR);
  overrideTexIfReady(SPRITE_IMGS['ceil_tex'], TEX_CEIL);
}
 setTimeout(() => {
    for(const type of ['wood','stone','metal']){
      const img = SPRITE_IMGS['door_'+type];
      if(img && img.complete){
        const key = 'door_'+type;
        const buf = new Uint8ClampedArray(TEX_SZ*TEX_SZ*4);
        const c = document.createElement('canvas');
        c.width = TEX_SZ; c.height = TEX_SZ;
        const cx = c.getContext('2d');
        cx.imageSmoothingEnabled = false;
        cx.drawImage(img, 0, 0, TEX_SZ, TEX_SZ);
        buf.set(cx.getImageData(0, 0, TEX_SZ, TEX_SZ).data);
        TEX_DOORS[key] = buf;
      }
    }
  }, 300);

function sampleTex(buf, u, v, bright) {
  const tx = ((Math.floor(u * TEX_SZ) % TEX_SZ) + TEX_SZ) % TEX_SZ;
  const ty = ((Math.floor(v * TEX_SZ) % TEX_SZ) + TEX_SZ) % TEX_SZ;
  const i = (ty * TEX_SZ + tx) * 4;
  return [
    Math.min(255, Math.floor(buf[i] * bright)),
    Math.min(255, Math.floor(buf[i+1] * bright)),
    Math.min(255, Math.floor(buf[i+2] * bright))
  ];
}

function drawImageSprite(ctx, img, dx, dy, dw, dh, bright){
  if(!img || !img.complete) return false;
  // Draw to offscreen canvas to apply brightness
  const oc = document.createElement('canvas');
  oc.width = img.width; oc.height = img.height;
  const ox = oc.getContext('2d');
  ox.drawImage(img, 0, 0);
  if(bright < 0.95){
    ox.globalCompositeOperation = 'multiply';
    const bv = Math.floor(bright * 255);
    ox.fillStyle = `rgb(${bv},${bv},${bv})`;
    ox.fillRect(0, 0, oc.width, oc.height);
    ox.globalCompositeOperation = 'destination-in';
    ox.drawImage(img, 0, 0);
  }
  ctx.imageSmoothingEnabled = false;
  ctx.drawImage(oc, dx, dy, dw, dh);
  return true;
}


function drawPixelSprite(ctx, spr, dx, dy, dw, dh, bright){
  if(!spr) return;
  const pw = dw / spr.w;
  const ph = dh / spr.h;
  for(let sy = 0; sy < spr.h; sy++){
    for(let sx = 0; sx < spr.w; sx++){
      const ci = spr.px[sy][sx];
      if(ci === 0) continue;
      const col = spr.pal[ci - 1];
      const r = Math.min(255, Math.floor(col[0] * bright));
      const g = Math.min(255, Math.floor(col[1] * bright));
      const b = Math.min(255, Math.floor(col[2] * bright));
      ctx.fillStyle = `rgb(${r},${g},${b})`;
      ctx.fillRect(Math.floor(dx + sx * pw), Math.floor(dy + sy * ph),
        Math.ceil(pw) + 1, Math.ceil(ph) + 1);
    }
  }
}

function drawEnemy(ctx,en,rect,bright,depth){
  const cx=(rect.l+rect.r)/2,cy=(rect.t+rect.b)/2;
  const sz=Math.max(10,(rect.b-rect.t)*0.85);
  const boss=en.isBoss;

  // Shadow on ground
  ctx.fillStyle='rgba(0,0,0,0.28)';
  ctx.beginPath();ctx.ellipse(cx,rect.b-1,sz*0.32,sz*0.06,0,0,Math.PI*2);ctx.fill();

  // Get sprite data - prefer image sprites over pixel sprites
  const sprKey = SPRITE_MAP[en.def.name] || SPRITE_MAP[en.def.id] || 'gob';
  const sprImg = SPRITE_IMGS[sprKey];
  const spr = SPRITES[sprKey];
  
  // Calculate draw rect
  const scale = SPRITE_SCALE[sprKey] || 1.0;
  let sprW = rect.r - rect.l;
  let sprH = rect.b - rect.t;
  const sprX = cx - sprW/2;
const sprY = rect.b - sprH;
  
  if(sprImg && sprImg.complete){
    // Use high-res image sprite
    const aspect = sprImg.width / sprImg.height;
    if(sprW / aspect > sprH){ sprW = sprH * aspect; }
    else { sprH = sprW / aspect; }
    const sprX = cx - sprW/2;
    const sprY = rect.b - sprH;
    drawImageSprite(ctx, sprImg, sprX, sprY, sprW, sprH, bright);
  } else if(spr){
    // Fallback to pixel sprite
    const aspect = spr.w / spr.h;
    if(sprW / aspect > sprH){ sprH = sprW / aspect; }
    else { sprW = sprH * aspect; }
    if(sprH > rect.b - rect.t){ sprH = rect.b - rect.t; sprW = sprH * aspect; }
    const sprX = cx - sprW/2;
    const sprY = rect.b - sprH;
    drawPixelSprite(ctx, spr, sprX, sprY, sprW, sprH, bright);
  }

  // Boss glow effect
  if(boss && sz > 16){
    const glow = ctx.createRadialGradient(cx, cy, sz*0.1, cx, cy, sz*0.6);
    glow.addColorStop(0, `rgba(255,200,50,${0.08*bright})`);
    glow.addColorStop(1, 'rgba(0,0,0,0)');
    ctx.fillStyle = glow;
    ctx.fillRect(rect.l - 10, rect.t - 10, rect.r - rect.l + 20, rect.b - rect.t + 20);
  }

  // Name label
  if(depth<=3&&sz>12){
    ctx.font=`${Math.max(9,16-depth*2)}px "VT323",monospace`;ctx.textAlign='center';
    ctx.fillStyle='#000';ctx.fillText(en.def.name,cx+1,rect.t-2);
    ctx.fillStyle=boss?'#ffcc00':'#ff8866';ctx.fillText(en.def.name,cx,rect.t-3);
    ctx.textAlign='left';
  }
}

