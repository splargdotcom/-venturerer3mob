   COMBAT
═══════════════════════════════════════ */

/* cleanup removed legacy/overridden block */


function combatBackHeroKey(){ return SPRITE_IMGS['hero_n'] ? 'hero_n' : heroSpriteKey(); }
function combatPlayerBattleKey(){
  return SPRITE_IMGS['hero_battle'] ? 'hero_battle' : combatBackHeroKey();
}
function combatPulse(id, cls='hit-shake', dur=260){
  const el=ge(id); if(!el) return;
  el.classList.remove(cls); void el.offsetWidth; el.classList.add(cls);
  setTimeout(()=>el.classList.remove(cls), dur);
}

function combatSpriteFootMetrics(canvas){
  if(!canvas) return null;
  const ctx=canvas.getContext('2d',{willReadFrequently:true}) || canvas.getContext('2d');
  if(!ctx) return null;
  const w=canvas.width|0, h=canvas.height|0;
  if(!w || !h) return null;
  const img=ctx.getImageData(0,0,w,h).data;
  const solidAlpha=72;
  let minX=w, maxX=-1, minY=h, maxY=-1;
  for(let y=0;y<h;y++){
    for(let x=0;x<w;x++){
      const a=img[(y*w+x)*4+3];
      if(a>solidAlpha){
        if(x<minX)minX=x;
        if(x>maxX)maxX=x;
        if(y<minY)minY=y;
        if(y>maxY)maxY=y;
      }
    }
  }
  if(maxX<0 || maxY<0) return null;

  const boxH=maxY-minY+1;
  const bandDepth=Math.max(4, Math.min(10, Math.round(boxH*0.14)));
  const bandStart=Math.max(minY, maxY-bandDepth+1);
  const hits=new Array(w).fill(0);
  const lowest=new Array(w).fill(-1);

  for(let y=bandStart;y<=maxY;y++){
    for(let x=minX;x<=maxX;x++){
      const a=img[(y*w+x)*4+3];
      if(a>solidAlpha){
        hits[x]++;
        lowest[x]=y;
      }
    }
  }

  const rowCount=maxY-bandStart+1;
  let minHits=Math.max(1, Math.ceil(rowCount*0.45));
  let active=[];
  for(let x=minX;x<=maxX;x++){
    if(hits[x] >= minHits) active.push(x);
  }
  if(!active.length){
    minHits=Math.max(1, Math.ceil(rowCount*0.22));
    for(let x=minX;x<=maxX;x++){
      if(hits[x] >= minHits) active.push(x);
    }
  }
  if(!active.length){
    active=[];
    const scanStart=Math.max(minY, Math.floor(maxY - Math.max(6,boxH*0.20)));
    for(let y=scanStart;y<=maxY;y++){
      for(let x=minX;x<=maxX;x++){
        const a=img[(y*w+x)*4+3];
        if(a>solidAlpha) active.push(x);
      }
    }
    if(!active.length) return {
      footCenterX:(minX+maxX)/2,
      footSpan:Math.max(1,maxX-minX+1),
      footMaxY:maxY
    };
    active=[...new Set(active)].sort((a,b)=>a-b);
  }

  const runs=[];
  let rs=active[0], rp=active[0];
  for(let i=1;i<active.length;i++){
    const x=active[i];
    if(x-rp<=2){ rp=x; continue; }
    runs.push({start:rs,end:rp});
    rs=rp=x;
  }
  runs.push({start:rs,end:rp});

  for(const r of runs){
    let weight=0, localMaxY=-1;
    for(let x=r.start;x<=r.end;x++){
      weight+=hits[x];
      if(lowest[x]>localMaxY) localMaxY=lowest[x];
    }
    r.weight=weight;
    r.footMaxY=localMaxY;
    r.span=r.end-r.start+1;
  }

  const bestWeight=Math.max(...runs.map(r=>r.weight||0),1);
  const keep=runs.filter(r => r.weight >= bestWeight*0.30 || r.span >= 6);
  const chosen=(keep.length?keep:runs);
  let footMinX=chosen[0].start, footMaxX=chosen[chosen.length-1].end, footMaxY=maxY;
  for(const r of chosen){
    if(r.start<footMinX) footMinX=r.start;
    if(r.end>footMaxX) footMaxX=r.end;
    if(r.footMaxY>footMaxY) footMaxY=r.footMaxY;
  }

  return {
    footCenterX:(footMinX+footMaxX)/2,
    footSpan:Math.max(1,footMaxX-footMinX+1),
    footMaxY
  };
}

function syncCombatShadow(wrapId, canvasId, shadowId, opts={}){
  const wrap=ge(wrapId), canvas=ge(canvasId), shadow=ge(shadowId);
  if(!wrap || !canvas || !shadow) return;
  const m=combatSpriteFootMetrics(canvas);
  if(!m){
    shadow.style.left='50%';
    shadow.style.bottom=opts.fallbackBottom||'8px';
    shadow.style.width=opts.fallbackWidth||'108px';
    shadow.style.height=opts.fallbackHeight||'12px';
    return;
  }
  const wrapRect=wrap.getBoundingClientRect();
  const canvasRect=canvas.getBoundingClientRect();
  const scaleX=canvasRect.width/canvas.width;
  const scaleY=canvasRect.height/canvas.height;
  const offsetLeft=canvasRect.left-wrapRect.left;
  const offsetTop=canvasRect.top-wrapRect.top;
  const footCenterCss=offsetLeft + (m.footCenterX*scaleX);
  const footBottomCss=offsetTop + ((m.footMaxY+1)*scaleY);
  const footSpanCss=m.footSpan*scaleX;
  const shadowWidth=Math.max(opts.minWidth||36, Math.min(opts.maxWidth||wrapRect.width*0.78, footSpanCss*(opts.widthFactor||0.82)));
  const shadowHeight=Math.max(opts.minHeight||8, Math.min(opts.maxHeight||18, shadowWidth*(opts.heightFactor||0.14)));
  const shadowBottom=Math.max(opts.minBottom||1, Math.min(opts.maxBottom||16, wrapRect.height-footBottomCss+(opts.bottomOffset||1)));
  shadow.style.left=footCenterCss.toFixed(1)+'px';
  shadow.style.width=shadowWidth.toFixed(1)+'px';
  shadow.style.height=shadowHeight.toFixed(1)+'px';
  shadow.style.bottom=shadowBottom.toFixed(1)+'px';
}

function renderCombatSprites(){
  if(!S.enemy) return;
  const eCanvas=ge('e-art');
  if(eCanvas){
    const eCtx=eCanvas.getContext('2d');
    eCtx.clearRect(0,0,eCanvas.width,eCanvas.height);
    const sprKey=SPRITE_MAP[S.enemy.def.name] || SPRITE_MAP[S.enemy.def.id] || 'gob';
    const img=SPRITE_IMGS[sprKey];
    const spr=SPRITES[sprKey];
    if(img && img.complete && img.naturalWidth){
      const bounds=spriteBounds(img);
      const aspect=bounds.w/bounds.h;
      let sw=eCanvas.width*0.94, sh=sw/aspect;
      if(sh>eCanvas.height*0.94){ sh=eCanvas.height*0.94; sw=sh*aspect; }
      eCtx.imageSmoothingEnabled=false;
      eCtx.drawImage(img,bounds.x,bounds.y,bounds.w,bounds.h,(eCanvas.width-sw)/2,eCanvas.height-sh,sw,sh);
    }else if(spr){
      const aspect=spr.w/spr.h;
      let sw=eCanvas.width*0.94, sh=sw/aspect;
      if(sh>eCanvas.height*0.94){ sh=eCanvas.height*0.94; sw=sh*aspect; }
      drawPixelSprite(eCtx,spr,(eCanvas.width-sw)/2,eCanvas.height-sh,sw,sh,1.0);
    }
    syncCombatShadow('enemy-sprite-wrap','e-art','enemy-shadow',{
      fallbackBottom:'10px',
      fallbackWidth:'116px',
      fallbackHeight:'16px',
      widthFactor:0.72,
      heightFactor:0.12,
      minWidth:28,
      maxWidth:122,
      minBottom:2,
      maxBottom:16,
      bottomOffset:0
    });
  }
  const pCanvas=ge('p-art');
  if(pCanvas){
    const pCtx=pCanvas.getContext('2d');
    pCtx.clearRect(0,0,pCanvas.width,pCanvas.height);
    const pKey=combatPlayerBattleKey();
    const pImg=SPRITE_IMGS[pKey];
    const pSpr=SPRITES[pKey];
    if(pImg && pImg.complete && pImg.naturalWidth){
      const bounds=spriteBounds(pImg);
      const aspect=bounds.w/bounds.h;
      let sw=pCanvas.width*0.98, sh=sw/aspect;
      if(sh>pCanvas.height*0.98){ sh=pCanvas.height*0.98; sw=sh*aspect; }
      pCtx.imageSmoothingEnabled=false;
      pCtx.drawImage(pImg,bounds.x,bounds.y,bounds.w,bounds.h,(pCanvas.width-sw)/2,pCanvas.height-sh,sw,sh);
    }else if(pSpr){
      const aspect=pSpr.w/pSpr.h;
      let sw=pCanvas.width*0.98, sh=sw/aspect;
      if(sh>pCanvas.height*0.98){ sh=pCanvas.height*0.98; sw=sh*aspect; }
      drawPixelSprite(pCtx,pSpr,(pCanvas.width-sw)/2,pCanvas.height-sh,sw,sh,1.0);
    }
    syncCombatShadow('player-sprite-wrap','p-art','player-shadow',{
      fallbackBottom:'10px',
      fallbackWidth:'108px',
      fallbackHeight:'12px',
      widthFactor:0.66,
      heightFactor:0.11,
      minWidth:26,
      maxWidth:92,
      minBottom:4,
      maxBottom:18,
      bottomOffset:4
    });
  }
}
function setIntent(){
  if(!S.enemy)return;
  const mvs=MOVES[S.enemy.def.name]||[{n:'ATTACK',d:5}];
  const m=mvs[Math.floor(Math.random()*mvs.length)];
  S.enemy.intent={...m};
  renderEnemyIntent();
}
function renderEnemyIntent(){
  const m=S.enemy.intent;if(!m)return;
  const sd=Math.floor((m.d||0)*(1+(S.floor-1)*.13));
  let txt=`NEXT: ${m.n}`;
  if(m.d)txt+=` (~${sd})`;
  if(m.s==='burn')txt+=' [BURN]';if(m.s==='stun')txt+=' [STUN — you lose next turn!]';if(m.s==='pierce')txt+=' [PIERCE]';if(m.s==='weaken')txt+=' [WEAKEN]';if(m.s==='drain')txt+=' [DRAIN]';
  ge('c-int').textContent=txt;
}
async function doEnemyTurn(){
  if(S.mode!=='cmb'||!S.enemy||S.enemy.hp<=0)return;
  const activeRun=S;
  let enemyLogName='';
  let enemyLogMeta={};
  if((S.estatus.burn||0)>0){
    S.estatus.burn--;const bd=9;
    S.enemy.hp=Math.max(0,S.enemy.hp-bd);
    enemyLogName='burn tick';
    enemyLogMeta={burnTick:bd};
    battleFloat('enemy',bd,'burn');combatPulse('e-art','impact-hit',280);
    clog(`🔥 BURN: ${bd} dmg to ${S.enemy.def.name}`,'mag');
    updateCUI();await waitForGame(280);
    if(S!==activeRun||S.runEnded||S.mode!=='cmb')return;
    if(S.enemy.hp<=0){checkEnd();return;}
  }
  if((S.estatus.stun||0)>0){
    S.estatus.stun--;clog(`⚡ ${S.enemy.def.name} STUNNED`,'skl');updateCUI();
  }else{
    const mvs=MOVES[S.enemy.def.name]||[{n:'ATTACK',d:5}];
    const mv=S.enemy.intent || mvs[0];
    let dmg=Math.floor((mv.d||0)*(1+(S.floor-1)*.13));
    if(mv.s==='regen'){
      const rg=Math.floor(S.enemy.maxHp*.12);
      S.enemy.hp=Math.min(S.enemy.maxHp,S.enemy.hp+rg);
      enemyLogName=mv.n; enemyLogMeta={kind:mv.s||'regen',heal:rg};
      combatPulse('e-art','play-pulse',240);
      clog(`💚 ${mv.n}: +${rg}HP`,'hlt');
    }else if(mv.s==='buff'){
      S.enemy.atk=Math.floor(S.enemy.atk*1.3);
      enemyLogName=mv.n; enemyLogMeta={kind:mv.s||'buff',enemyAtk:S.enemy.atk};
      combatPulse('e-art','play-pulse',240);
      clog(`💢 ${mv.n}: ATK→${S.enemy.atk}`,'atk');
    }else{
      if(S.dodgeNext&&mv.d>0){
        S.dodgeNext=false;battleFloat('player','DODGE','notice');clog(`💨 DODGE! ${mv.n} avoided!`,'skl');SFX.cursor();
      }else{
        S.dodgeNext=false;
        const blk=Math.min(S.shield,dmg);dmg-=blk;S.shield=Math.max(0,S.shield-blk);
        const fd=mv.s==='pierce'?Math.max(0,dmg):Math.max(0,dmg-Math.floor(S.p.def*.35));
        enemyLogName=mv.n; enemyLogMeta={kind:mv.s||'attack',rawDamage:mv.d||0,finalDamage:fd,blocked:blk};
        S.p.hp=Math.max(0,S.p.hp-fd);SFX.dmg();
        if(fd===0&&mv.d>0)battleFloat('player','BLOCKED','notice');
        if(fd>0){ battleFloat('player',fd);combatPulse('p-art','impact-hit',280); }
        const sfx=mv.s==='burn'?'🔥':mv.s==='stun'?'⚡':mv.s==='drain'?'🩸':'🗡';
        clog(`${sfx} ${mv.n}: ${fd}dmg`+(blk?` (${blk}blkd)`:''),'atk');
        if(mv.s==='burn')S.pstatus.burn=(S.pstatus.burn||0)+3;
        if(mv.s==='weaken')S.atkBuff=Math.max(.3,S.atkBuff-.5);
        if(mv.s==='drain')S.enemy.hp=Math.min(S.enemy.maxHp,S.enemy.hp+Math.floor(fd*.6));
        if(mv.s==='stun'){
          if((S.pstatus.stunImmune||0)>0){
            clog(`⚡ You resist the stun!`,'skl');
          } else {
            S.pstatus.stunned=1;
          }
        }
      }
    }
  }
  if((S.pstatus.burn||0)>0){S.pstatus.burn--;const bd=3;S.p.hp=Math.max(0,S.p.hp-bd);enemyLogMeta.playerBurn=(enemyLogMeta.playerBurn||0)+bd;clog(`🔥 You burn: ${bd}`,'atk');}
  if((S.pstatus.stunImmune||0)>0)S.pstatus.stunImmune--;
  logEnemyAction(enemyLogName||'enemy turn',enemyLogMeta);
  updateCUI();setIntent();await waitForGame(300);
  if(S!==activeRun)return;
  if(S.p.hp<=0){checkEnd();return;}
  setTurn(true);renderPokerBoard();
}
function checkEnd(){if(S.enemy&&S.enemy.hp<=0)winCombat();else if(S.p.hp<=0)loseCombat();}
function winCombat(){
  closeFightLog('victory');
  SFX.kill();
  const def=S.enemy.def;
  const xp=def.xp,gold=def.gold[0]+Math.floor(Math.random()*(def.gold[1]-def.gold[0]));
  S.p.xp+=xp;S.p.gold+=gold;S.p.kills++;S.totalKills++;
  clog(`VICTORY! +${xp}XP +${gold}G`,'win');
  while(S.p.xp>=S.p.xpNext){
    S.p.xp-=S.p.xpNext;S.p.xpNext=Math.floor(S.p.xpNext*1.6);
    S.p.level++;S.p.maxHp+=10;S.p.hp=Math.min(S.p.maxHp,S.p.hp+10);
    S.p.maxMp+=4;S.p.atk+=1;S.p.def+=1;
    SFX.lvlup();clog(`LEVEL ${S.p.level}! ATK+1 MaxHP+10`,'win');
    log(`⬆ LEVEL ${S.p.level}! ATK+1, MaxHP+10`,'l');
  }
  S.enemy.ref.dead=true;
  if(S.enemy.def.id==='king') S.kingDead=true;
  // Artifact drops from boss kills or rare normal kills
  S.bossRewardPending=!!def.boss;
  if(!def.boss && Math.random()<0.15){
    const available=POKER_ARTIFACTS.filter(a=>!S.artifacts.some(x=>x.id===a.id));
    if(available.length>0){
      const pool=available.filter(a=>def.boss?true:a.rarity<=1);
      if(pool.length>0){
        const art=pool[Math.floor(Math.random()*pool.length)];
        grantArtifact(art);
        clog('🃏 '+def.name+' dropped: '+art.name+'!','win');
      }
    }
  }
  clog(`─────────────────────`,'n');
  clog(`BATTLE REPORT:`,'c');
  clog(`Turns: ${S.combatStats.turnsPlayed}  Total DMG: ${S.combatStats.totalDmg}`,'n');
  if(S.combatStats.bestHand)clog(`Best Hand: ${S.combatStats.bestHand} (${S.combatStats.bestHandDmg} dmg)`,'win');
  if(S.combatStats.suitStreak.count>=2)clog(`Longest Streak: ${S.combatStats.suitStreak.count}x ${POKER_SUITS[S.combatStats.suitStreak.suit]||''}`,'skl');
  clog(`─────────────────────`,'n');
  clog(`HP: ${S.p.hp}/${S.p.maxHp}  MP: ${S.p.mp}/${S.p.maxMp}`,'n');
  clog(`Gold: ${S.p.gold}  XP: ${S.p.xp}/${S.p.xpNext}`,'n');
  clog(``,'n');
  clog(def.boss?'Press Enter / A to choose an artifact.':'Press Enter / A to continue.','c');
  S.processing=true;
  S._combatDone=true;
  renderPokerBoard();
  S.completedBattle={name:def.name,xp,gold};
  S._combatReturn=returnFromCombat;
  ge('turn-ind').textContent='VICTORY';ge('c-int').textContent='';pokerUpdateSummary();
  requestSave();
}

function returnFromCombat(){
  if(!S._combatDone)return;
  if(S.bossRewardPending){
    S.bossRewardPending=false;
    if(openArtifactReward()){requestSave();return;}
  }
  S._combatDone=false;S.processing=false;S.mode='dun';setMusic('dun');
  const reward=S.completedBattle;
  if(reward)log(`Defeated ${reward.name}. +${reward.xp}XP +${reward.gold}G`,'l');
  S.completedBattle=null;
  showScr('dun');renderView();updateDUI();requestSave();
}
function openArtifactReward(){
  const pool=POKER_ARTIFACTS.filter(a=>!hasArtifact(a.effect));
  if(!pool.length){clog('All artifacts collected.','win');return false;}
  S.rewardChoices=pokerShuffle(pool.slice()).slice(0,3);
  S.rewardCursor=0;S.mode='reward';showScr('reward');renderArtifactReward();return true;
}
function renderArtifactReward(){
  ge('reward-cards').innerHTML=S.rewardChoices.map((a,i)=>`<button class="reward-card ${i===S.rewardCursor?'reward-current':''}" onclick="chooseArtifactReward(${i})"><span class="reward-number">${i+1}</span><span class="reward-icon">${a.icon}</span><strong>${a.name}</strong><span>${a.desc}</span><em>${a.flavor}</em></button>`).join('');
}
function chooseArtifactReward(i){
  requestSave();
  if(S.mode!=='reward'||S.paused||!S.rewardChoices[i])return;
  const art=S.rewardChoices[i];grantArtifact(art);pushRunEvent('boss_artifact',{artifact:art.id});
  S.rewardChoices=[];S.mode='cmb';S._combatReturn();
}

function loseCombat(){
  S.runEnded=true;clearRunSave();
  closeFightLog('death');
  finalizeRunLog('death',{slainBy:S.enemy?S.enemy.def.name:'the dungeon'});
  saveScore({floor:S.floor,level:S.p.level,kills:S.totalKills,gold:S.p.gold,slainBy:S.enemy?S.enemy.def.name:'?'});
  stopMusic(false);SFX.gameover();
  setTimeout(()=>{
    S.mode='title';
    const dm=ge('death-msg');dm.style.display='block';
    dm.innerHTML=`<div style="color:var(--re);font-size:16px;letter-spacing:2px;margin-bottom:4px">☠ YOU HAVE DIED ☠</div><div>Slain by: <span style="color:#ff8888">${S.enemy?S.enemy.def.name:'the dungeon'}</span></div><div style="color:var(--dg);margin-top:2px">Floor ${S.floor} · Level ${S.p.level} · ${S.totalKills} kills · ${S.p.gold}G</div><div style="margin-top:10px"></div>`;
    setTitleState(true);
    showScr('title');renderScores();
    setTimeout(()=>setMusic('dun'),600);
  },1800);
}

/* ═══════════════════════════════════════
   FLOOR / DESCENT
═══════════════════════════════════════ */
function descend(entered=false){
  if(!entered){dungeonPassage('stairs',()=>descend(true));return;}
  requestSave();
  S.floor++;
  pushRunEvent('descend',{toFloor:S.floor});
   if(!S.endless&&S.floor>10&&S.kingDead){
     S.runEnded=true;clearRunSave();
    finalizeRunLog('victory',{slainBy:'VICTORY!'});
    saveScore({floor:10,level:S.p.level,kills:S.totalKills,gold:S.p.gold,slainBy:'VICTORY!'});
    ge('vic-st').innerHTML=`All 10 floors conquered!<br>The Forgotten King is dust.<br>Kills: ${S.totalKills} · Gold: ${S.p.gold} · Level: ${S.p.level}`;
    showScr('vic');S.mode='victory';return;
  }
  const drain=Math.floor(S.floor*2.5+S.p.maxHp*0.04);
  const hpBefore=S.p.hp;
  S.p.hp=Math.max(1,S.p.hp-drain);
  const{grid,rooms,doors,torches}=genFloor(S.floor,S.endless);
  S.map={grid,rooms,torches,torchSet:new Set((torches||[]).map(t=>`${t.x},${t.y}`)), torchMap:new Map((torches||[]).map(t=>[`${t.x},${t.y}`,t]))};S.doors = doors;S.enemies=placeEnemies(rooms,S.floor);
  S.seen=Array.from({length:MH},()=>Array(MW).fill(false));
  S.p.x=rooms[0].cx;S.p.y=rooms[0].cy;
  S.facing=0;
  S.mode='dun';
  const prevTheme=getFloorTheme(S.floor-1);
  const nextTheme=getFloorTheme(S.floor);
  applyFloorTheme();
  if(prevTheme.id!==nextTheme.id) log(`⟱ ${nextTheme.name.toUpperCase()} ⟱`,'c');
  if(drain>=hpBefore*0.6){
    SFX.dmg();
    log(`⬇ FLOOR ${S.floor} — THE DESCENT RIPS ${drain}HP FROM YOU!`,'d');
    if(S.p.hp<=15)log(`☠ YOU ARE CRITICAL — HEAL NOW!`,'d');
  } else if(drain>=hpBefore*0.4){
    SFX.dmg();
    log(`⬇ FLOOR ${S.floor} — the descent tears ${drain}HP from you!`,'d');
    if(S.p.hp<=S.p.maxHp*0.25)log(`⚠ You are dangerously wounded. Find healing!`,'d');
  } else {
    log(`⬇ FLOOR ${S.floor} — the descent costs ${drain}HP.`,'d');
  }
  if(S.floor===5)log(`★ A warden guards this floor...`,'d');
  if(S.floor===10)log(`★★★ THE FORGOTTEN KING AWAITS ★★★`,'d');
  updateSeen();renderView();updateDUI();
}

/* ═══════════════════════════════════════
   UI
═══════════════════════════════════════ */
function updateDUI(){
  const p=S.p;
  ge('d-fl').textContent=S.floor;
  ge('d-lv').textContent=p.level;
  ge('d-xp').textContent=`${p.xp}/${p.xpNext}`;
  ge('d-xp-b').style.width=`${p.xp/p.xpNext*100}%`;
  ge('d-hp').textContent=`${p.hp}/${p.maxHp}`;
  ge('d-hp-b').style.width=`${p.hp/p.maxHp*100}%`;
  ge('d-mp').textContent=`${p.mp}/${p.maxMp}`;
  ge('d-mp-b').style.width=`${p.mp/p.maxMp*100}%`;
  ge('d-atk').textContent=p.atk;
  ge('d-def').textContent=p.def;
  ge('d-gld').textContent=p.gold;
  ge('d-kls').textContent=p.kills;
}
function updateCUI(){
  const p=S.p,e=S.enemy;if(!e)return;
  const php=ge('c-php'); if(php) php.textContent=`${p.hp}/${p.maxHp}`;
  const phpb=ge('c-php-b'); if(phpb) phpb.style.width=`${Math.max(0,p.hp/p.maxHp*100)}%`;
  const cpmp=ge('c-pmp'); if(cpmp) cpmp.textContent=`${p.mp}/${p.maxMp}`;
  const plv=ge('c-plv'); if(plv) plv.textContent=p.level;
  const elv=ge('c-elv'); if(elv) elv.textContent=Math.max(1,S.floor);
  const cfl=ge('c-floor'); if(cfl) cfl.textContent=S.floor;
  const cpg=ge('c-pgold'); if(cpg) cpg.textContent=p.gold;
  const mpPct=p.maxMp>0?p.mp/p.maxMp:1;
  const mpBar=ge('c-pmp-b');
  if(mpBar){
    mpBar.style.width=`${Math.max(0,mpPct*100)}%`;
    if(mpPct<0.33&&p.mp<p.maxMp){mpBar.classList.add('low-mp');setTimeout(()=>mpBar.classList.remove('low-mp'),1100);}
    else{mpBar.classList.remove('low-mp');}
  }
  const sh=ge('c-shld'); if(sh) sh.textContent=S.shield;
  const ab=ge('c-abuf'); if(ab) ab.textContent=S.atkBuff.toFixed(1);
  const dd=ge('c-dodge');if(dd)dd.textContent=S.dodgeNext?'READY':'—';
  const effects=[];if(S.shield)effects.push(`Guard ${S.shield}`);if(S.atkBuff!==1)effects.push(`ATK ×${S.atkBuff.toFixed(1)}`);if(S.dodgeNext)effects.push('Dodge ready');
  ge('combat-effects').textContent=effects.join(' · ');
  const ehp=ge('c-ehp'); if(ehp) ehp.textContent=`${Math.max(0,e.hp)}/${e.maxHp}`;
  const ehpb=ge('c-ehp-b'); if(ehpb) ehpb.style.width=`${Math.max(0,e.hp/e.maxHp*100)}%`;
  const enemyHasMp=!!(e.maxMp&&e.maxMp>0);
  const empRow=ge('c-emp-row'); if(empRow) empRow.style.display=enemyHasMp?'flex':'none';
  const emp=ge('c-emp'); if(emp){ emp.style.display=enemyHasMp?'block':'none'; if(enemyHasMp) emp.textContent=`${Math.max(0,e.mp||0)}/${e.maxMp}`; }
  const empb=ge('c-emp-b'); if(empb && enemyHasMp) empb.style.width=`${Math.max(0,((e.mp||0)/e.maxMp)*100)}%`;
  const eatk=ge('c-eatk'); if(eatk) eatk.textContent=e.atk;
  const se=ge('c-ests');
  if(se){
    se.innerHTML='';
    if(S.estatus.burn>0)se.innerHTML+=`<span class="sts sts-burn">BURN(${S.estatus.burn})</span>`;
    if(S.estatus.stun>0)se.innerHTML+=`<span class="sts sts-stun">STUN(${S.estatus.stun})</span>`;
  }
}

/* ═══════════════════════════════════════
   LOGS
═══════════════════════════════════════ */
function log(msg,type='n'){
  const c=ge('log-inner');const d=document.createElement('div');
  d.className=`l-${type}`;d.textContent='> '+msg;
  c.appendChild(d);c.scrollTop=c.scrollHeight;
  while(c.children.length>16)c.removeChild(c.firstChild);
}
function clog(msg,type='n'){
  const c=ge('c-log');const d=document.createElement('div');
  d.className=`l-${type}`;d.textContent=msg;
  c.appendChild(d);c.scrollTop=c.scrollHeight;
  while(c.children.length>50)c.removeChild(c.firstChild);
}
function cardCode(card){return card?`${pokerRankLabel(card.rank)}${card.suit}`:null;}
function cardsToCodes(cards){return (cards||[]).map(cardCode).filter(Boolean);}
function initRunLog(){
  S.runLog={
    meta:{runId:S.runId||Date.now(),startedAt:new Date().toISOString(),version:'v17-handlog',endless:!!S.endless},
    turns:[],
    fights:[],
    events:[]
  };
}
function pushRunEvent(type,data={}){
  if(!S.debugLogEnabled||!S.runLog)return;
  S.runLog.events.push(Object.assign({type,ts:Date.now(),floor:S.floor},data));
}
function openFightLog(def){
  if(!S.debugLogEnabled||!S.runLog||!def)return;
  S.currentFightLog={
    enemy:def.name,
    enemyId:def.id||def.name,
    boss:!!def.boss,
    floor:S.floor,
    startedAt:new Date().toISOString(),
    startingPlayerHp:S.p.hp,
    startingPlayerMp:S.p.mp,
    startingEnemyHp:def.hp,
    turns:[]
  };
}
function closeFightLog(result){
  if(!S.debugLogEnabled||!S.runLog||!S.currentFightLog)return;
  S.currentFightLog.result=result||'unknown';
  S.currentFightLog.endedAt=new Date().toISOString();
  S.currentFightLog.endingPlayerHp=S.p.hp;
  S.currentFightLog.endingPlayerMp=S.p.mp;
  S.currentFightLog.endingGold=S.p.gold;
  S.currentFightLog.turnCount=S.currentFightLog.turns.length;
  S.runLog.fights.push(S.currentFightLog);
  S.currentFightLog=null;
}
function logDealtHand(){
  if(!S.debugLogEnabled||!S.currentFightLog)return;
  S.currentFightLog.turns.push({
    phase:'deal',
    ts:Date.now(),
    turn:S.pokerTurn||0,
    floor:S.floor,
    enemy:S.enemy?S.enemy.def.name:null,
    baseHandSize:pokerBaseHandSize(),
    tempHandMod:S.tempHandMod||0,
    actualHandSize:(S.pokerHand||[]).length,
    handSize:(S.pokerHand||[]).length,
    handPenaltyReason:S.tempHandReason||'',
    dealt:cardsToCodes(S.pokerHand||[]),
    redrawsLeft:S.pokerRedraws||0,
    playerHp:S.p.hp,
    playerMp:S.p.mp,
    enemyHp:S.enemy?S.enemy.hp:null
  });
}
function logRedraw(beforeCards,indices,afterCards){
  if(!S.debugLogEnabled||!S.currentFightLog)return;
  S.currentFightLog.turns.push({
    phase:'redraw',
    ts:Date.now(),
    turn:S.pokerTurn||0,
    floor:S.floor,
    enemy:S.enemy?S.enemy.def.name:null,
    handBefore:cardsToCodes(beforeCards),
    indices:(indices||[]).slice(),
    handAfter:cardsToCodes(afterCards),
    redrawsLeft:S.pokerRedraws||0
  });
}
function logPlayerHand(cards,out,totalDamage){
  if(!S.debugLogEnabled||!S.currentFightLog)return;
  const entry={
    phase:'player',
    ts:Date.now(),
    turn:S.pokerTurn||0,
    floor:S.floor,
    enemy:S.enemy?S.enemy.def.name:null,
    baseHandSize:pokerBaseHandSize(),
    tempHandMod:S.tempHandMod||0,
    actualHandSize:(S.pokerHand||[]).length,
    handSize:(S.pokerHand||[]).length,
    handPenaltyReason:S.tempHandReason||'',
    dealt:cardsToCodes(S.pokerHand||[]),
    selected:cardsToCodes(cards),
    effective:cardsToCodes(out.effectiveCards||cards),
    evaluated:out.evald.code,
    label:out.evald.label,
    standPat:!!out.standPat,
    junkCollapsed:!!out.evald.junkMultiHigh,
    damage:out.damage,
    pierce:out.pierce||0,
    totalDamage:totalDamage||out.damage||0,
    shield:out.shield||0,
    heal:out.heal||0,
    mp:out.mp||0,
    gold:out.gold||0,
    redrawUsed:!!S.pokerUsedRedrawThisTurn,
    redrawsLeft:S.pokerRedraws||0,
    playerHpAfter:S.p.hp,
    playerMpAfter:S.p.mp,
    enemyHpAfter:S.enemy?S.enemy.hp:null
  };
  S.currentFightLog.turns.push(entry);
  S.runLog.turns.push({
    floor:entry.floor,enemy:entry.enemy,turn:entry.turn,label:entry.label,selected:entry.selected,effective:entry.effective,damage:entry.totalDamage,standPat:entry.standPat,handSize:entry.handSize,baseHandSize:entry.baseHandSize,tempHandMod:entry.tempHandMod,handPenaltyReason:entry.handPenaltyReason
  });
}
function logEnemyAction(name,meta={}){
  if(!S.debugLogEnabled||!S.currentFightLog)return;
  S.currentFightLog.turns.push(Object.assign({
    phase:'enemy',
    ts:Date.now(),
    turn:S.pokerTurn||0,
    floor:S.floor,
    enemy:S.enemy?S.enemy.def.name:null,
    action:name,
    playerHpAfter:S.p.hp,
    playerMpAfter:S.p.mp,
    enemyHpAfter:S.enemy?S.enemy.hp:null,
    shieldAfter:S.shield
  },meta));
}
function finalizeRunLog(result,extra={}){
  if(!S.debugLogEnabled||!S.runLog)return;
  S.runLog.meta.endedAt=new Date().toISOString();
  S.runLog.meta.result=result;
  S.runLog.meta.summary=Object.assign({
    floor:S.floor,
    level:S.p.level,
    kills:S.totalKills,
    gold:S.p.gold
  },extra);
  S.lastRunLog=JSON.parse(JSON.stringify(S.runLog));
}
function downloadRunLog(){
  const payload=S.lastRunLog||S.runLog;
  if(!payload){ alert('No run log available yet.'); return; }
  const blob=new Blob([JSON.stringify(payload,null,2)],{type:'application/json'});
  const a=document.createElement('a');
  const safeFloor=(payload.meta&&payload.meta.summary&&payload.meta.summary.floor)||S.floor||1;
  const safeRun=(payload.meta&&payload.meta.runId)||Date.now();
  a.href=URL.createObjectURL(blob);
  a.download=`atventurerer_runlog_f${safeFloor}_${safeRun}.json`;
  document.body.appendChild(a);
  a.click();
  setTimeout(()=>{URL.revokeObjectURL(a.href);a.remove();},0);
}
window.downloadRunLog=downloadRunLog;

/* ═══════════════════════════════════════
   SCREENS
═══════════════════════════════════════ */
function showScr(id){
  document.querySelectorAll('.scr').forEach(s=>s.classList.remove('on'));
  ge('s-'+id).classList.add('on');
}
function setTitleState(runEnd=false){
  const title=ge('s-title');
  if(!title)return;
  title.classList.toggle('title-death',!!runEnd);
  const blink=title.querySelector('.blink');
  refreshSaveMenu();
  if(blink)blink.textContent=hasRunSave()?'ENTER / A = CONTINUE  ·  N / X = NEW RUN':runEnd?'ENTER / A = NEW RUN  ·  F / Y = ENDLESS':'ENTER / A = BEGIN  ·  F / Y = ENDLESS';
}

/* ═══════════════════════════════════════
   PAUSE
═══════════════════════════════════════ */
function openPause(){
  if(S.mode==='title'||S.mode==='victory')return;
  S.paused=true;
  ge('save-quit').disabled=!canSaveRun();
  ge('pause-save-note').textContent=canSaveRun()?'Resume later in this browser.':'Resume to finish this action before saving.';
  ge('pause-music-val').textContent=S.musicOn?'ON':'OFF';
  ge('pause-hints-val').textContent=S.hintsOn?'ON':'OFF';
  ge('pause-overlay').style.display='flex';
}
function closePause(){S.paused=false;ge('pause-overlay').style.display='none';if(S.mode==='cmb'){renderPokerBoard();pokerUpdateSummary();}requestSave();}
function toggleMusic(){
  S.musicOn=!S.musicOn;
  ge('pause-music-val').textContent=S.musicOn?'ON':'OFF';
  if(S.musicOn){if(S.mode==='cmb')setMusic('cmb');else setMusic('dun');}
  else{stopMusic(true);try{getMasterGain().music.gain.value=0.28;}catch(e){}}
}
function toggleHints(){
  S.hintsOn=!S.hintsOn;
  const el=ge('pause-hints-val');if(el)el.textContent=S.hintsOn?'ON':'OFF';
  renderBoard();
}

/* ═══════════════════════════════════════
   INPUT
═══════════════════════════════════════ */

document.addEventListener('keydown',e=>{
  const m=S.mode;
  const k=e.key;
  const lower=(k&&k.length===1)?k.toLowerCase():k;
  if(e.target.matches && e.target.matches('button, summary') && (k==='Enter'||k===' '))return;
  if(e.target.classList && e.target.classList.contains('pk-card') && (k==='Enter'||k===' ')){
    e.preventDefault();e.target.click();return;
  }
  requestSave();
  if(S.trickMenu && m==='cmb' && !S.paused){
    if(['ArrowLeft','ArrowRight','ArrowUp','ArrowDown'].includes(k)){e.preventDefault();moveTrickCursor(k==='ArrowLeft'||k==='ArrowUp'?-1:1);}
    else if(k==='Enter'||k===' '){e.preventDefault();activateTrick(S.trickCursor);}
    else if(k==='Escape'||lower==='t'){e.preventDefault();toggleTrickMenu();}
    else if(lower==='p'){e.preventDefault();openPause();}
    else if(/^[1-6]$/.test(k)){e.preventDefault();activateTrick(Number(k)-1);}
    return;
  }
  if(m==='reward' && !S.paused){
    if(lower==='p'){e.preventDefault();openPause();return;}
    if(k==='ArrowLeft'||k==='ArrowRight'){e.preventDefault();S.rewardCursor=(S.rewardCursor+(k==='ArrowLeft'?-1:1)+S.rewardChoices.length)%S.rewardChoices.length;renderArtifactReward();}
    else if(k==='Enter'||k===' '){e.preventDefault();chooseArtifactReward(S.rewardCursor);}
    else if(/^[1-3]$/.test(k)){e.preventDefault();chooseArtifactReward(Number(k)-1);}
    return;
  }
  // PAUSE OVERLAY
  if(S.paused){
    if(k==='Escape'||lower==='p'||k==='Enter'||k===' '){e.preventDefault();closePause();}
    if(lower==='q'){e.preventDefault();suspendRun();}
    if(lower==='m'){e.preventDefault();toggleMusic();}
    if(lower==='h'){e.preventDefault();toggleHints();}
    return;
  }

  // RETIRE
  if(lower==='r'&&e.shiftKey&&(m==='dun'||m==='cmb'||m==='treasure'||m==='shop')){
    e.preventDefault();
    ge('shop-overlay').classList.remove('on');
    retireRun();
    return;
  }

  // TITLE
  if(m==='title'){
    if(k==='Enter'||k===' '){e.preventDefault();if(hasRunSave())continueRun();else requestNewRun(false);}
    if(lower==='n'){e.preventDefault();requestNewRun(false);}
    if(lower==='f'||lower==='y'){e.preventDefault();requestNewRun(true);}
    return;
  }

  // VICTORY
  if(m==='victory'){
    if(k==='Enter'||k===' '||lower==='y'){e.preventDefault();startGame();}
    return;
  }

  // GLOBAL TOGGLES
  if(lower==='m'&&m!=='title'&&m!=='victory'){e.preventDefault();toggleMusic();return;}
  if(lower==='h'&&m!=='title'&&m!=='victory'){e.preventDefault();toggleHints();return;}
  if(lower==='p'&&(m==='dun'||m==='cmb'||m==='treasure'||m==='shop')){e.preventDefault();openPause();return;}

  // COMBAT
  if(m==='cmb'){
    if(S._combatDone){
      if(k==='Enter'||k===' '||k==='Escape'){
        e.preventDefault();
        if(S._combatReturn)S._combatReturn();
      }
      return;
    }
    if(S.processing||!S.playerTurn){
      if(k==='Escape'){
        e.preventDefault();
        S.pokerSelected=[];
        renderPokerBoard();
        pokerUpdateSummary();
      }
      return;
    }
    boardKey(e,false);
    return;
  }

  // DUNGEON
  if(m==='dun'){
    if(lower==='w'||k==='ArrowUp'){e.preventDefault();moveNorth();}
    else if(lower==='d'||k==='ArrowRight'){e.preventDefault();moveEast();}
    else if(lower==='s'||k==='ArrowDown'){e.preventDefault();moveSouth();}
    else if(lower==='a'||k==='ArrowLeft'){e.preventDefault();moveWest();}
    else if(k==='`'){e.preventDefault();S.debug=!S.debug;if(S.debug)S.enemies=[];log(S.debug?'DEBUG ON - enemies cleared':'DEBUG OFF','e');renderView();}
    else if(k===' '||k==='Enter'||lower==='f'){e.preventDefault();operateFacingDoor();}
    else if(k==='Escape'){e.preventDefault();openPause();}
    return;
  }

  // TREASURE
  if(m==='treasure'){
    if(lower==='q'||k==='Escape'){e.preventDefault();endTreasure(false);return;}
    if(S.tproc)return;
    boardKey(e,true);
    return;
  }

  // SHOP
  if(m==='shop'){
    if(k==='Escape'||lower==='q'){e.preventDefault();closeShop();return;}
    if(lower==='r'){e.preventDefault();openShop(true);SFX.shop();return;}
    if(k==='ArrowUp'||lower==='w'){e.preventDefault();S.shopIdx=Math.max(0,S.shopIdx-1);SFX.cursor();openShop();return;}
    if(k==='ArrowDown'||lower==='s'){e.preventDefault();S.shopIdx=Math.min((S.shopItems||SHOP_ITEMS).length-1,S.shopIdx+1);SFX.cursor();openShop();return;}
    if(k==='Enter'||k===' '){e.preventDefault();buyItem(S.shopIdx);return;}
    const n=parseInt(k,10);
    if(n>=1&&n<=6){e.preventDefault();S.shopIdx=n-1;SFX.cursor();openShop();}
    return;
  }
});

/* Browser-friendly controller support */
let LAST_INPUT_DEVICE='keyboard';
const PAD_CFG={dead:0.38,firstRepeat:220,nextRepeat:110};
const PAD_STATE={prev:{},repeatAt:{}};
function setLastInputDevice(device){ LAST_INPUT_DEVICE=device; }
window.addEventListener('mousedown',()=>setLastInputDevice('mouse'));
window.addEventListener('mousemove',()=>{ if(LAST_INPUT_DEVICE!=='mouse') setLastInputDevice('mouse'); },{passive:true});
window.addEventListener('keydown',()=>setLastInputDevice('keyboard'),{capture:true});
window.addEventListener('gamepadconnected',()=>setLastInputDevice('gamepad'));

function clampShopIndex(){
  const max=Math.max(0,((S.shopItems||SHOP_ITEMS).length||1)-1);
  S.shopIdx=Math.max(0,Math.min(max,S.shopIdx||0));
}
function clearCombatSelection(){
  S.pokerSelected=[];
  renderPokerBoard();
  pokerUpdateSummary();
}
function moveTreasureCursor(dr,dc){
  const bc=S.tc||{r:0,c:0};
  const nr=Math.max(0,Math.min(BS-1,bc.r+dr));
  const nc=Math.max(0,Math.min(BS-1,bc.c+dc));
  if(nr!==bc.r||nc!==bc.c){
    S.tc={r:nr,c:nc};
    SFX.cursor();
    renderTrsBoard();
  }
}
function handlePadAction(action){
  setLastInputDevice('gamepad');
  const m=S.mode;
  requestSave();
  if(S.trickMenu && m==='cmb' && !S.paused){
    if(['left','up','right','down'].includes(action))moveTrickCursor(action==='left'||action==='up'?-1:1);
    if(action==='confirm')activateTrick(S.trickCursor);
    if(action==='cancel'||action==='tricks')toggleTrickMenu();
    if(action==='pause')openPause();
    return;
  }
  if(m==='reward' && !S.paused){
    if(action==='pause'){openPause();return;}
    if(action==='left'||action==='right'){S.rewardCursor=(S.rewardCursor+(action==='left'?-1:1)+S.rewardChoices.length)%S.rewardChoices.length;renderArtifactReward();}
    if(action==='confirm')chooseArtifactReward(S.rewardCursor);
    return;
  }
  if(S.paused){
    if(action==='pause'||action==='cancel'||action==='confirm'){ closePause(); return; }
    if(action==='tricks'){suspendRun();return;}
    if(action==='secondary'){ toggleMusic(); return; }
    if(action==='select'){ toggleHints(); return; }
    return;
  }

  if(m==='title'){
    if(action==='confirm'||action==='pause'){if(hasRunSave())continueRun();else requestNewRun(false);return;}
    if(action==='secondary'){requestNewRun(true);return;}
    if(action==='select'){requestNewRun(false);return;}
    return;
  }

  if(m==='victory'){
    if(action==='confirm'||action==='pause'||action==='select'||action==='secondary'){ startGame(); }
    return;
  }

  if(action==='pause'&&(m==='dun'||m==='cmb'||m==='treasure'||m==='shop')){ openPause(); return; }

  if(m==='cmb'){
    if(S._combatDone){
      if(action==='confirm'||action==='select'||action==='cancel'||action==='pause'){
        if(S._combatReturn)S._combatReturn();
      }
      return;
    }
    if(S.processing||!S.playerTurn){
      if(action==='cancel') clearCombatSelection();
      return;
    }
    if(action==='left'){
      S.pokerCursor=Math.max(0,(S.pokerCursor||0)-1);SFX.cursor();renderPokerBoard();return;
    }
    if(action==='right'){
      S.pokerCursor=Math.min(S.pokerHand.length-1,(S.pokerCursor||0)+1);SFX.cursor();renderPokerBoard();return;
    }
    if(action==='tricks'){toggleTrickMenu();return;}
    if(action==='select'){ pokerToggleCard(S.pokerCursor||0); return; }
    if(action==='confirm'){
      if((S.pokerSelected||[]).length>0) pokerPlay();
      else pokerToggleCard(S.pokerCursor||0);
      return;
    }
    if(action==='secondary'){ pokerRedraw(); return; }
    if(action==='cancel'){ clearCombatSelection(); return; }
    return;
  }

  if(m==='dun'){
    if(action==='up'){ moveNorth(); return; }
    if(action==='right'){ moveEast(); return; }
    if(action==='down'){ moveSouth(); return; }
    if(action==='left'){ moveWest(); return; }
    if(action==='confirm'||action==='select'||action==='secondary'){ operateFacingDoor(); return; }
    if(action==='cancel'){ openPause(); return; }
    return;
  }

  if(m==='treasure'){
    if(action==='cancel'){ endTreasure(false); return; }
    if(S.tproc) return;
    if(action==='up'){ moveTreasureCursor(-1,0); return; }
    if(action==='down'){ moveTreasureCursor(1,0); return; }
    if(action==='left'){ moveTreasureCursor(0,-1); return; }
    if(action==='right'){ moveTreasureCursor(0,1); return; }
    if(action==='confirm'||action==='select'){
      const bc=S.tc||{r:0,c:0};
      onTrsTile(bc.r,bc.c);
      return;
    }
    return;
  }

  if(m==='shop'){
    if(action==='cancel'){ closeShop(); return; }
    if(action==='secondary'){ openShop(true); SFX.shop(); return; }
    if(action==='up'){
      S.shopIdx=Math.max(0,(S.shopIdx||0)-1); SFX.cursor(); openShop(); return;
    }
    if(action==='down'){
      clampShopIndex();
      S.shopIdx=Math.min(((S.shopItems||SHOP_ITEMS).length||1)-1,(S.shopIdx||0)+1); SFX.cursor(); openShop(); return;
    }
    if(action==='confirm'){ buyItem(S.shopIdx||0); return; }
  }
}
function pollGamepad(){
  const pads=(navigator.getGamepads&&navigator.getGamepads())||[];
  const gp=pads[0];
  if(!gp){
    PAD_STATE.prev={};
    PAD_STATE.repeatAt={};
    requestAnimationFrame(pollGamepad);
    return;
  }
  const dead=PAD_CFG.dead;
  const now=performance.now();
  const state={
    up:(gp.axes[1]!==undefined&&gp.axes[1]<-dead)||!!(gp.buttons[12]&&gp.buttons[12].pressed),
    down:(gp.axes[1]!==undefined&&gp.axes[1]>dead)||!!(gp.buttons[13]&&gp.buttons[13].pressed),
    left:(gp.axes[0]!==undefined&&gp.axes[0]<-dead)||!!(gp.buttons[14]&&gp.buttons[14].pressed),
    right:(gp.axes[0]!==undefined&&gp.axes[0]>dead)||!!(gp.buttons[15]&&gp.buttons[15].pressed),
    confirm:!!(gp.buttons[0]&&gp.buttons[0].pressed),
    cancel:!!(gp.buttons[1]&&gp.buttons[1].pressed),
    select:!!(gp.buttons[2]&&gp.buttons[2].pressed),
    secondary:!!(gp.buttons[3]&&gp.buttons[3].pressed),
    tricks:!!(gp.buttons[4]&&gp.buttons[4].pressed),
    pause:!!(gp.buttons[9]&&gp.buttons[9].pressed),
  };

  for(const action of ['confirm','cancel','select','secondary','pause','tricks']){
    const was=!!PAD_STATE.prev[action];
    const isDown=!!state[action];
    if(isDown&&!was) handlePadAction(action);
  }

  for(const action of ['up','down','left','right']){
    const was=!!PAD_STATE.prev[action];
    const isDown=!!state[action];
    if(isDown&&!was){
      handlePadAction(action);
      PAD_STATE.repeatAt[action]=now+PAD_CFG.firstRepeat;
    }else if(isDown&&now>=(PAD_STATE.repeatAt[action]||0)){
      handlePadAction(action);
      PAD_STATE.repeatAt[action]=now+PAD_CFG.nextRepeat;
    }else if(!isDown&&was){
      delete PAD_STATE.repeatAt[action];
    }
  }

  PAD_STATE.prev=state;
  requestAnimationFrame(pollGamepad);
}
requestAnimationFrame(pollGamepad);


/* cleanup removed legacy/overridden block */


/* ═══════════════════════════════════════
   MOBILE TOUCH
═══════════════════════════════════════ */
let _touchStartTile=null;
function _tilePos(el){
  const board=el.closest('#trs-board');
  if(!board)return null;
  const cells=Array.from(board.children);
  const idx=cells.indexOf(el);
  if(idx<0)return null;
  return{r:Math.floor(idx/BS),c:idx%BS,isTrs:true};
}
document.addEventListener('touchstart',e=>{
  const t=e.target;if(!t.classList.contains('bt'))return;
  const pos=_tilePos(t);if(!pos)return;
  _touchStartTile=pos;
  S.tc={r:pos.r,c:pos.c};
  renderTrsBoard();
},{passive:true});
document.addEventListener('touchend',e=>{
  const t=document.elementFromPoint(e.changedTouches[0].clientX,e.changedTouches[0].clientY);
  if(!t||!t.classList.contains('bt')){_touchStartTile=null;return;}
  const end=_tilePos(t);if(!end||!_touchStartTile){_touchStartTile=null;return;}
  const start=_touchStartTile;_touchStartTile=null;
  S.tc={r:end.r,c:end.c};
  renderTrsBoard();
  if(start.r===end.r&&start.c===end.c)onTrsTile(end.r,end.c);
},{passive:true});

document.addEventListener('click',e=>{
  if(S.mode!=='treasure') return;
  const tile=e.target.closest('#trs-board .bt');
  if(!tile) return;
  const pos=_tilePos(tile);
  if(!pos) return;
  e.preventDefault();
  S.tc={r:pos.r,c:pos.c};
  renderTrsBoard();
  onTrsTile(pos.r,pos.c);
});

// Touch controls for dungeon movement
const _viewCanvas=document.getElementById('view-canvas');
_viewCanvas.addEventListener('touchend',e=>{
  if(S.mode!=='dun')return;
  const touch=e.changedTouches[0];
  const rect=_viewCanvas.getBoundingClientRect();
  const rx=touch.clientX-(rect.left+rect.width/2);
  const ry=touch.clientY-(rect.top+rect.height/2);
  if(Math.abs(rx)>Math.abs(ry)){
    if(rx>=0)moveEast(); else moveWest();
  }else{
    if(ry>=0)moveSouth(); else moveNorth();
  }
},{passive:true});

/* ═══════════════════════════════════════
   HIGH SCORE
═══════════════════════════════════════ */
function loadScores(){try{return JSON.parse(localStorage.getItem('adv2_scores')||'[]');}catch(e){return[];}}
function saveScore(entry){
  try{
    const scores=loadScores();scores.push(entry);
    scores.sort((a,b)=>b.floor-a.floor||b.kills-a.kills||b.gold-a.gold);
    localStorage.setItem('adv2_scores',JSON.stringify(scores.slice(0,5)));
  }catch(e){}
}
function retireRun(){
  S.runEnded=true;clearRunSave();
  finalizeRunLog('retired',{slainBy:'retired'});
  try{saveScore({floor:S.floor,level:S.p.level,kills:S.totalKills,gold:S.p.gold,slainBy:'RETIRED'});}catch(e){}
  stopMusic(false);
  const dm=ge('death-msg');
  if(dm){dm.style.display='block';
    dm.innerHTML=`<div style="color:var(--am);font-size:16px;letter-spacing:2px;margin-bottom:4px">⌁ YOU RETIRED ⌁</div><div style="color:var(--dg);margin-top:2px">Floor ${S.floor} · Level ${S.p.level} · ${S.totalKills} kills · ${S.p.gold}G</div>`;}
  setTitleState(true);
  S.mode='title';showScr('title');renderScores();
  setTimeout(()=>setMusic('dun'),600);
}
function renderScores(){
  const scores=loadScores();const el=ge('score-table');if(!el)return;
  if(!scores.length){el.innerHTML='<div style="color:var(--dg);text-align:center;">No runs yet.</div>';return;}
  el.innerHTML='<div style="color:var(--dg);font-size:12px;letter-spacing:2px;margin-bottom:8px;text-align:center;">── HALL OF THE FALLEN ──</div>'+
    scores.map((s,i)=>`<div style="display:flex;justify-content:space-between;gap:12px;align-items:baseline;font-size:14px;line-height:1.9;color:${i===0?'var(--am)':'var(--dg)'};border-bottom:${i===scores.length-1?'none':'1px solid rgba(58,46,30,.55)'};padding:3px 0;"><span>${i===0?'☠ ':'· '}FL${s.floor} LV${s.level} · ${s.kills} KILLS · ${s.gold}G</span><span style="color:#54452f;text-align:right;white-space:nowrap;">${s.slainBy||'?'}</span></div>`).join('');
}

/* ═══════════════════════════════════════
   INIT & START
═══════════════════════════════════════ */
S=fresh();
initTextures();
const ge=id=>document.getElementById(id);
const sl=ms=>new Promise(r=>setTimeout(r,ms));
window.addEventListener('DOMContentLoaded',()=>{setTitleState(false);renderScores();});

function startGame(endless=false){
  requestSave();
  clearRunSave();
  ge('shop-overlay').classList.remove('on');ge('pause-overlay').style.display='none';
  S=fresh();S.endless=!!endless;S.mode='dun';
  S.runId=Date.now();
  initRunLog();
  const el=ge('death-msg');if(el)el.style.display='none';
  setTitleState(false);
  applyFloorTheme();
  const{grid,rooms,doors,torches}=genFloor(1,S.endless);
  S.map={grid,rooms,torches,torchSet:new Set((torches||[]).map(t=>`${t.x},${t.y}`)), torchMap:new Map((torches||[]).map(t=>[`${t.x},${t.y}`,t]))};S.doors = doors;S.enemies=placeEnemies(rooms,1);
  S.seen=Array.from({length:MH},()=>Array(MW).fill(false));
  S.p.x=rooms[0].cx;S.p.y=rooms[0].cy;
  S.facing=2;
  ge('log-inner').innerHTML='';
  showScr('dun');
  applyFloorTheme();
  updateSeen();renderView();updateDUI();
  setMusic('dun');
  log(S.endless?'ENDLESS DESCENT. No king. No glory.':'The dungeon breathes. Death waits.','e');
  log('MOVE: WASD / ARROWS / PAD','n');
  log('ENTER / SPACE / F OR PAD A/X: DOOR · P/START: PAUSE · SHIFT+R: RETIRE','n');
}


/* ═══════════════════════════════════════
   POKER COMBAT OVERRIDE
═══════════════════════════════════════ */
const POKER_SUITS={S:'♠',H:'♥',C:'♣',D:'♦'};
const POKER_HAND_BASE={
  HIGH_CARD:4,
  PAIR:10,
  TWO_PAIR:18,
  THREE_KIND:28,
  STRAIGHT:36,
  FLUSH:38,
  FULL_HOUSE:52,
  FOUR_KIND:70,
  STRAIGHT_FLUSH:95,
};
const POKER_HAND_LABEL={
  HIGH_CARD:'HIGH CARD',
  PAIR:'PAIR',
  TWO_PAIR:'TWO PAIR',
  THREE_KIND:'THREE OF A KIND',
  STRAIGHT:'STRAIGHT',
  FLUSH:'FLUSH',
  FULL_HOUSE:'FULL HOUSE',
  FOUR_KIND:'FOUR OF A KIND',
  STRAIGHT_FLUSH:'STRAIGHT FLUSH',
};
function pokerRankLabel(rank){
  if(rank===14)return 'A';
  if(rank===13)return 'K';
  if(rank===12)return 'Q';
  if(rank===11)return 'J';
  return String(rank);
}
function pokerCardText(card){return `${pokerRankLabel(card.rank)}${POKER_SUITS[card.suit]}`;}
function pokerMakeDeck(){
  const deck=[];
  for(const suit of ['S','H','C','D'])for(let rank=2;rank<=14;rank++)deck.push({rank,suit});
  return deck;
}
function pokerShuffle(arr){
  const a=arr.slice();
  for(let i=a.length-1;i>0;i--){
    const j=Math.floor(Math.random()*(i+1));
    [a[i],a[j]]=[a[j],a[i]];
  }
  return a;
}
function pokerEnsureDeck(n=1){
  if(!S.pokerDeck)S.pokerDeck=[];
  while(S.pokerDeck.length<n)S.pokerDeck=S.pokerDeck.concat(pokerShuffle(pokerMakeDeck()));
}
function pokerDraw(n){
  pokerEnsureDeck(n);
  return S.pokerDeck.splice(0,n);
}
function pokerBaseHandSize(){
  return hasArtifact('phantomDraw')?9:8;
}
function pokerSetupTurn(){
  S.pokerTurn=(S.pokerTurn||0)+1;
  S.combatStats.turnsPlayed++;
  S.pokerDeck=pokerShuffle(pokerMakeDeck());
  S.tempHandMod=0;
  S.tempHandReason='';
  const handSize=pokerBaseHandSize();
  S.pokerHand=pokerDraw(handSize);
  const eRuleSetup=ENEMY_POKER_RULES[S.enemy?S.enemy.def.name:''];
  if(eRuleSetup&&eRuleSetup.apply&&S.pokerTurn>1){
    eRuleSetup.apply(S);
    if(S.tempHandMod<0&&S.tempHandReason){
      clog('⚠ '+S.tempHandReason+' (-1 card this turn only)','atk');
    }else{
      clog('⚠ '+S.enemy.def.name+' '+eRuleSetup.desc,'atk');
    }
  }
  // Lich curse on first turn
  if(eRuleSetup&&eRuleSetup.rule==='curse'&&S.pokerTurn===1){eRuleSetup.apply(S);clog('⚠ '+S.enemy.def.name+' '+eRuleSetup.desc,'atk');}
  // Blood Ante: lose HP each turn
  if(hasArtifact('bloodAnte')&&S.pokerTurn>1){S.p.hp=Math.max(1,S.p.hp-5);clog('🩸 Blood Ante: -5 HP','atk');updateCUI();}
  // Combo streak bonus announcement
  if(S.combatStats.suitStreak.count>=2&&hasArtifact('comboKing')){clog('⚡ Combo streak: '+S.combatStats.suitStreak.count+'x '+POKER_SUITS[S.combatStats.suitStreak.suit],'skl');}
  S.pokerSelected=[];
  S.pokerCursor=0;
  S.trickUsed=false;S.trickMenu=false;
  S.pokerUsedRedrawThisTurn=false;
  S.pokerCanStandPat=(S.pokerRedraws||0)>0;
  logDealtHand();
  requestSave();
  renderPokerBoard();
  updateCUI();
  pokerUpdateSummary();
}

function hasArtifact(effectId){return (S.artifacts||[]).some(a=>a.effect===effectId);}
function grantArtifact(art){
  if(!S.artifacts)S.artifacts=[];
  if(S.artifacts.some(a=>a.id===art.id))return false;
  S.artifacts.push(art);
  log('🃏 ARTIFACT: '+art.name+' — '+art.desc,'l');
  return true;
}

function pokerCountSuits(cards){
  const suits={S:0,H:0,C:0,D:0};
  cards.forEach(card=>suits[card.suit]++);
  return suits;
}
function pokerEvaluate(cards){
  const len=cards.length;
  const ranks=cards.map(c=>c.rank).sort((a,b)=>a-b);
  const counts={};
  ranks.forEach(r=>counts[r]=(counts[r]||0)+1);
  const freq=Object.values(counts).sort((a,b)=>b-a);
  const uniq=Object.keys(counts).map(Number).sort((a,b)=>a-b);
  let flush=false,straight=false,aceLow=false;
  if(len===5){
    flush=cards.every(c=>c.suit===cards[0].suit);
    if(uniq.length===5){
      if(uniq[4]-uniq[0]===4)straight=true;
      else if(JSON.stringify(uniq)==='[2,3,4,5,14]'){straight=true;aceLow=true;}
    }
  }
  let code='HIGH_CARD';
  if(len===5 && straight && flush)code='STRAIGHT_FLUSH';
  else if(freq[0]>=4)code='FOUR_KIND';
  else if(freq[0]===3 && freq[1]===2)code='FULL_HOUSE';
  else if(len===5 && flush)code='FLUSH';
  else if(len===5 && straight)code='STRAIGHT';
  else if(freq[0]===3)code='THREE_KIND';
  else if(freq[0]===2 && freq[1]===2)code='TWO_PAIR';
  else if(freq[0]===2)code='PAIR';

  const highRank=ranks.length?ranks[ranks.length-1]:0;
  const highLabel=highRank?`${pokerRankLabel(highRank)} HIGH`:'HIGH CARD';
  const junkMultiHigh=(code==='HIGH_CARD' && len>=2);
  const label=(code==='HIGH_CARD') ? highLabel : POKER_HAND_LABEL[code];
  return {code,label,flush,straight,aceLow,ranks,counts,highRank,junkMultiHigh};
}

function pokerEffectiveCards(cards,evald){
  evald=evald||pokerEvaluate(cards);
  const byRank={};
  cards.forEach(c=>{(byRank[c.rank]||(byRank[c.rank]=[])).push(c);});
  const ranksDesc=Object.keys(byRank).map(Number).sort((a,b)=>b-a);
  if(evald.code==='HIGH_CARD'){
    if(!cards.length)return [];
    const best=cards.slice().sort((a,b)=>b.rank-a.rank)[0];
    return [best];
  }
  if(evald.code==='PAIR'){
    const pairRank=ranksDesc.find(r=>byRank[r].length>=2);
    return pairRank?byRank[pairRank].slice(0,2):cards.slice();
  }
  if(evald.code==='THREE_KIND'){
    const tripRank=ranksDesc.find(r=>byRank[r].length>=3);
    return tripRank?byRank[tripRank].slice(0,3):cards.slice();
  }
  if(evald.code==='TWO_PAIR'){
    const pairRanks=ranksDesc.filter(r=>byRank[r].length>=2).slice(0,2);
    return pairRanks.length===2?[...byRank[pairRanks[0]].slice(0,2),...byRank[pairRanks[1]].slice(0,2)]:cards.slice();
  }
  if(evald.code==='FOUR_KIND'){
    const quadRank=ranksDesc.find(r=>byRank[r].length>=4);
    return quadRank?byRank[quadRank].slice(0,4):cards.slice();
  }
  return cards.slice();
}

function pokerStandPatEligible(){
  return !!(S.playerTurn && S.pokerCanStandPat && !S.pokerUsedRedrawThisTurn && !S.trickUsed);
}

function pokerOutcome(cards){
  const evald=pokerEvaluate(cards);
  const effectiveCards=pokerEffectiveCards(cards,evald);
  const effectiveEvald=(effectiveCards.length===cards.length)?evald:pokerEvaluate(effectiveCards);
  const suits=pokerCountSuits(effectiveCards);
  const sumRanks=effectiveCards.reduce((t,c)=>t+c.rank,0);
  const p=S.p,e=S.enemy;
  const base=POKER_HAND_BASE[effectiveEvald.code]||4;
  let raw=(base + Math.floor(sumRanks/2) + Math.floor(p.atk*1.2) + suits.S*4);
  // Artifact: single card boost
  if(effectiveCards.length===1&&hasArtifact('singleBoost'))raw=Math.floor(raw*1.5);
  else if(effectiveCards.length===1)raw=Math.floor(raw*0.72);
  if(effectiveCards.length===2 && effectiveEvald.code==='HIGH_CARD')raw=Math.floor(raw*0.82);
  // Artifact: ace double
  if(hasArtifact('aceDouble')){const aces=effectiveCards.filter(c=>c.rank===14).length;if(aces>0)raw=Math.floor(raw*(1+aces*0.5));}
  // Artifact: face card bonus
  if(hasArtifact('faceBonus')){const faces=effectiveCards.filter(c=>c.rank>=11&&c.rank<=13).length;if(faces>0)raw=Math.floor(raw*(1+faces*0.15));}
  // Artifact: flush bonus
  if(hasArtifact('flushBonus')&&effectiveEvald.flush)raw=Math.floor(raw*1.3);
  // Artifact: combo king streak bonus
  if(hasArtifact('comboKing')&&S.combatStats.suitStreak.count>=2){raw=Math.floor(raw*(1+S.combatStats.suitStreak.count*0.15));}
  // Enemy: King halves damage unless 4+ cards
  const eRuleDmg=ENEMY_POKER_RULES[S.enemy?S.enemy.def.name:''];
  if(eRuleDmg&&eRuleDmg.minCards&&effectiveCards.length<eRuleDmg.minCards)raw=Math.floor(raw*0.5);
  raw=Math.floor(raw*S.atkBuff);
  const reduction=e?Math.min(0.65,(e.edef||0)/45):0;
  const damage=Math.max(1,Math.floor(raw*(1-reduction)));
  let shield=suits.H*3 + (effectiveEvald.flush?2:0) + (effectiveEvald.code==='FULL_HOUSE'?4:0);
  // Artifact: pair shield
  if(hasArtifact('pairShield')&&(effectiveEvald.code==='PAIR'||effectiveEvald.code==='TWO_PAIR'||effectiveEvald.code==='FULL_HOUSE'))shield+=5;
  let heal=suits.H>=3 ? suits.H*2 + (effectiveEvald.code==='FLUSH'||effectiveEvald.code==='STRAIGHT_FLUSH'?3:0) : 0;
  // Artifact: lucky 7 heal
  if(hasArtifact('lucky7')){const sevens=effectiveCards.filter(c=>c.rank===7).length;heal+=sevens*7;}
  // Vault heart double
  if(S.vaultHeartDouble&&suits.H>0){heal+=suits.H*2;shield+=suits.H*2;}
  let mp=suits.D*3 + (effectiveEvald.code==='STRAIGHT'?2:0);
  let gold=suits.C>=3 ? 4+suits.C : 0;
  let pierce=(effectiveEvald.code==='STRAIGHT_FLUSH')?8:(effectiveEvald.code==='STRAIGHT'?4:0);
  let buff=(suits.C>=3)?0.15:0;
  let stun=(effectiveEvald.code==='FULL_HOUSE' || suits.C >= (hasArtifact('clubStun2')?2:3))?1:0;
  let dodge=(effectiveEvald.code==='FLUSH' || (effectiveCards.length===5&&effectiveCards.every(c=>c.suit===effectiveCards[0].suit)))?1:0;
  // Artifact: heartburn
  let heartburn=0;
  if(hasArtifact('heartburn')){const hearts=effectiveCards.filter(c=>c.suit==='H').length;if(hearts>0){heartburn=hearts*2;}}
  // Stand Pat bonus if no redraw used this turn
  const standPat = pokerStandPatEligible();
  let finalDamage=damage, finalShield=shield, finalHeal=heal;
  if(standPat){
    finalDamage=Math.max(1,Math.floor(finalDamage*1.10));
    finalShield=Math.floor(finalShield*1.10);
    finalHeal=Math.floor(finalHeal*1.10);
    pierce=Math.floor(pierce*1.10);
    heartburn=Math.floor(heartburn*1.10);
    mp+=1;
  }
  return {evald:effectiveEvald,suits,sumRanks,base,damage:finalDamage,shield:finalShield,heal:finalHeal,mp,gold,pierce,buff,stun,dodge,heartburn,standPat,effectiveCards};
}

function pokerUpdateSummary(){
  const el=ge('c-cbo');
  const preview=ge('hand-preview');
  const setTexts=(bottom)=>{ if(el) el.textContent=''; if(preview) preview.textContent=bottom; };
  if(S._combatDone){const reward=S.completedBattle;setTexts(reward?`Victory · +${reward.xp} XP · +${reward.gold} gold`:'Victory');return;}
  if(!S.playerTurn){setTexts('ENEMY TURN…');return;}
  const sel=(S.pokerSelected||[]).slice().sort((a,b)=>a-b);
  if(!sel.length){
    setTexts('Select 1–5 cards');
    return;
  }
  const cards=sel.map(i=>S.pokerHand[i]).filter(Boolean);
  if(!cards.length){setTexts('SELECT 1–5 CARDS TO PREVIEW YOUR HAND');return;}
  const out=pokerOutcome(cards);
  const bits=[out.evald.label,`${out.damage} DMG`];
  if(out.heartburn)bits.push(`${out.heartburn} HEARTBURN`);
  if(out.gold)bits.push(`+${out.gold} GOLD`);
  if(out.buff)bits.push(`+${Math.round(out.buff*100)}% ATK`);
  const enemyRule=ENEMY_POKER_RULES[S.enemy?S.enemy.def.name:''];
  if(enemyRule&&enemyRule.heartDrain&&out.suits.H)bits.push(`VAMPIRE HEALS ${out.suits.H*4}`);
  if(enemyRule&&enemyRule.petrifyOnWeak&&['HIGH_CARD','PAIR'].includes(out.evald.code))bits.push('WARNING: YOU WILL BE STUNNED');
  if(out.pierce)bits.push(`${out.pierce} PIERCE`);
  if(out.shield)bits.push(`${out.shield} GUARD`);
  if(out.heal)bits.push(`${out.heal} HEAL`);
  if(out.mp)bits.push(`${out.mp} MP`);
  if(out.standPat)bits.push('STAND PAT');
  if(out.stun)bits.push('STUN');
  if(out.dodge)bits.push('DODGE');
  const eff=(out.effectiveCards||cards);
  setTexts(`PLAYING ${eff.length}: ${bits.join(' • ')}`);
}
function pokerToggleCard(i){
  if(S.mode!=='cmb' || !S.playerTurn || S.processing || S.paused || S.trickMenu)return;
  if(!S.pokerHand || !S.pokerHand[i])return;
  S.pokerCursor=i;
  const sel=S.pokerSelected||[];
  const at=sel.indexOf(i);
  if(at>=0){sel.splice(at,1);SFX.desel();}
  else{
    if(sel.length>=5){clog('You can select up to 5 cards.','def');return;}
    sel.push(i);sel.sort((a,b)=>a-b);SFX.sel();
  }
  S.pokerSelected=sel;
  renderPokerBoard();
  pokerUpdateSummary();
}
function pokerRedraw(){
  requestSave();
  if(S.mode!=='cmb' || !S.playerTurn || S.processing || S.paused || S.trickMenu)return;
  const sel=(S.pokerSelected||[]).slice().sort((a,b)=>a-b);
  if(!sel.length){clog('Select up to 3 cards to redraw.','def');return;}
  if((S.pokerRedraws||0)<=0){clog('No redraws left this battle.','def');return;}
  if(sel.length>3){clog('You may redraw at most 3 cards.','def');return;}
  const handBefore=(S.pokerHand||[]).map(c=>c?{rank:c.rank,suit:c.suit}:null);
  const fresh=pokerDraw(sel.length);
  sel.forEach((idx,n)=>{S.pokerHand[idx]=fresh[n];});
  S.pokerRedraws--;
  S.pokerUsedRedrawThisTurn=true;
  S.pokerSelected=[];
  SFX.cursor();
  logRedraw(handBefore,sel,S.pokerHand||[]);
  clog(`Redrew ${sel.length} card${sel.length===1?'':'s'}.`,'def');
  renderPokerBoard();
  pokerUpdateSummary();
}
function pokerApplyOutcome(cards,out){
  const p=S.p,e=S.enemy;if(!e)return;
  combatPulse('board','play-pulse',220);
  const cardTxt=(out.effectiveCards&&out.effectiveCards.length!==cards.length?`${cards.map(pokerCardText).join(' ')} ⇒ ${out.effectiveCards.map(pokerCardText).join(' ')}`:cards.map(pokerCardText).join(' '));
  let totalDamage=out.damage;
  e.hp=Math.max(0,e.hp-out.damage);
  clog(`🂡 ${out.evald.label}: ${cardTxt}`,'c');
  clog(`♠ ${out.damage} damage` + (e.edef?` (${e.edef} def)`:'') ,'atk');
  if(out.pierce){
    e.hp=Math.max(0,e.hp-out.pierce);
    totalDamage+=out.pierce;
    clog(`♦ ${out.pierce} pierce damage`,'mag');
  }
  if(out.shield){S.shield+=out.shield;clog(`♥ +${out.shield} guard`,'def');}
  if(out.heal){p.hp=Math.min(p.maxHp,p.hp+out.heal);SFX.heal();clog(`♥ +${out.heal} HP`,'hlt');}
  if(out.mp){p.mp=Math.min(p.maxMp,p.mp+out.mp);clog(`♦ +${out.mp} MP`,'mag');}
  if(out.gold){p.gold+=out.gold;clog(`♦ +${out.gold} gold`,'win');}
  if(out.buff){S.atkBuff=Math.min(2.5, +(S.atkBuff+out.buff).toFixed(2));clog(`♣ ATK×${S.atkBuff.toFixed(2)}`,'skl');}
  if(out.stun){S.estatus.stun=Math.max(S.estatus.stun||0,1);clog('♣ Enemy stunned!','skl');}
  if(out.dodge){S.dodgeNext=true;clog('♣ Dodge primed!','skl');}
  if(out.evald.code==='FOUR_KIND'){S.estatus.burn=(S.estatus.burn||0)+2;clog('🔥 Quads ignite the target!','mag');}
  if(out.evald.code==='STRAIGHT_FLUSH'){S.atkBuff=Math.min(2.5, +(S.atkBuff+0.35).toFixed(2));}
  // Heartburn artifact
  if(out.heartburn&&out.heartburn>0){e.hp=Math.max(0,e.hp-out.heartburn);totalDamage+=out.heartburn;S.estatus.burn=(S.estatus.burn||0)+1;clog('🔥 Heartburn: '+out.heartburn+' burn','mag');}
  // Enemy: Basilisk petrify on weak hand
  const eRuleApply=ENEMY_POKER_RULES[e?e.def.name:''];
  if(eRuleApply&&eRuleApply.petrifyOnWeak&&(out.evald.code==='HIGH_CARD'||out.evald.code==='PAIR')){S.pstatus.stunned=1;clog('🪨 Basilisk PETRIFIES you for playing a weak hand!','atk');}
  // Enemy: Vampire heals from hearts
  if(eRuleApply&&eRuleApply.heartDrain&&out.suits.H>0){const vheal=out.suits.H*4;e.hp=Math.min(e.maxHp,e.hp+vheal);clog('🧛 Vampire drains '+vheal+' HP from your Hearts!','atk');}
  if(totalDamage>0){ battleFloat('enemy',totalDamage);combatPulse('e-art','impact-hit',280); }
  if(totalDamage>=50)SFX.kill(); else SFX.bump();
  logPlayerHand(cards,out,totalDamage);
  // Track combat stats
  S.combatStats.totalDmg+=totalDamage;
  if(totalDamage>S.combatStats.bestHandDmg){S.combatStats.bestHandDmg=totalDamage;S.combatStats.bestHand=out.evald.label;}
  // Combo streak tracking
  const dominantSuit=Object.entries(out.suits).sort((a,b)=>b[1]-a[1])[0];
  if(dominantSuit&&dominantSuit[1]>=2){
    if(S.combatStats.suitStreak.suit===dominantSuit[0])S.combatStats.suitStreak.count++;
    else S.combatStats.suitStreak={suit:dominantSuit[0],count:1};
  } else { S.combatStats.suitStreak={suit:null,count:0}; }
}
function pokerPlay(){
  if(S.mode!=='cmb' || !S.playerTurn || S.processing || S.paused || S.trickMenu)return;
  const sel=(S.pokerSelected||[]).slice().sort((a,b)=>a-b);
  if(!sel.length){clog('Select 1–5 cards first.','def');return;}
  // Enemy: max card limit
  const eRulePlay=ENEMY_POKER_RULES[S.enemy?S.enemy.def.name:''];
  if(eRulePlay&&eRulePlay.maxSelect&&sel.length>eRulePlay.maxSelect){clog('⚠ '+S.enemy.def.name+' limits you to '+eRulePlay.maxSelect+' cards!','atk');return;}
  const cards=sel.map(i=>S.pokerHand[i]).filter(Boolean);
  if(!cards.length)return;

  // Resolve while stand-pat eligibility is still available; then lock synchronously.
  const out=pokerOutcome(cards);
  // Lock the turn immediately so the same hand cannot be spammed repeatedly
  // before the enemy turn begins.
  S.processing=true;
  S.playerTurn=false;
  S.pokerSelected=[];

  renderPokerBoard();pokerUpdateSummary();
  const flight=launchPokerCards(cards);
  const resolve=()=>{
  pokerApplyOutcome(cards,out);
  updateCUI();
  renderPokerBoard();
  pokerUpdateSummary();
  checkEnd();

  if(S.enemy&&S.enemy.hp>0&&S.p.hp>0){
    scheduleGame(()=>{
      setTurn(false);
      S.processing=false;
    },250);
  }else if(S.mode==='cmb' && (!S.enemy || S.enemy.hp<=0 || S.p.hp<=0)){
    // Allow end-of-combat handlers to manage input locking when combat ended.
  }else{
    S.processing=false;
  }
  };
  if(flight)scheduleGame(resolve,flight);else resolve();
}
function renderPokerBoard(){
  const board=ge('board');
  if(!board)return;
  if(S.mode!=='cmb'){
    board.innerHTML='';
    return;
  }
  const hand=S.pokerHand||[];
  const selected=new Set(S.pokerSelected||[]);
  const selectedCards=[...selected].map(i=>hand[i]).filter(Boolean);
  const effective=new Set(pokerEffectiveCards(selectedCards));
  const rule=ENEMY_POKER_RULES[S.enemy?S.enemy.def.name:''];
  ge('enemy-rule').textContent=rule&&!S._combatDone?rule.desc:'';
  ge('artifact-info').innerHTML=S.artifacts.length?'<h3>Artifacts</h3>'+S.artifacts.map(a=>`<p><strong>${a.name}</strong> — ${a.desc}</p>`).join(''):'<p>No artifacts collected yet.</p>';
  if(S._combatDone){board.innerHTML='<button class="pk-btn pk-go" onclick="S._combatReturn()">'+(S.bossRewardPending?'CHOOSE ARTIFACT':'CONTINUE')+' · ENTER / A</button>';return;}
  const canAct=S.playerTurn&&!S.processing&&!S.paused;
  const cards=hand.map((card,i)=>{
    const cls=['pk-card',`pk-s-${card.suit}`];
    if(canAct&&!S.trickMenu&&i===(S.pokerCursor||0))cls.push('pk-cur');
    if(selected.has(i)){cls.push('pk-sel');cls.push(effective.has(card)?'pk-scoring':'pk-ignored');}
    return `<div class="${cls.join(' ')}" onclick="pokerToggleCard(${i})" role="button" tabindex="0" aria-pressed="${selected.has(i)}" aria-label="${pokerCardText(card)}${selected.has(i)?(effective.has(card)?', scoring':', not scoring'):''}" title="${pokerCardText(card)}">
      <div class="pk-mini">${pokerRankLabel(card.rank)}${POKER_SUITS[card.suit]}</div>
      <div class="pk-rank">${pokerRankLabel(card.rank)}</div>
      <div class="pk-suit">${POKER_SUITS[card.suit]}</div>
      <div class="pk-mini-b">${pokerRankLabel(card.rank)}${POKER_SUITS[card.suit]}</div>
    </div>`;
  }).join('');
  const handPenaltyNote=(S.tempHandMod<0&&S.tempHandReason)?`<div class="pk-help" style="color:#ff9a9a">⚠ ${S.tempHandReason}. Temporary only.</div>`:'';
  board.innerHTML=`
    <div class="pk-hand">${cards || '<div class="pk-empty">No cards dealt.</div>'}</div>
    ${handPenaltyNote}
    <div class="pk-actions">
      <button class="pk-btn pk-go" onclick="pokerPlay()" title="F / controller A" ${(canAct && selected.size>0 && !S.trickMenu)?'':'disabled'}>PLAY HAND · F</button>
      <button class="pk-btn" onclick="pokerRedraw()" title="R / controller Y · Select up to 3 cards" ${(canAct && selected.size>0 && selected.size<=3 && (S.pokerRedraws||0)>0 && !S.trickMenu)?'':'disabled'}>REDRAW · ${S.pokerRedraws||0}</button>
      <button class="pk-btn" onclick="toggleTrickMenu()" title="T / controller LB" ${(canAct && (!S.trickUsed||S.trickMenu))?'':'disabled'}>${S.trickMenu?'CLOSE TRICKS':'MP TRICKS'}</button>
    </div>
    ${renderTrickControls()}`;
}
function renderBoard(){ return renderPokerBoard(); }

function pokerKey(e){
  if(!S.pokerHand || !S.pokerHand.length)return;
  const k=e.key;
  const lower=(k&&k.length===1)?k.toLowerCase():k;
  if(lower==='t'){e.preventDefault();toggleTrickMenu();return;}
  if(k>='1' && k<='9'){
    e.preventDefault();
    pokerToggleCard(Number(k)-1);
    return;
  }
  if(k==='ArrowLeft'||lower==='a'){
    e.preventDefault();
    S.pokerCursor=Math.max(0,(S.pokerCursor||0)-1);SFX.cursor();renderPokerBoard();return;
  }
  if(k==='ArrowRight'||lower==='d'){
    e.preventDefault();
    S.pokerCursor=Math.min(S.pokerHand.length-1,(S.pokerCursor||0)+1);SFX.cursor();renderPokerBoard();return;
  }
  if(k===' '){
    e.preventDefault();pokerToggleCard(S.pokerCursor||0);return;
  }
  if(k==='Enter'){
    e.preventDefault();
    if(!e.repeat)pokerToggleCard(S.pokerCursor||0);
    return;
  }
  if(lower==='f'){
    e.preventDefault();pokerPlay();return;
  }
  if(lower==='r'){
    e.preventDefault();pokerRedraw();return;
  }
  if(k==='Escape'||lower==='c'||k==='Backspace'||k==='Delete'){
    e.preventDefault();S.pokerSelected=[];renderPokerBoard();pokerUpdateSummary();
  }
}
function boardKey(e,isTrs){
  if(S.mode==='cmb')return pokerKey(e);
  if(S.mode!=='treasure')return;
  const bc=S.tc||{r:0,c:0};
  const k=e.key;
  const lower=(k&&k.length===1)?k.toLowerCase():k;
  const arrow={ArrowUp:[-1,0],ArrowDown:[1,0],ArrowLeft:[0,-1],ArrowRight:[0,1],w:[-1,0],s:[1,0],a:[0,-1],d:[0,1]};
  const dir=arrow[lower]||arrow[k];
  if(dir){
    e.preventDefault();
    const nr=bc.r+dir[0],nc=bc.c+dir[1];
    if(nr>=0&&nr<BS&&nc>=0&&nc<BS){S.tc={r:nr,c:nc};SFX.cursor();renderTrsBoard();}
    return;
  }
  if(k===' '||k==='Enter'){
    e.preventDefault();
    onTrsTile(bc.r,bc.c);
    return;
  }
}

function setTurn(isPlayer){
  S.playerTurn=isPlayer;
  ge('turn-ind').textContent=isPlayer?'YOUR TURN':'ENEMY TURN';
  ge('turn-ind').className=isPlayer?'ti-p':'ti-e';
  if(isPlayer){
    if((S.pstatus.stunned||0)>0){
      S.playerTurn=false;
      S.pstatus.stunned=0;
      ge('turn-ind').textContent='YOU ARE STUNNED';
      renderBoard();
      pokerUpdateSummary();
      scheduleGame(()=>{if(S.enemy&&S.enemy.hp>0&&S.p.hp>0){clog('⚡ You lose the turn!','atk');setTurn(false);}},650);
      return;
    }
    pokerSetupTurn();
  }else{
    scheduleGame(doEnemyTurn,680);
  }
}
function startCombat(mapEn){
  const def=mapEn.def;
  openFightLog(def);
  S.mode='cmb';setMusic('cmb');
  S.enemy={ref:mapEn,def,hp:mapEn.hp,maxHp:def.hp,mp:def.maxMp||0,maxMp:def.maxMp||0,atk:def.atk,edef:Math.floor(def.def*(1+(S.floor-1)*0.12))};
  S.shield=S.vaultShield||0;S.vaultShield=0;
  S.atkBuff=1.0;S.dodgeNext=!!S.pendingDodge;S.pendingDodge=false;S.estatus={};S.pstatus={};
  S.playerTurn=true;S.processing=false;
  S.pokerHand=[];S.pokerDeck=[];S.pokerSelected=[];S.pokerCursor=0;S.pokerTurn=0;S.pokerUsedRedrawThisTurn=false;S.pokerCanStandPat=false;
  // Redraws are restricted to one per enemy by default.
  S.pokerRedraws=1+(hasArtifact('extraRedraw')?1:0)+(S.vaultCombatMod==='extraRedraw'?1:0);
  // Enemy: no redraw rule
  const eRule=ENEMY_POKER_RULES[def.name];
  if(eRule&&eRule.noRedraw)S.pokerRedraws=0;
  // Combat stats reset
  S.combatStats={turnsPlayed:0,totalDmg:0,bestHand:'',bestHandDmg:0,suitStreak:{suit:null,count:0}};
  // Blood Ante artifact: buff
  if(hasArtifact('bloodAnte'))S.atkBuff=1.4;
  // Vault combat mod
  if(S.vaultCombatMod){
    if(S.vaultCombatMod==='heartDouble')S.vaultHeartDouble=true; else S.vaultHeartDouble=false;
    if(S.vaultCombatMod==='atkBoost')S.atkBuff=Math.min(2.5,S.atkBuff+0.3);
    S.vaultCombatMod=null;
  } else { S.vaultHeartDouble=false; }
  applyFloorTheme();
  showScr('cmb');
  ge('c-ename').textContent=def.name+(def.boss?' [BOSS]':'');
  renderCombatSprites();
  ge('c-elv').textContent=Math.max(1,S.floor);
  ge('c-plv').textContent=S.p.level;
  ge('c-eatk').textContent=def.atk;ge('c-edef').textContent=def.def;
  ge('c-log').innerHTML='';
  updateCUI();setIntent();setTurn(true);
  clog(`🂠 ${def.boss?'★BOSS★ ':''}${def.name}`,'c');
  clog('Cards dealt. Select 1–5 cards, then play your hand. Stand pat for +10% hand value and +1 MP.','n');
  // Announce enemy poker rule
  const eRuleAnn=ENEMY_POKER_RULES[def.name];
  if(eRuleAnn){clog('⚠ '+def.name+' '+eRuleAnn.desc,'atk');}
  // Announce active artifacts
  if(S.artifacts.length>0){clog('🃏 Active: '+S.artifacts.map(a=>a.name).join(', '),'mag');}
}



/* ═══════════════════════════════════════
   POKERMON EDITION OVERRIDES
═══════════════════════════════════════ */
(function(){
  const st=document.createElement('style');
  st.textContent=`
  #compass{font-size:14px;letter-spacing:1px;color:#ffd66b;text-shadow:0 0 8px rgba(255,214,107,.45)}
  #trs-board{display:grid;grid-template-columns:repeat(7,54px);grid-template-rows:repeat(7,72px);gap:7px;padding:10px;background:radial-gradient(circle at 50% 18%,rgba(255,214,107,.08),transparent 34%),linear-gradient(180deg,#1a1209,#090604);border-radius:16px;justify-content:center;align-content:center;box-shadow:inset 0 0 18px rgba(0,0,0,.45),0 8px 24px rgba(0,0,0,.28);}
  #trs-board .bt{width:54px;height:72px;border-radius:10px;border:2px solid #5b4021;display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden;font-size:18px;line-height:1;font-family:'VT323',monospace;transition:transform .12s ease, box-shadow .12s ease, outline-color .12s ease;}
  #trs-board .bt:hover{transform:translateY(-2px);box-shadow:0 8px 18px rgba(0,0,0,.38);}
  #trs-board .bt.vault-back{background:radial-gradient(circle at 50% 22%,rgba(255,255,255,.08),transparent 26%),linear-gradient(180deg,#2a1d45,#120914);color:#e7c67a;box-shadow:inset 0 0 0 2px rgba(255,255,255,.06), inset 0 0 22px rgba(0,0,0,.4);}
  #trs-board .bt.vault-safe{background:linear-gradient(180deg,#f6ecd8,#d7c29a 58%,#c1a77d 100%);color:#22170f;box-shadow:0 3px 10px rgba(0,0,0,.32), inset 0 1px 0 rgba(255,255,255,.48);}
  #trs-board .bt.vault-safe::before{content:'';position:absolute;inset:4px;border:1px solid rgba(88,58,24,.22);border-radius:8px;pointer-events:none;box-shadow:inset 0 1px 0 rgba(255,255,255,.28);}
  #trs-board .bt.vault-alarm{background:radial-gradient(circle at 50% 24%,rgba(255,255,255,.08),transparent 28%),linear-gradient(180deg,#4a1717,#180707);color:#ff9a87;box-shadow:0 3px 10px rgba(0,0,0,.32), inset 0 1px 0 rgba(255,255,255,.12);}
  #trs-board .bt.vault-cur{outline:2px solid #90d7ff;outline-offset:-2px;box-shadow:0 0 0 3px rgba(144,215,255,.16),0 0 18px rgba(93,201,255,.18), inset 0 0 14px rgba(255,255,255,.04);}
  #trs-board .vs-H{color:#8ff0a4}
  #trs-board .vs-D{color:#ffd66b}
  #trs-board .vs-S{color:#ff7d6c}
  #trs-board .vs-C{color:#8ec7ff}
  #trs-board .vk-mini{position:absolute;top:5px;left:7px;font-size:16px;line-height:1;opacity:.98;letter-spacing:.3px;
    text-shadow:0 1px 0 rgba(255,255,255,.16),0 0 1px rgba(42,26,12,.45);}
  #trs-board .vk-mid{font-size:34px;line-height:1;letter-spacing:1px;
    text-shadow:0 1px 0 rgba(255,255,255,.16),0 0 1px rgba(42,26,12,.45);}
  #trs-board .vk-bot{position:absolute;right:7px;bottom:5px;font-size:16px;line-height:1;opacity:.98;transform:rotate(180deg);
    text-shadow:0 1px 0 rgba(255,255,255,.16),0 0 1px rgba(42,26,12,.45);}
  `;
  document.head.appendChild(st);

  document.title='@venturerer III: A Poker Monster Edition';
  if(ge('hdr')) ge('hdr').textContent='⚔  @venturerer III: A Poker Monster Edition  ⚔';
  const titleSub=document.querySelector('#s-title div[style*="font-size:28px"]');
  if(titleSub) titleSub.textContent='@venturerer III: A Poker Monster Edition';
  const titleBlink=document.querySelector('#s-title .blink');
  if(titleBlink) titleBlink.textContent=hasRunSave()?'ENTER / A = CONTINUE  ·  N / X = NEW RUN':'ENTER / A = BEGIN  ·  F / Y = ENDLESS';
  const statHdr=document.querySelector('#stat-col .phdr');
  if(statHdr) statHdr.textContent='POKERMON DUNGEON';
  const ctrl=document.querySelector('#stat-col div[style*="line-height:1.8"]');
  if(ctrl){ctrl.classList.add('explore-help');ctrl.innerHTML='<p>WASD / Arrows · Move</p><p>Enter / F / Space · Interact</p><p>P · Pause & save</p><p>Shift+R · Retire</p><p>Pad: stick move · A/X interact · Start pause</p>'; }
  const compass=ge('compass');
  if(compass) compass.textContent='POKERMON';
  const info=ge('trs-info');
  if(info){
    info.innerHTML=`
      <div class="phdr">VAULT RUN</div>
      <div class="sl"><span class="sk">ALARMS</span><span class="sv-g" id="trs-turns">0 / 3</span></div>
      <div class="sl"><span class="sk">PENDING GOLD</span><span class="sv-g" id="trs-gold">0</span></div>
      <div class="sl"><span class="sk">PENDING HEAL</span><span class="sv-hp" id="trs-hp">0</span></div>
      <div class="sl"><span class="sk">PENDING SHIELD</span><span class="sv" id="trs-shield">0</span></div>
      <div class="sl"><span class="sk">PENDING MP</span><span class="sv-mp" id="trs-mp">0</span></div>
      <hr style="border-color:var(--bdr);margin:5px 0">
      <div style="color:var(--dg);font-size:11px;line-height:1.75">
        <span style="color:#ffd66b">♦</span> BANK GOLD<br>
        <span style="color:#8ff0a4">♥</span> CASH OUT HEALING<br>
        <span style="color:#ff7d6c">♠</span> CASH OUT SHIELD<br>
        <span style="color:#8ec7ff">♣</span> CASH OUT MP<br>
        <span style="color:#ff8a7a">!</span> 3 ALARMS = BUST
      </div>
      <div style="margin-top:auto;padding-top:6px;color:var(--cy);font-size:12px;text-align:center;letter-spacing:1px;">CLICK / ENTER / A FLIP · ESC / Q / B BANK &amp; LEAVE</div><button id="vault-cashout" class="pk-btn" onclick="if(!S.paused)endTreasure(false)">BANK &amp; LEAVE</button>`;
  }
  const bwrap=ge('trs-bwrap');
  if(bwrap){
    bwrap.innerHTML=`
      <div style="display:flex;justify-content:space-between;align-items:baseline;margin-bottom:3px;flex-shrink:0;">
        <div class="phdr" style="margin:0;border:none;">PUSH YOUR LUCK</div>
        <span id="trs-cbo" style="color:var(--am);font-size:16px;font-family:'VT323',monospace;">x1.00</span>
      </div>
      <div style="font-size:11px;color:var(--dg);margin-bottom:6px;flex-shrink:0;text-align:center;line-height:1.5;">
        Matching suit streaks raise the multiplier. Face cards sweeten the stash. Aces spike it harder.
      </div>
      <div id="trs-board"></div>`;
  }
})();

function heroSpriteKey(){
  return ['hero_n','hero_e','hero_s','hero_w'][S.facing] || 'hero_s';
}
function heroSpriteReady(){
  const key=heroSpriteKey();
  const img=SPRITE_IMGS[key];
  return !!(img && img.complete && img.naturalWidth>1 && img.naturalHeight>1);
}

const DUNGEON_TILE_B64 = {"FLOOR_A":"data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAABAAAAAQCAYAAAAf8/9hAAAAXklEQVR42mM0UJL4z0ABYGFgYGDwtdNxJ0fzrfvPdrLAGDDBm4/fMajLCjEQy2ek1AtMDBQCFgYGBpKcjM6n2AWjYTAswoAFxjh65TE8Q735+BXFFmx8ax3ZnVQJAwAXPkBb/sSuiQAAAABJRU5ErkJggg==","FLOOR_B":"data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAABAAAAAQCAYAAAAf8/9hAAAAmUlEQVR42mM0UJL4z0ABYGFgYGDwtdNxJ0fzo6evd7LAGDDBi3dfMugrizMQy2ek1AtMDBQCFgYGBgwnxviYRTMwMDBcvv5wKSEvsGAz9fL1h0sZGBgYdDXlo3U15eF8bIC+YcDOxhLNzsYSTTAM0PkwTRqywkuJCgN0oCErPEjCgOh0QHJS1lcWZ9h77h5JGcrZSGknVcIAAJRXSJFDhTQ2AAAAAElFTkSuQmCC","FLOOR_C":"data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAABAAAAAQCAYAAAAf8/9hAAAAoklEQVR42mM0UJL4z0ABYGFgYGDwtdNxJ0fzhRuPdjIaKEn8lxXjgws+fvWJgRQ+I6VeYCJWITsbSyA7G0sg1jAg0snrGRgYGF59+BbIwMDAICbAtR5uACng568/6wcmDPCmA0qiESUM7M00AhkYGBgOnrqxnlgXYA2DGB+zQAYGBoYlW06tJ8uAgQmD87efwzPUm49fUWzBxjdUldxJFS8AAOtAThQ0cUY8AAAAAElFTkSuQmCC","VOID":"data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAABAAAAAQCAYAAAAf8/9hAAAARElEQVR42mOUEJD7z0ABYGFgYGD49eMXWZrZONggBvxl+EuZC1ggFPkGkOsCVgbWAXYBC8zqoRuIo9FIzWjk4uAi2wAAVYwUuzuTeBEAAAAASUVORK5CYII=","WALL_FILL":"data:image/png;base64,","WALL_FACE":"data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAABAAAAAQCAYAAAAf8/9hAAAAUElEQVR42mOcN2fBPgYKAMuNGzccKTGAiYFCQLEBjCYGBv8pCgMpGTnKXKCmpESZCxgYGBg0tHTgAjeuXSGJPwhigeIwkJNX3Dq0U+LAGwAAnvkU0HFZ3aIAAAAASUVORK5CYII=","WALL_CORNER_L":"data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAABAAAAAQCAYAAAAf8/9hAAAAb0lEQVR42mOcN2fBPgYKAMuNGzccKTGAiYFCQLEBjCYGBv8pCgMfv6CF2CTOnTsTT5QLnByc7qALPnn0QJloF2DTrKGlA+ffuHaFAR8fJRB5eHiUyY4FcjTDw4AUP2OEARMj4w05ecUbQzclDrwBACMaICbn82nrAAAAAElFTkSuQmCC","WALL_CORNER_R":"data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAABAAAAAQCAYAAAAf8/9hAAAAcElEQVR42mOcN2fBPgYKAMuNGzccKTGAiYFCQLEBjCYGBv8pCgMpGTmiFBoZmSzE6gI1JSWiXSAjp3AXwwUMDAwMGlo6cIEb167g4yt/+fLlLkWB+OTRA2WKY4GHh0eZrDDAFiYscvKKW4d2Shx4AwCWLBxj54M4EQAAAABJRU5ErkJggg==","DOOR_CLOSED":"data:image/png;base64,","DOOR_OPEN":"data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAABAAAAAQCAYAAAAf8/9hAAAApUlEQVR42mM0UJL4z0ABYGFgYGDwtdNxJ0fzo6evd7LAGDDBi3dfMugrizMQy2ek1AtMDBQCFgYGBgwnxviYRTMwMDBcvv5wKSEvsGAz9fL1h0sZGBgYdDXlo3U15eF8bICRKtEIA5sWJTUTo8kvbl4t1jC4c+tR1I4NZ5TxafYIMLmLNww8AkzukuKFQZoOSE7K+sriDHvP3SMpQzkbKe2kShgAAKxSScJd4/sYAAAAAElFTkSuQmCC"};
const DUNGEON_TILE_IMGS = Object.fromEntries(Object.entries(DUNGEON_TILE_B64).map(([k,src])=>{
  const img=new Image();
  img.src=src;
  return [k,img];
}));
function pokermonRenderTileAt(x,y){
  if(!S.map || !S.map.grid) return ' ';
  if(y<0 || y>=S.map.grid.length || x<0 || x>=S.map.grid[0].length) return ' ';
  return S.map.grid[y][x];
}
function pokermonDungeonRole(wx,wy,ch,door){
  if(ch===' ') return 'VOID';
  if(ch==='+') return (door && door.state==='open') ? 'DOOR_OPEN' : 'DOOR_CLOSED';
  if(ch==='#'){
    const below = pokermonRenderTileAt(wx,wy+1);
    const left  = pokermonRenderTileAt(wx-1,wy);
    const right = pokermonRenderTileAt(wx+1,wy);
    const hasFloorBelow = below!== '#' && below!==' ';
    if(hasFloorBelow && left!=='#') return 'WALL_CORNER_L';
    if(hasFloorBelow && right!=='#') return 'WALL_CORNER_R';
    if(hasFloorBelow) return 'WALL_FACE';
    return 'WALL_FILL';
  }
  const floorPick = Math.abs((wx*31 + wy*17 + wx*wy*7)) % 3;
  return ['FLOOR_A','FLOOR_B','FLOOR_C'][floorPick];
}
function pokermonDrawDungeonRole(ctx,role,x,y,s,wx=0,wy=0){
  if(/^FLOOR_/.test(role)&&drawSlateFloor(ctx,x,y,s,wx,wy))return true;
  const img = DUNGEON_TILE_IMGS[role];
  if(img && img.complete && img.naturalWidth>0){
    ctx.imageSmoothingEnabled=false;
    ctx.drawImage(img, 0, 0, img.naturalWidth, img.naturalHeight, x, y, s, s);
    ctx.imageSmoothingEnabled=true;
    const theme = getFloorTheme();
    if(/^WALL/.test(role)){
      const wallTint = getThemeColor(theme,'topdownWallTint',theme.mapWall,[75,91,113]);
      ctx.save();ctx.globalCompositeOperation='color';ctx.fillStyle='rgb(50,66,90)';ctx.fillRect(x,y,s,s);ctx.restore();
      applyZoneTileTint(ctx,x,y,s,s,wallTint,0.22,0.045);
    }else if(/^FLOOR_/.test(role)){
      const floorTint = getThemeColor(theme,'topdownFloorTint',theme.mapFloor || theme.viewFloor,[70,58,46]);
      applyZoneTileTint(ctx,x,y,s,s,floorTint,0.42,0.08);
    }else if(role==='DOOR_CLOSED'){
      const doorTint = getThemeColor(theme,'topdownDoorTint',theme.accent || theme.mapWall,[150,110,72]);
      applyZoneTileTint(ctx,x,y,s,s,doorTint,0.24,0.05);
    }
    return true;
  }
  return false;
}

function pokermonDrawImgOrSprite(ctx,key,x,y,size){
  const img=SPRITE_IMGS[key];
  const spr=SPRITES[key] || ITEM_SPRITES[key];
  const creatureKeys=new Set(['rats','gob','skel','orc','troll','mage','vamp','warden','dknight','basilisk','lich','king','hero_n','hero_e','hero_s','hero_w']);
  const creature=creatureKeys.has(key);
  const baseZoom = ({
    hero_n:0.88, hero_e:0.88, hero_s:0.88, hero_w:0.88,
    rats:1.00, gob:1.08, skel:1.08, orc:1.10, troll:1.14, mage:1.08,
    vamp:1.10, warden:1.12, dknight:1.12, basilisk:1.10, lich:1.10, king:1.14,
    chest:0.96, stairs:1.72, merchant:1.14, torch:0.62,
  })[key] || 1.0;
  const specialOverride = (!creature && Object.prototype.hasOwnProperty.call(SPRITE_SCALE, key))
    ? SPRITE_SCALE[key]
    : null;
  const zoomScale = specialOverride ?? baseZoom;
  const baseBox = creature ? {w:1.00,h:1.12} : {w:1.00,h:1.00};
  const maxW = size * baseBox.w * zoomScale;
  const maxH = size * baseBox.h * zoomScale;

  const fitBox = (aspect)=>{
    let w=maxW, h=w/aspect;
    if(h>maxH){ h=maxH; w=h*aspect; }
    return {w,h};
  };
  const getDrawPos = (w,h)=>{
    const dx = x + (size-w)/2;
    let dy;
    if(creature) dy = y + size*0.96 - h;
    else if(key==='stairs') dy = y + size - h;
    else if(key==='merchant') dy = y + size*0.98 - h;
    else dy = y + (size-h)/2;
    return {dx,dy};
  };
  const drawCreatureShadow = (w,h,dx,dy)=>{
    if(!creature) return;
    const footY = dy + h - Math.max(1, size*0.02);
    const shadowW = Math.min(size*0.35, w*0.40);
    const shadowH = Math.max(1, size*0.065);
    ctx.fillStyle='rgba(2,3,8,0.36)';
    ctx.beginPath();
    ctx.ellipse(dx + w/2, footY, shadowW, shadowH, 0, 0, Math.PI*2);
    ctx.fill();
  };
  if(img && img.complete && img.naturalWidth){
    const bounds=creature?spriteBounds(img):{x:0,y:0,w:img.width,h:img.height};
    const aspect=bounds.w/bounds.h;
    const {w,h}=fitBox(aspect);
    const {dx,dy}=getDrawPos(w,h);
    drawCreatureShadow(w,h,dx,dy);
    ctx.imageSmoothingEnabled=false;
    ctx.drawImage(img,bounds.x,bounds.y,bounds.w,bounds.h,dx,dy,w,h);
    if(key==='torch'){
      const theme = getFloorTheme();
      const torchTint = getThemeColor(theme,'torchSpriteTint',theme.viewGlowRgb || theme.accent,[255,186,92]);
      applyZoneTileTint(ctx,dx,dy,w,h,torchTint,0.26,0.14);
    }
    return true;
  }
  if(spr){
    const aspect=spr.w/spr.h;
    const {w,h}=fitBox(aspect);
    const {dx,dy}=getDrawPos(w,h);
    drawCreatureShadow(w,h,dx,dy);
    drawPixelSprite(ctx,spr,dx,dy,w,h,1.0);
    if(key==='torch'){
      const theme = getFloorTheme();
      const torchTint = getThemeColor(theme,'torchSpriteTint',theme.viewGlowRgb || theme.accent,[255,186,92]);
      applyZoneTileTint(ctx,dx,dy,w,h,torchTint,0.26,0.14);
    }
    return true;
  }
  return false;
}
function pokermonDrawFloor(ctx,x,y,s,wx,wy){
  return pokermonDrawDungeonRole(ctx, pokermonDungeonRole(wx,wy,'.',null), x,y,s);
}
function pokermonDrawWall(ctx,x,y,s,wx,wy){
  return pokermonDrawDungeonRole(ctx, pokermonDungeonRole(wx,wy,'#',null), x,y,s);
}
function pokermonDrawDoor(ctx,x,y,s,door,wx,wy){
  const openAmt = doorVisualOpen(door);
  if(openAmt <= 0.01){
    return pokermonDrawDungeonRole(ctx, 'DOOR_CLOSED', x, y, s);
  }

  // Start from the closed tile so the frame stays solid, then carve out a dark
  // doorway and leave a visible door leaf tucked against one jamb.
  pokermonDrawDungeonRole(ctx, 'DOOR_CLOSED', x, y, s);

  const floorRole = pokermonDungeonRole(wx,wy,'.',null);
  const floorImg = DUNGEON_TILE_IMGS[floorRole];
  const leafImg = DUNGEON_TILE_IMGS['DOOR_CLOSED'];
  const hingeRight = !(door && door.axis==='ew');

  const frameL = x + s*0.24;
  const frameR = x + s*0.76;
  const top    = y + s*0.18;
  const bottom = y + s*0.86;
  const height = bottom - top;

  const closedW = frameR - frameL;
  const openW   = s * 0.14;
  const leafW   = closedW + (openW - closedW) * openAmt;

  let leafL, leafR, gapL, gapW;
  if(hingeRight){
    leafR = frameR;
    leafL = leafR - leafW;
    gapL = frameL;
    gapW = Math.max(0, leafL - gapL);
  } else {
    leafL = frameL;
    leafR = leafL + leafW;
    gapL = leafR;
    gapW = Math.max(0, frameR - gapL);
  }

  if(gapW > 0.5){
    if(floorImg && floorImg.complete && floorImg.naturalWidth>0){
      ctx.imageSmoothingEnabled = false;
      ctx.drawImage(floorImg, 0, 0, floorImg.naturalWidth, floorImg.naturalHeight, gapL, top, gapW, height);
    } else {
      ctx.fillStyle = '#6f5330';
      ctx.fillRect(gapL, top, gapW, height);
    }
    const shadow = ctx.createLinearGradient(gapL, top, gapL + gapW, top);
    shadow.addColorStop(0, 'rgba(6,4,3,0.50)');
    shadow.addColorStop(1, 'rgba(20,12,8,0.28)');
    ctx.fillStyle = shadow;
    ctx.fillRect(gapL, top, gapW, height);
  }

  const slant = s * 0.06 * openAmt;
  ctx.save();
  ctx.beginPath();
  if(hingeRight){
    ctx.moveTo(leafL, top + slant);
    ctx.lineTo(leafR, top);
    ctx.lineTo(leafR, bottom);
    ctx.lineTo(leafL, bottom - slant);
  } else {
    ctx.moveTo(leafL, top);
    ctx.lineTo(leafR, top + slant);
    ctx.lineTo(leafR, bottom - slant);
    ctx.lineTo(leafL, bottom);
  }
  ctx.closePath();
  ctx.clip();

  if(leafImg && leafImg.complete && leafImg.naturalWidth>0){
    const srcX = Math.floor(leafImg.naturalWidth * 0.26);
    const srcY = Math.floor(leafImg.naturalHeight * 0.16);
    const srcW = Math.floor(leafImg.naturalWidth * 0.48);
    const srcH = Math.floor(leafImg.naturalHeight * 0.68);
    ctx.imageSmoothingEnabled = false;
    ctx.drawImage(leafImg, srcX, srcY, srcW, srcH, leafL, top, Math.max(1, leafR-leafL), height);
  } else {
    ctx.fillStyle = '#8b5b28';
    ctx.fillRect(leafL, top, Math.max(1, leafR-leafL), height);
  }

  const leafShade = ctx.createLinearGradient(leafL, top, leafR, top);
  if(hingeRight){
    leafShade.addColorStop(0, 'rgba(0,0,0,0.28)');
    leafShade.addColorStop(0.72, 'rgba(0,0,0,0.04)');
    leafShade.addColorStop(1, 'rgba(255,232,170,0.16)');
  } else {
    leafShade.addColorStop(0, 'rgba(255,232,170,0.16)');
    leafShade.addColorStop(0.28, 'rgba(0,0,0,0.04)');
    leafShade.addColorStop(1, 'rgba(0,0,0,0.28)');
  }
  ctx.fillStyle = leafShade;
  ctx.fillRect(leafL, top, Math.max(1, leafR-leafL), height);
  ctx.restore();

  ctx.fillStyle = 'rgba(212,180,108,0.74)';
  if(hingeRight) ctx.fillRect(frameR - Math.max(1, s*0.02), top, Math.max(1, s*0.02), height);
  else ctx.fillRect(frameL, top, Math.max(1, s*0.02), height);

  const theme = getFloorTheme();
  const doorTint = getThemeColor(theme,'topdownDoorTint',theme.accent || theme.mapWall,[150,110,72]);
  applyZoneTileTint(ctx, x, y, s, s, doorTint, 0.22, 0.05);

  return true;
}
function pokermonTileAt(x,y){

  if(!S.map || y<0 || y>=S.map.grid.length || x<0 || x>=S.map.grid[0].length) return '#';
  return S.map.grid[y][x];
}

function pokermonTorchData(wx,wy,ch,door){
  if(ch!=='#' || door || !S.map) return null;
  if(S.map.torchMap) return S.map.torchMap.get(`${wx},${wy}`) || null;
  if(Array.isArray(S.map.torches)) return S.map.torches.find(t=>t.x===wx && t.y===wy) || null;
  return null;
}
function pokermonHasTorch(wx,wy,ch,door){
  return !!pokermonTorchData(wx,wy,ch,door);
}
function pokermonTorchScreenPos(sx,sy,tile,dir){
  const p = { x: sx + tile*0.50, y: sy + tile*0.50 };
  if(dir==='S'){
    p.x = sx + tile*0.50;
    p.y = sy + tile*0.66;
  }else if(dir==='N'){
    p.x = sx + tile*0.50;
    p.y = sy + tile*0.34;
  }else if(dir==='E'){
    p.x = sx + tile*0.66;
    p.y = sy + tile*0.52;
  }else if(dir==='W'){
    p.x = sx + tile*0.34;
    p.y = sy + tile*0.52;
  }
  return p;
}
function pokermonTorchFlicker(wx,wy,timeMs){
  const t = timeMs * 0.0065 + wx*0.73 + wy*1.17;
  return 0.92 + Math.sin(t)*0.16 + Math.sin(t*1.91)*0.08 + Math.sin(t*3.07)*0.04;
}
function pokermonDrawTorchLighting(ctx, torches, W, H, tile, timeMs){
  const visibleTorches = torches || [];
  const theme = getFloorTheme();
  const torchTint = getThemeColor(theme,'topdownTorchTint',theme.viewGlowRgb || theme.accent,[255,186,92]);
  const warmCore = tintRgb(255,232,170,torchTint,0.32);
  const hotMid = tintRgb(255,198,105,torchTint,0.50);
  const outerGlow = tintRgb(255,142,62,torchTint,0.62);
  if(!dungeonLightCanvas)dungeonLightCanvas=document.createElement('canvas');
  if(dungeonLightCanvas.width!==W||dungeonLightCanvas.height!==H){dungeonLightCanvas.width=W;dungeonLightCanvas.height=H;}
  const shade=dungeonLightCanvas.getContext('2d');
  shade.clearRect(0,0,W,H);shade.save();
  shade.fillStyle='rgba(4,6,15,0.34)';shade.fillRect(0,0,W,H);
  if(visibleTorches.length){
    shade.globalCompositeOperation='destination-out';
    for(const t of visibleTorches){
      const flicker = pokermonTorchFlicker(t.wx,t.wy,timeMs);
      const r = tile * (2.9 + flicker*0.75);
      const g = shade.createRadialGradient(t.x,t.y,tile*0.08,t.x,t.y,r);
      g.addColorStop(0,'rgba(255,255,255,0.98)');
      g.addColorStop(0.18,'rgba(255,255,255,0.82)');
      g.addColorStop(0.42,'rgba(255,255,255,0.42)');
      g.addColorStop(0.74,'rgba(255,255,255,0.12)');
      g.addColorStop(1,'rgba(255,255,255,0)');
      shade.fillStyle=g;
      shade.fillRect(t.x-r,t.y-r,r*2,r*2);
    }
  }
  shade.restore();
  ctx.drawImage(dungeonLightCanvas,0,0);
  if(!visibleTorches.length) return;
  ctx.save();
  ctx.globalCompositeOperation='screen';
  for(const t of visibleTorches){
    const flicker = pokermonTorchFlicker(t.wx,t.wy,timeMs);
    const r = tile * (1.45 + flicker*0.40);
    const g = ctx.createRadialGradient(t.x,t.y,tile*0.03,t.x,t.y,r);
    g.addColorStop(0,rgbToCss(warmCore,0.24));
    g.addColorStop(0.22,rgbToCss(hotMid,0.16));
    g.addColorStop(0.56,rgbToCss(outerGlow,0.07));
    g.addColorStop(1,rgbToCss(outerGlow,0));
    ctx.fillStyle=g;
    ctx.fillRect(t.x-r,t.y-r,r*2,r*2);
  }
  ctx.restore();
}
function renderView(){
  const canvas=ge('view-canvas');
  if(!canvas || !S.map || !S.p) return;
  const ctx=canvas.getContext('2d');
  const W=canvas.width,H=canvas.height;
  ctx.clearRect(0,0,W,H);
  const cols=12, rows=8;
  const tile=Math.floor(Math.min(W/cols,H/rows));
  const ox=Math.floor((W-cols*tile)/2), oy=Math.floor((H-rows*tile)/2);
  const cx=Math.floor(cols/2), cy=Math.floor(rows/2);
  const torchGlows=[];
  if(dungeonVisual.owner!==S||dungeonVisual.floor!==S.floor){dungeonVisual={owner:S,floor:S.floor,actors:new WeakMap(),clock:0};}
  if(!S.paused)dungeonVisual.clock=performance.now();
  const timeNow=reducedMotion()?0:dungeonVisual.clock;
  const camera=visualActor(S.p,timeNow);
  const theme = getFloorTheme();
  const viewBgRgb = getThemeColor(theme,'topdownViewBg',theme.viewBg,[12,8,10]);
  const viewFloorRgb = getThemeColor(theme,'topdownViewFloor',theme.viewFloor,[18,18,20]);

  const bg=ctx.createLinearGradient(0,0,0,H);
  bg.addColorStop(0,rgbToCss(scaleRgb(viewBgRgb,1.18),1));
  bg.addColorStop(0.56,rgbToCss(scaleRgb(viewFloorRgb,0.80),1));
  bg.addColorStop(1,rgbToCss(scaleRgb(viewBgRgb,0.46),1));
  ctx.fillStyle=bg; ctx.fillRect(0,0,W,H);

  // Keep oversized board sprites (like the enlarged stairs/shop art) inside the
  // actual dungeon viewport so they don't bleed into the outer margin and look
  // like they're floating outside the board.
  ctx.save();
  ctx.beginPath();
  ctx.rect(ox, oy, cols*tile, rows*tile);
  ctx.clip();

  const specialDraws=[];

  for(let vy=-1;vy<=rows;vy++){
    for(let vx=-1;vx<=cols;vx++){
      const wx=Math.floor(camera.x) + (vx-cx);
      const wy=Math.floor(camera.y) + (vy-cy);
      const sx=ox+(wx-camera.x+cx)*tile, sy=oy+(wy-camera.y+cy)*tile;
      const ch=pokermonRenderTileAt(wx,wy);
      const door=(S.doors||[]).find(d=>d.x===wx && d.y===wy);
      if(ch==='#') pokermonDrawWall(ctx,sx,sy,tile,wx,wy);
      else if(ch==='+') pokermonDrawDoor(ctx,sx,sy,tile,door,wx,wy);
      else pokermonDrawDungeonRole(ctx, pokermonDungeonRole(wx,wy,ch,door), sx,sy,tile,wx,wy);

      if(ch!=='#'&&ch!==' '&&ch!=='+')drawFloorDepth(ctx,sx,sy,tile,wx,wy);
      drawDungeonDetail(ctx,sx,sy,tile,wx,wy,ch,timeNow);
      if(ch==='>'||ch==='$'||ch==='§'){
        specialDraws.push({ch,sx,sy,tile,wx,wy});
      }

      const torchData = pokermonTorchData(wx,wy,ch,door);
      if(torchData){
        const tp = pokermonTorchScreenPos(sx,sy,tile,torchData.dir);
        torchGlows.push({wx,wy,dir:torchData.dir,x:tp.x,y:tp.y,sx,sy,tile});
      }
    }
  }

  // Draw oversized specials after the ground pass so stairs/shop/chest art can
  // overlap neighbouring floor tiles without being covered by later tile draws.
  for(const sp of specialDraws){
    const key = sp.ch==='>'?'stairs':(sp.ch==='$'?'chest':'merchant');
    drawLandmarkGlow(ctx,sp,timeNow);
    if(!pokermonDrawImgOrSprite(ctx,key,sp.sx,sp.sy,sp.tile)){
      ctx.fillStyle= sp.ch==='>' ? '#7ad0dd' : sp.ch==='$' ? '#ffd66b' : '#c392ff';
      ctx.font=`${Math.max(16,Math.floor(sp.tile*0.6))}px VT323`;
      ctx.textAlign='center';
      ctx.fillText(sp.ch==='>'?'▼':(sp.ch==='$'?'$':'§'), sp.sx+sp.tile/2, sp.sy+sp.tile*0.68);
      ctx.textAlign='left';
    }
  }

  // Stronger region wash so the top-down board itself changes mood with depth.
  ctx.save();
  ctx.fillStyle = theme.viewTint || 'rgba(0,0,0,0)';
  ctx.fillRect(ox, oy, cols*tile, rows*tile);
  ctx.restore();

  for(const en of (S.enemies||[])){
    if(!en || en.dead) continue;
    const actor=visualActor(en,timeNow);
    const vx=actor.x - camera.x + cx;
    const vy=actor.y - camera.y + cy;
    if(vx<-1||vx>cols||vy<-1||vy>rows) continue;
    const sx=ox+vx*tile, sy=oy+vy*tile;
    const sprKey=SPRITE_MAP[en.def.name] || SPRITE_MAP[en.def.id] || 'gob';
    const breathe=reducedMotion()?0:Math.sin(timeNow*.002+en.x*.7+en.y)*.65;
    if(!pokermonDrawImgOrSprite(ctx,sprKey,sx,sy+breathe,tile)){
      ctx.fillStyle='#ff8d74';
      ctx.beginPath(); ctx.arc(sx+tile/2,sy+tile/2,tile*0.28,0,Math.PI*2); ctx.fill();
    }

  }

  const psx=ox+cx*tile, psy=oy+cy*tile;

  // Draw small wall-mounted torch sprites first so the lighting pass integrates them.
  ctx.save();
  ctx.globalAlpha = 0.88;
  for(const tg of torchGlows){
    if(!pokermonDrawImgOrSprite(ctx,'torch',tg.sx,tg.sy,tg.tile*0.60)){
      const flicker = pokermonTorchFlicker(tg.wx,tg.wy,timeNow);
      const flameR = tg.tile * (0.05 + flicker*0.010);
      const torchTint = getThemeColor(theme,'topdownTorchTint',theme.viewGlowRgb || theme.accent,[255,186,92]);
      const coreTint = tintRgb(255,220,120,torchTint,0.34);
      const outerTint = tintRgb(255,150,60,torchTint,0.58);
      ctx.fillStyle=rgbToCss(coreTint,0.88);
      ctx.beginPath();
      ctx.arc(tg.x, tg.y, flameR, 0, Math.PI*2);
      ctx.fill();
      ctx.fillStyle=rgbToCss(outerTint,0.74);
      ctx.beginPath();
      ctx.arc(tg.x, tg.y+flameR*0.12, flameR*0.56, 0, Math.PI*2);
      ctx.fill();
    }
  }
  ctx.restore();

  const heroKey=heroSpriteKey();
  const walking=!reducedMotion()&&(camera.fromX!==camera.toX||camera.fromY!==camera.toY)&&timeNow-camera.start<135;
  const stride=walking?Math.sin((timeNow-camera.start)/135*Math.PI):0;
  const breath=reducedMotion()?0:Math.sin(timeNow/550)*.004;
  ctx.save();ctx.translate(psx+tile/2,psy+tile);
  ctx.rotate(stride*(S.facing%2===0?.025:-.025));
  ctx.scale(1,1+breath);ctx.translate(-psx-tile/2,-psy-tile-Math.abs(stride)*tile*.04);
  const drewHero = heroSpriteReady() && pokermonDrawImgOrSprite(ctx,heroKey,psx,psy,tile);
  ctx.restore();
  if(!drewHero){
    ctx.fillStyle='#6de3d6';
    ctx.beginPath(); ctx.arc(psx+tile/2,psy+tile/2,tile*0.28,0,Math.PI*2); ctx.fill();
    ctx.lineWidth=2; ctx.strokeStyle='#ecfffd'; ctx.stroke();
    ctx.fillStyle='#082221';
    ctx.beginPath();
    if(S.facing===0){ ctx.moveTo(psx+tile/2,psy+tile*0.2); ctx.lineTo(psx+tile*0.68,psy+tile*0.56); ctx.lineTo(psx+tile*0.32,psy+tile*0.56); }
    else if(S.facing===1){ ctx.moveTo(psx+tile*0.8,psy+tile/2); ctx.lineTo(psx+tile*0.44,psy+tile*0.32); ctx.lineTo(psx+tile*0.44,psy+tile*0.68); }
    else if(S.facing===2){ ctx.moveTo(psx+tile/2,psy+tile*0.8); ctx.lineTo(psx+tile*0.32,psy+tile*0.44); ctx.lineTo(psx+tile*0.68,psy+tile*0.44); }
    else { ctx.moveTo(psx+tile*0.2,psy+tile/2); ctx.lineTo(psx+tile*0.56,psy+tile*0.32); ctx.lineTo(psx+tile*0.56,psy+tile*0.68); }
    ctx.closePath(); ctx.fill();
  }

  // Environmental torchlight: flickering pools cast from wall torches, not from the player.
  pokermonDrawTorchLighting(ctx, torchGlows, W, H, tile, timeNow);

  drawPassageFade(ctx,W,H);

  // Gentle edge vignette on top so the whole board feels cave-like.
  const vignette=ctx.createRadialGradient(W*0.5,H*0.5,Math.min(W,H)*0.22,W*0.5,H*0.5,Math.max(W,H)*0.76);
  vignette.addColorStop(0,'rgba(0,0,0,0)');
  vignette.addColorStop(1,theme.viewVignette || 'rgba(0,0,0,0.18)');
  ctx.fillStyle=vignette;
  ctx.fillRect(0,0,W,H);

  // Restrained dust near light sources. Deterministic visuals never use gameplay RNG.
  if(!reducedMotion())for(const tg of torchGlows){
    for(let i=0;i<3;i++){
      const phase=((timeNow*.00009+i*.31+tg.wx*.13)%1+1)%1;
      ctx.fillStyle=`rgba(255,216,143,${Math.sin(phase*Math.PI)*.32})`;
      ctx.fillRect(tg.x+Math.sin(phase*5+i)*tile*.6,tg.y+tile*(.7-phase*1.2),1.3,1.3);
    }
  }
  ctx.restore();
  renderMinimap();
}

function treasureMakeDeck(){
  let deck=pokerMakeDeck().map(c=>({rank:c.rank,suit:c.suit,revealed:false,alarm:false}));
  deck=deck.concat([{alarm:true,revealed:false},{alarm:true,revealed:false},{alarm:true,revealed:false},{alarm:true,revealed:false},{alarm:true,revealed:false}]);
  return pokerShuffle(deck);
}
function treasureHiddenCount(){
  let n=0;
  for(const row of (S.tboard||[])) for(const card of row) if(card && !card.revealed) n++;
  return n;
}
function treasurePending(){ return S.tPending || {gold:0,heal:0,shield:0,mp:0}; }
function treasureUpdateUI(){
  const p=treasurePending();
  if(ge('trs-turns')) ge('trs-turns').textContent=`${S.tAlarms||0} / ${S.tMaxAlarms||3}`;
  if(ge('trs-gold')) ge('trs-gold').textContent=String(p.gold||0);
  if(ge('trs-hp')) ge('trs-hp').textContent=String(p.heal||0);
  if(ge('trs-shield')) ge('trs-shield').textContent=String(p.shield||0);
  if(ge('trs-mp')) ge('trs-mp').textContent=String(p.mp||0);
  if(ge('vault-cashout')){ge('vault-cashout').textContent=`BANK & LEAVE: ${p.gold||0}G · ${p.heal||0}HP · ${p.shield||0} SHIELD · ${p.mp||0}MP`;ge('vault-cashout').disabled=!!S.tBusted;}
  if(ge('trs-cbo')) ge('trs-cbo').textContent=`x${(S.tMult||1).toFixed(2)}  •  ${treasureHiddenCount()} cards left`;
}
function trsLog(msg,type='n'){
  const c=ge('trs-log'); if(!c) return;
  const d=document.createElement('div');
  d.className=`l-${type}`; d.textContent=msg;
  c.appendChild(d); c.scrollTop=c.scrollHeight;
  while(c.children.length>20)c.removeChild(c.firstChild);
}
function openTreasure(){
  requestSave();
  if(S.map && S.map.grid && S.map.grid[S.p.y]) S.map.grid[S.p.y][S.p.x]='.';
  SFX.loot();
  log('VAULT RUN! Flip cards, press Q to bank the stash and leave.','l');
  S.mode='treasure';
  S.tproc=false; S.tsel=null; S.tc={r:3,c:3};
  S.tDeck=treasureMakeDeck();
  S.tboard=Array.from({length:BS},()=>Array.from({length:BS},()=>S.tDeck.pop() || {alarm:true,revealed:false}));
  S.tAlarms=0; S.tMaxAlarms=3; S.tMult=1; S.tChain=0; S.tLastSuit=null; S.tVaultGold=0;
  S.tPending={gold:0,heal:0,shield:0,mp:0};
  S.tBusted=false;
  if(ge('trs-log')) ge('trs-log').innerHTML='';
  trsLog('Reveal cards. Matching suit streaks raise the multiplier. Three alarms and the vault locks you out.','n');
  treasureUpdateUI();
  renderTrsBoard();
  showScr('trs');
}
function treasureApplyCard(card){
  const p=treasurePending();
  if(card.alarm){
    S.tAlarms=(S.tAlarms||0)+1;
    S.tLastSuit=null; S.tChain=0;
    trsLog(`ALARM ${S.tAlarms}/${S.tMaxAlarms}! The vault groans.`, 'atk');
    if(S.tAlarms>=S.tMaxAlarms){
      S.tBusted=true;S.tproc=true;
      trsLog('BUST! The pending stash is lost.', 'd');
      scheduleGame(()=>endTreasure(true), 450);
    }
    return;
  }
  if(S.tLastSuit===card.suit){
    S.tChain=(S.tChain||1)+1;
    S.tMult=Math.min(4, +(S.tMult+0.25).toFixed(2));
    trsLog(`Suit streak! ${POKER_SUITS[card.suit]} multiplier up.`, 'mag');
  } else {
    S.tLastSuit=card.suit;
    S.tChain=1;
  }
  if(card.rank>=11) S.tMult=Math.min(4, +(S.tMult+0.10).toFixed(2));
  if(card.rank===14) S.tMult=Math.min(4, +(S.tMult+0.25).toFixed(2));

  let gain=0;
  if(card.suit==='D'){
    gain=Math.ceil(card.rank * (S.tMult||1));
    if(card.rank>=11) gain+=3;
    p.gold += gain;
    trsLog(`${pokerCardText(card)} adds ${gain} gold to the stash.`, 'win');
  } else if(card.suit==='H'){
    gain=Math.max(1, Math.ceil(card.rank * 0.5 * (S.tMult||1)));
    p.heal += gain;
    trsLog(`${pokerCardText(card)} adds ${gain} healing to cash out.`, 'hlt');
  } else if(card.suit==='S'){
    gain=Math.max(1, Math.ceil(card.rank * 0.33 * (S.tMult||1)));
    p.shield += gain;
    trsLog(`${pokerCardText(card)} adds ${gain} shield to cash out.`, 'def');
  } else if(card.suit==='C'){
    gain=Math.max(1, Math.ceil(card.rank * 0.33 * (S.tMult||1)));
    p.mp += gain;
    trsLog(`${pokerCardText(card)} adds ${gain} MP to cash out.`, 'mag');
  }
  if(card.rank===14){
    p.gold += 5;
    trsLog('Ace bonus! +5 extra gold in the stash.', 'l');
  }
  S.tPending=p;
}
function renderTrsBoard(){
  const el=ge('trs-board'); if(!el) return; el.innerHTML='';
  for(let r=0;r<BS;r++) for(let c=0;c<BS;c++){
    const card=S.tboard && S.tboard[r] ? S.tboard[r][c] : null;
    const d=document.createElement('div');
    d.className='bt';
    if(S.tc && S.tc.r===r && S.tc.c===c) d.classList.add('vault-cur');
    if(!card || !card.revealed){
      d.classList.add('vault-back');
      d.innerHTML='<div class="vk-mini">VAULT</div><div class="vk-mid">🂠</div><div class="vk-bot">VAULT</div>';
    } else if(card.alarm){
      d.classList.add('vault-alarm');
      d.innerHTML='<div class="vk-mini">ALARM</div><div class="vk-mid">!!</div><div class="vk-bot">ALARM</div>';
    } else {
      d.classList.add('vault-safe', `vs-${card.suit}`);
      const txt=`${pokerRankLabel(card.rank)}${POKER_SUITS[card.suit]}`;
      d.innerHTML=`<div class="vk-mini">${txt}</div><div class="vk-mid">${POKER_SUITS[card.suit]}</div><div class="vk-bot">${txt}</div>`;
    }
    el.appendChild(d);
  }
}
function onTrsTile(r,c){
  requestSave();
  if(S.tproc || S.tBusted || S.paused || S.mode!=='treasure') return;
  const card=S.tboard && S.tboard[r] ? S.tboard[r][c] : null;
  if(!card || card.revealed) return;
  S.tc={r,c};
  card.revealed=true;
  SFX.sel();
  treasureApplyCard(card);
  renderTrsBoard();
  treasureUpdateUI();
  if(!S.tBusted && treasureHiddenCount()<=0){
    trsLog('The vault is exhausted. Auto-banking the stash.', 'l');
    S.tproc=true;
    scheduleGame(()=>endTreasure(false), 450);
  }
}
function endTreasure(auto){
  requestSave();
  if(S.mode!=='treasure') return;
  const p=treasurePending();
  if(!S.tBusted){
    if(p.gold||p.heal||p.shield||p.mp){
      S.p.gold += p.gold||0;
      S.p.hp = Math.min(S.p.maxHp, S.p.hp + (p.heal||0));
      S.p.mp = Math.min(S.p.maxMp, S.p.mp + (p.mp||0));
      S.vaultShield = (S.vaultShield||0) + (p.shield||0);
      S.tVaultGold = (S.tVaultGold||0) + (p.gold||0);
      log(`Vault banked: +${p.gold||0}G, +${p.heal||0}HP, +${p.mp||0}MP, +${p.shield||0} shield.`, 'l');
      // Vault-to-combat bridge: chance for combat modifier
      if((S.tMult||1)>=2.0&&Math.random()<0.4){
        const mods=['extraRedraw','heartDouble','atkBoost'];
        const mod=mods[Math.floor(Math.random()*mods.length)];
        S.vaultCombatMod=mod;
        const modNames={extraRedraw:'+1 Redraw next fight',heartDouble:'+2 healing and guard per scoring Heart next fight',atkBoost:'+0.30 ATK multiplier next fight'};
        log('★ Vault bonus: '+modNames[mod]+'!','l');
        SFX.lvlup();
      }
      // Vault artifact drop: rare chance at high multiplier
      if((S.tMult||1)>=3.0&&Math.random()<0.3){
        const available=POKER_ARTIFACTS.filter(a=>!S.artifacts.some(x=>x.id===a.id));
        if(available.length>0){
          const art=available[Math.floor(Math.random()*available.length)];
          grantArtifact(art);
          SFX.lvlup();
        }
      }
    } else {
      log('You leave the vault with nothing banked.', 'e');
    }
  } else {
    log('Vault lockout! Your pending stash is lost.', 'd');
  }
  S.tPending={gold:0,heal:0,shield:0,mp:0};
  S.tBusted=false;
  S.mode='dun'; showScr('dun'); updateDUI(); renderView();
}

/* v26 — MP tricks */
function trickOptions(){
  return [
    ...['S','H','D','C'].map(suit=>({kind:'suit',suit,cost:6,label:`Suit → ${POKER_SUITS[suit]} · 6 MP`})),
    {kind:'rank',cost:5,label:'Rank +1 · 5 MP'},
    {kind:'redraw',cost:12,label:'Extra redraw · 12 MP'}
  ];
}
function trickUnavailable(option){
  if(S.mode!=='cmb'||!S.playerTurn||S.processing||S.paused||S._combatDone)return 'Wait for your turn.';
  if(S.trickUsed)return 'One trick per turn — already used.';
  if(S.p.mp<option.cost)return `Needs ${option.cost} MP.`;
  if(option.kind==='redraw'){
    const rule=ENEMY_POKER_RULES[S.enemy.def.name];
    return rule&&rule.noRedraw?'The Death Knight forbids all redraws.':'';
  }
  if((S.pokerSelected||[]).length!==1)return 'Select exactly one card first.';
  const card=S.pokerHand[S.pokerSelected[0]];
  if(!card)return 'Select a card first.';
  if(option.kind==='rank'&&card.rank===14)return 'Ace is already the highest rank.';
  if(option.kind==='suit'&&card.suit===option.suit)return 'This card already has that suit.';
  return '';
}
function toggleTrickMenu(){
  if(S.mode!=='cmb'||!S.playerTurn||S.processing||S.paused||S._combatDone)return;
  S.trickMenu=!S.trickMenu;S.trickCursor=0;renderPokerBoard();
}
function moveTrickCursor(delta){
  S.trickCursor=((S.trickCursor||0)+delta+6)%6;renderPokerBoard();
}
function activateTrick(index){
  const option=trickOptions()[index];if(!option)return false;
  const unavailable=trickUnavailable(option);
  if(unavailable){clog(unavailable,'def');return false;}
  const card=S.pokerHand[S.pokerSelected[0]];
  const before=card?{...card}:null;
  S.p.mp-=option.cost;
  if(option.kind==='suit')card.suit=option.suit;
  if(option.kind==='rank')card.rank++;
  if(option.kind==='redraw')S.pokerRedraws=(S.pokerRedraws||0)+1;
  S.trickUsed=true;S.trickMenu=false;S.pokerCanStandPat=false;
  clog(`✦ ${option.label}. ${option.kind==='redraw'?'Select up to 3 cards and redraw.':pokerCardText(before)+' → '+pokerCardText(card)} Stand pat forfeited.`,'mag');
  pushRunEvent('mp_trick',{kind:option.kind,cost:option.cost,before,after:card?{...card}:null,turn:S.pokerTurn});
  SFX.sel();updateCUI();renderPokerBoard();pokerUpdateSummary();requestSave();return true;
}
function renderTrickControls(){
  if(!S.trickMenu)return '';
  const active=S.playerTurn&&!S.processing&&!S.paused&&!S._combatDone;
  const options=S.trickMenu?`<div class="trick-options">${trickOptions().map((o,i)=>{
    const reason=trickUnavailable(o);
    return `<button class="pk-btn ${i===S.trickCursor?'trick-current':''}" onclick="activateTrick(${i})" title="${reason||'Spend '+o.cost+' MP'}" ${reason?'disabled':''}>${i+1}. ${o.label}</button>`;
  }).join('')}</div><span class="trick-note">${trickUnavailable(trickOptions()[S.trickCursor||0])||'Ready to use.'} ← → choose · Enter / A use · Esc / B back</span>`:'';
  return `<div class="pk-tricks"><span class="trick-note">${S.p.mp} MP · One trick per turn; forfeits stand pat. Select one card to change its suit or rank.</span>${options}</div>`;
}

/* v26 — completed-action checkpoints. No re-deal or reward reroll on restore. */
var saveQueued=false;
var saveError='';
function runSaveKey(){return 'av3_run_v26';}
function canSaveRun(){
  if(!S.map||!S.p||S.p.hp<=0||S.runEnded)return false;
  if(S.mode==='cmb')return !!S._combatDone || (!!S.playerTurn&&!S.processing);
  if(S.mode==='reward')return !!S.rewardChoices?.length;
  if(S.mode==='treasure')return !S.tproc&&!S.tBusted;
  return ['dun','shop'].includes(S.mode)&&!S.processing;
}
function requestSave(){
  if(saveQueued)return;
  saveQueued=true;
  queueMicrotask(()=>{saveQueued=false;saveRun();});
}
function captureRun(){
  const enemyIndex=S.enemy?S.enemies.indexOf(S.enemy.ref):-1;
  const state={...S,paused:false,trickMenu:false,shopItems:S.shopItems?S.shopItems.map(i=>i.name):null,
    artifacts:(S.artifacts||[]).map(a=>a.id),rewardChoices:(S.rewardChoices||[]).map(a=>a.id)};
  delete state._combatReturn;
  if(state.enemy){state.enemy={...state.enemy};delete state.enemy.ref;}
  // References/caches are reconnected after JSON parsing, not serialized as empty objects.
  state.map={...state.map};delete state.map.torchSet;delete state.map.torchMap;
  const logs={};
  for(const id of ['log-inner','c-log','trs-log'])logs[id]=Array.from(ge(id)?.children||[]).slice(-40).map(e=>({text:e.textContent,cls:e.className}));
  return JSON.stringify({version:26,savedAt:Date.now(),enemyIndex,state,logs});
}
function decodeRun(raw){
  const data=JSON.parse(raw);
  if(!data||data.version!==26||!data.state)throw Error('Unsupported save.');
  const t=data.state;
  const cell=(x,y)=>Number.isInteger(x)&&x>=0&&x<MW&&Number.isInteger(y)&&y>=0&&y<MH;
  const card=c=>c&&Number.isInteger(c.rank)&&c.rank>=2&&c.rank<=14&&['S','H','D','C'].includes(c.suit);
  if(!['dun','cmb','shop','treasure','reward'].includes(t.mode)||!t.p||!cell(t.p.x,t.p.y)||!(t.p.hp>0)||t.runEnded)throw Error('Invalid run.');
  for(const key of ['hp','maxHp','mp','maxMp','atk','def','gold','level','xp','xpNext'])if(!Number.isFinite(t.p[key]))throw Error('Invalid player.');
  if(!Number.isInteger(t.floor)||t.floor<1||!t.map||!Array.isArray(t.map.grid)||t.map.grid.length!==MH||!t.map.grid.every(r=>Array.isArray(r)&&r.length===MW&&r.every(c=>typeof c==='string'&&c.length===1)))throw Error('Invalid map.');
  if(!Array.isArray(t.seen)||t.seen.length!==MH||!t.seen.every(r=>Array.isArray(r)&&r.length===MW))throw Error('Invalid explored map.');
  if(!Array.isArray(t.enemies)||!t.enemies.every(e=>cell(e.x,e.y)&&EDEFS.some(d=>d.id===e.def?.id)))throw Error('Invalid enemies.');
  if(!Array.isArray(t.doors)||!Array.isArray(t.artifacts)||!t.artifacts.every(id=>POKER_ARTIFACTS.some(a=>a.id===id)))throw Error('Invalid inventory.');
  if(t.shopItems!==null&&(!Array.isArray(t.shopItems)||!t.shopItems.every(n=>SHOP_ITEMS.some(i=>i.name===n))))throw Error('Invalid shop.');
  if(t.mode==='shop'&&!t.shopItems?.length)throw Error('Missing shop stock.');
  if(t.mode==='cmb'||t.mode==='reward'){
    if(!t.enemy||!t.enemies[data.enemyIndex]||!Array.isArray(t.pokerHand)||!t.pokerHand.every(card)||!Array.isArray(t.pokerDeck)||!t.pokerDeck.every(card))throw Error('Invalid battle.');
    if(!t._combatDone&&(!t.playerTurn||t.processing||t.enemy.hp<=0))throw Error('Unfinished action.');
    if(!t._combatDone&&!(MOVES[t.enemies[data.enemyIndex].def.name]||[]).some(m=>m.n===t.enemy.intent?.n))throw Error('Missing enemy intent.');
    if(t._combatDone&&!t.completedBattle)throw Error('Missing battle reward.');
  }
  if(t.mode==='reward'&&(!Array.isArray(t.rewardChoices)||!t.rewardChoices.length||!t.rewardChoices.every(id=>POKER_ARTIFACTS.some(a=>a.id===id))))throw Error('Invalid reward choice.');
  if(t.mode==='treasure'&&(t.tBusted||t.tproc||!Array.isArray(t.tboard)||t.tboard.length!==BS||!t.tboard.every(r=>Array.isArray(r)&&r.length===BS&&r.every(c=>c&&(c.alarm||card(c))))))throw Error('Invalid vault.');
  t.artifacts=t.artifacts.map(id=>POKER_ARTIFACTS.find(a=>a.id===id));
  t.rewardChoices=(t.rewardChoices||[]).map(id=>POKER_ARTIFACTS.find(a=>a.id===id)).filter(Boolean);
  t.shopItems=t.shopItems?t.shopItems.map(n=>SHOP_ITEMS.find(i=>i.name===n)):null;
  t.enemies.forEach(e=>{e.def={...EDEFS.find(d=>d.id===e.def.id)};});
  if(t.mode==='cmb'||t.mode==='reward'){
    t.enemy.ref=t.enemies[data.enemyIndex];t.enemy.def=t.enemy.ref.def;
    if(t.enemy.intent)t.enemy.intent={...(MOVES[t.enemy.def.name]||[]).find(m=>m.n===t.enemy.intent.n)};
  }else t.enemy=null;
  t.map.torchSet=new Set((t.map.torches||[]).map(x=>`${x.x},${x.y}`));
  t.map.torchMap=new Map((t.map.torches||[]).map(x=>[`${x.x},${x.y}`,x]));
  t._combatReturn=returnFromCombat;t.paused=false;t.trickMenu=false;
  data.state={...fresh(),...t};return data;
}
function readRunSave(){
  try{const raw=localStorage.getItem(runSaveKey());return raw?decodeRun(raw):null;}
  catch(e){saveError='Saved run unavailable: '+e.message;return null;}
}
function hasRunSave(){return !!readRunSave();}
function saveRun(){
  if(!canSaveRun())return false;
  try{localStorage.setItem(runSaveKey(),captureRun());saveError='';showSaveError();return true;}
  catch(e){saveError='Could not save this run. Browser storage may be blocked or full.';showSaveError();return false;}
}
function showSaveError(){
  const el=ge('autosave-error');if(el){el.textContent=saveError;el.hidden=!saveError;}
  const note=ge('pause-save-note');if(note&&S.paused)note.textContent=saveError;
}
function clearRunSave(){
  try{localStorage.removeItem(runSaveKey());saveError='';}catch(e){saveError='Browser storage is unavailable.';}
}
function refreshSaveMenu(){
  const data=readRunSave();const btn=ge('continue-run');if(!btn)return;
  btn.hidden=!data;
  btn.textContent=data?`CONTINUE · FLOOR ${data.state.floor} · LV ${data.state.p.level}`:'CONTINUE';
  ge('save-message').textContent=saveError||(data?'Run saved in this browser. New Run replaces it.':'Autosaves after completed actions in this browser. Pause → Save & Title to stop.');
}
function requestNewRun(endless){
  if(hasRunSave()&&!window.confirm('Start a new run? This replaces your saved run.'))return;
  startGame(endless);
}
function restoreRunLogs(logs){
  for(const id of ['log-inner','c-log','trs-log']){
    const el=ge(id);el.innerHTML='';
    for(const row of (logs?.[id]||[]).slice(-40)){
      const node=document.createElement('div');node.textContent=String(row.text||'');
      node.className=/^l-[a-z]+$/.test(row.cls)?row.cls:'l-n';el.appendChild(node);
    }
  }
}
function continueRun(){
  if(S.mode!=='title')return false;
  const data=readRunSave();if(!data){refreshSaveMenu();return false;}
  S=data.state;restoreRunLogs(data.logs);
  ge('pause-overlay').style.display='none';ge('shop-overlay').classList.remove('on');
  applyFloorTheme();updateDUI();
  if(S.mode==='cmb'){
    showScr('cmb');ge('c-ename').textContent=S.enemy.def.name+(S.enemy.def.boss?' [BOSS]':'');
    ge('c-elv').textContent=S.floor;ge('c-plv').textContent=S.p.level;
    ge('turn-ind').textContent=S._combatDone?'VICTORY':'YOUR TURN';
    ge('turn-ind').className='ti-p';
    updateCUI();renderEnemyIntent();renderCombatSprites();renderPokerBoard();pokerUpdateSummary();
  }else if(S.mode==='reward'){showScr('reward');renderArtifactReward();}
  else if(S.mode==='treasure'){showScr('trs');renderTrsBoard();treasureUpdateUI();}
  else{showScr('dun');renderView();if(S.mode==='shop')openShop();}
  if(S.musicOn)setMusic(S.mode==='cmb'?'cmb':'dun');else stopMusic(true);
  showSaveError();return true;
}
function suspendRun(){
  if(!canSaveRun()){ge('pause-save-note').textContent='Resume to finish this action before saving.';return false;}
  if(!saveRun())return false;
  // A new state identity invalidates pending callbacks from the suspended session.
  const prefs={musicOn:S.musicOn,hintsOn:S.hintsOn};S={...fresh(),...prefs};
  stopMusic(true);ge('pause-overlay').style.display='none';ge('shop-overlay').classList.remove('on');
  ge('death-msg').style.display='none';showScr('title');setTitleState(false);renderScores();return true;
}
function scheduleGame(fn,ms){
  const owner=S;
  const run=()=>{if(S!==owner||S.runEnded)return;if(S.paused){setTimeout(run,100);return;}fn();};
  return setTimeout(run,ms);
}
function waitForGame(ms){
  const owner=S;
  return new Promise(resolve=>{
    const done=()=>{if(S===owner&&S.paused&&!S.runEnded){setTimeout(done,100);return;}resolve();};
    setTimeout(done,ms);
  });
}
document.addEventListener('click',()=>requestSave());
window.addEventListener('pagehide',()=>saveRun());
window.addEventListener('DOMContentLoaded',()=>{refreshSaveMenu();showSaveError();});

/* v27 presentation state is separate from saved gameplay state. */
var dungeonVisual={owner:null,floor:0,actors:new WeakMap(),clock:0};
var spriteBoundsCache=new WeakMap();
var dungeonLightCanvas=null;
function reducedMotion(){return !!(window.matchMedia&&window.matchMedia('(prefers-reduced-motion: reduce)').matches);}
function visualActor(actor,time){
  let v=dungeonVisual.actors.get(actor);
  if(!v){v={x:actor.x,y:actor.y,fromX:actor.x,fromY:actor.y,toX:actor.x,toY:actor.y,start:time};dungeonVisual.actors.set(actor,v);}
  if(v.toX!==actor.x||v.toY!==actor.y){v.fromX=v.x;v.fromY=v.y;v.toX=actor.x;v.toY=actor.y;v.start=time;}
  const t=reducedMotion()?1:Math.min(1,Math.max(0,(time-v.start)/135));
  const ease=1-Math.pow(1-t,3);
  v.x=v.fromX+(v.toX-v.fromX)*ease;v.y=v.fromY+(v.toY-v.fromY)*ease;
  return v;
}
function spriteBounds(img){
  if(!img||!img.complete||!img.naturalWidth)return null;
  if(spriteBoundsCache.has(img))return spriteBoundsCache.get(img);
  const c=document.createElement('canvas');c.width=img.naturalWidth;c.height=img.naturalHeight;
  const x=c.getContext('2d');x.drawImage(img,0,0);
  let bounds={x:0,y:0,w:c.width,h:c.height};
  try{
    const pixels=x.getImageData(0,0,c.width,c.height).data;
    let l=c.width,r=-1,t=c.height,b=-1;
    for(let y=0;y<c.height;y++)for(let z=0;z<c.width;z++)if(pixels[(y*c.width+z)*4+3]>20){l=Math.min(l,z);r=Math.max(r,z);t=Math.min(t,y);b=Math.max(b,y);}
    if(r>=l)bounds={x:l,y:t,w:r-l+1,h:b-t+1};
  }catch(e){}
  spriteBoundsCache.set(img,bounds);return bounds;
}
function drawFloorDepth(ctx,x,y,tile,wx,wy){
  const walls=[pokermonRenderTileAt(wx,wy-1)==='#',pokermonRenderTileAt(wx-1,wy)==='#',pokermonRenderTileAt(wx+1,wy)==='#'];
  if(walls[0]){
    const g=ctx.createLinearGradient(x,y,x,y+tile*.4);g.addColorStop(0,'rgba(3,5,12,.54)');g.addColorStop(1,'rgba(3,5,12,0)');ctx.fillStyle=g;ctx.fillRect(x,y,tile,tile*.4);
  }
  for(const side of [1,2])if(walls[side]){
    const edge=side===1?x:x+tile,inside=side===1?x+tile*.22:x+tile*.78;
    const g=ctx.createLinearGradient(edge,y,inside,y);g.addColorStop(0,'rgba(3,5,12,.28)');g.addColorStop(1,'rgba(3,5,12,0)');ctx.fillStyle=g;ctx.fillRect(Math.min(edge,inside),y,tile*.22,tile);
  }
}


// Visual-only state: never stored in a run checkpoint.
var passageVisual=null;
function dungeonPassage(kind,enter){
  if(S.processing||S.paused||S.mode!=='dun')return;
  requestSave();
  if(reducedMotion()){enter();return;}
  S.processing=true;
  passageVisual={owner:S,kind,start:performance.now(),clock:performance.now(),elapsed:0,duration:kind==='stairs'?260:180};
  scheduleGame(()=>{passageVisual=null;S.processing=false;enter();},passageVisual.duration);
}
function passageProgress(){
  const v=passageVisual;if(!v||v.owner!==S)return 0;
  const now=performance.now();if(!S.paused)v.elapsed+=now-v.clock;v.clock=now;
  return Math.min(1,Math.max(0,v.elapsed/v.duration));
}
function drawPassageFade(ctx,w,h){
  if(!passageVisual||passageVisual.owner!==S)return;
  const p=passageProgress();
  ctx.save();ctx.fillStyle=`rgba(3,6,12,${p*p*(3-2*p)})`;ctx.fillRect(0,0,w,h);ctx.restore();
}

function drawLandmarkGlow(ctx,sp,time){
  if(sp.ch==='$')return;
  const {sx:x,sy:y,tile:s}=sp;
  const pulse=reducedMotion()?1:.85+Math.sin(time/620+sp.wx)*.15;
  ctx.save();
  const glow=ctx.createRadialGradient(x+s*.5,y+s*.7,0,x+s*.5,y+s*.7,s*.9);
  glow.addColorStop(0,sp.ch==='§'?`rgba(243,172,62,${.24*pulse})`:`rgba(94,153,178,${.18*pulse})`);glow.addColorStop(1,'rgba(0,0,0,0)');
  ctx.fillStyle=glow;ctx.fillRect(x-s*.4,y-s*.2,s*1.8,s*1.8);
  ctx.restore();
}
function drawDungeonDetail(ctx,x,y,s,wx,wy,ch,time){
  const n=((Math.imul(wx+97,73856093)^Math.imul(wy+31,19349663)^Math.imul(S.floor,83492791))>>>0);
  ctx.save();
  if(ch==='.'||ch===' '){
    if(ch===' '){ctx.restore();return;}
    const wall=pokermonRenderTileAt(wx,wy-1)==='#';
    if(n%17===0){ // Shallow puddle with a subdued torch reflection.
      ctx.fillStyle='rgba(30,58,66,.48)';ctx.beginPath();ctx.ellipse(x+s*.5,y+s*.64,s*.29,s*.12,-.2,0,Math.PI*2);ctx.fill();
      ctx.strokeStyle='rgba(123,161,169,.23)';ctx.lineWidth=1;ctx.beginPath();ctx.moveTo(x+s*.34,y+s*.61);ctx.lineTo(x+s*.61,y+s*.59);ctx.stroke();
    }else if(n%11===0){
      ctx.strokeStyle='rgba(4,9,13,.65)';ctx.lineWidth=1;ctx.beginPath();ctx.moveTo(x+s*.2,y+s*.25);ctx.lineTo(x+s*.48,y+s*.47);ctx.lineTo(x+s*.4,y+s*.68);ctx.moveTo(x+s*.48,y+s*.47);ctx.lineTo(x+s*.7,y+s*.4);ctx.stroke();
    }
    if(wall&&n%3===0){ // Moss grows at wall feet; rubble stays out of the walkway.
      for(let i=0;i<7;i++){ctx.fillStyle=i%2?'#35453299':'#53634777';ctx.fillRect(x+((n>>(i*3))%38)/40*s,y+s*(.02+(i%3)*.025),s*.1,s*.045);}
    }
    if(wall&&n%7===0)for(let i=0;i<3;i++){ctx.fillStyle='#222c37';ctx.fillRect(x+s*(.15+i*.21),y+s*(.1+i%2*.07),s*.11,s*.065);ctx.fillStyle='#66707a66';ctx.fillRect(x+s*(.15+i*.21),y+s*(.1+i%2*.07),s*.1,1);}
  }else if(ch==='#'&&pokermonRenderTileAt(wx,wy+1)==='.'&&n%9===0){
    // A faded hanging banner supplies a landmark without adding collision.
    ctx.fillStyle='#302b2d';ctx.fillRect(x+s*.29,y+s*.12,s*.42,s*.06);
    ctx.fillStyle=['#65433f','#3d5360','#57503b'][S.floor%3];ctx.beginPath();ctx.moveTo(x+s*.34,y+s*.18);ctx.lineTo(x+s*.65,y+s*.18);ctx.lineTo(x+s*.65,y+s*.7);ctx.lineTo(x+s*.5,y+s*.61);ctx.lineTo(x+s*.34,y+s*.72);ctx.closePath();ctx.fill();
    ctx.strokeStyle='#b29a5c88';ctx.lineWidth=1;ctx.strokeRect(x+s*.43,y+s*.3,s*.12,s*.19);
  }
  ctx.restore();
}

function launchPokerCards(cards){
  if(reducedMotion())return 0;
  const arena=ge('battlefield'),player=ge('player-sprite-wrap'),enemy=ge('enemy-sprite-wrap');
  if(!arena||!player||!enemy)return 0;
  const box=arena.getBoundingClientRect(),p=player.getBoundingClientRect(),e=enemy.getBoundingClientRect();
  if(!box.width||!box.height)return 0;
  const sx=(arena.clientWidth||box.width)/box.width,sy=(arena.clientHeight||box.height)/box.height;
  const x=(p.left+p.width*.65-box.left)*sx,y=(p.top+p.height*.42-box.top)*sy;
  const dx=(e.left+e.width*.5-box.left)*sx-x,dy=(e.top+e.height*.5-box.top)*sy-y;
  const owner=S,nodes=[];
  player.classList.add('hero-cast');
  cards.forEach((card,i)=>{
    const el=document.createElement('span');el.className='flying-card';el.setAttribute('aria-hidden','true');
    el.textContent=pokerRankLabel(card.rank)+POKER_SUITS[card.suit];
    if(card.suit==='H'||card.suit==='D')el.style.color='#ac3540';
    el.style.left=x+'px';el.style.top=y+'px';el.style.setProperty('--dx',dx+'px');el.style.setProperty('--dy',dy+'px');
    el.style.animationDelay=(i*25)+'ms';arena.appendChild(el);nodes.push(el);
  });
  const duration=360+(cards.length-1)*25;
  let last=performance.now(),elapsed=0;
  const clean=()=>{nodes.forEach(n=>n.remove());player.classList.remove('hero-cast');player.style.animationPlayState='';};
  function frame(now){
    if(S!==owner||S.mode!=='cmb'||S.runEnded){clean();return;}
    if(!S.paused)elapsed+=now-last;last=now;
    nodes.forEach(n=>n.style.animationPlayState=S.paused?'paused':'running');player.style.animationPlayState=S.paused?'paused':'running';
    if(elapsed>duration+60){clean();return;}requestAnimationFrame(frame);
  }
  requestAnimationFrame(frame);return duration;
}

function battleFloat(target,value,kind='damage'){
  if(S.mode!=='cmb'||!value)return;
  const arena=ge('battlefield');if(!arena)return;
  const el=document.createElement('span');el.className=`battle-number ${target} ${kind}${kind==='damage'&&value>=50?' heavy':''}`;
  el.textContent=kind==='notice'?String(value):kind==='heal'?`+${value}`:`−${value}`;
  el.setAttribute('aria-hidden','true');arena.appendChild(el);
  el.addEventListener('animationend',()=>el.remove(),{once:true});
  setTimeout(()=>el.remove(),1300);
}


/* Slate floor artwork shares the battle palette; one texture spans 2×2 map cells. */
var slateFloorImage=new Image();
slateFloorImage.src='data:image/png;base64,