function doorVisualOpen(door){
  if(!door) return 0;
  const base = door.state==='open' ? 1 : 0;
  if(!door.anim) return base;
  const now = (typeof performance!=='undefined' ? performance.now() : Date.now());
  const dur = Math.max(1, door.anim.dur || 170);
  const raw = Math.max(0, Math.min(1, (now - door.anim.t0) / dur));
  const t = raw*raw*(3 - 2*raw); // smoothstep
  const value = door.anim.from + (door.anim.to - door.anim.from) * t;
  if(raw >= 1) door.anim = null;
  return value;
}

function setDoorState(door,newState){
  if(!door || door.state===newState) return;
  const now = (typeof performance!=='undefined' ? performance.now() : Date.now());
  const from = doorVisualOpen(door);
  door.state = newState;
  door.anim = { from, to: newState==='open' ? 1 : 0, t0: now, dur: reducedMotion()?1:170 };
}

function operateFacingDoor(){
  if(S.processing||S.paused)return false;
  requestSave();
  const fx = S.p.x + DX[S.facing];
  const fy = S.p.y + DY[S.facing];
  const t = S.map.grid?.[fy]?.[fx];
  if(t==='§'){
    SFX.shop();
    log('You browse the little shop.','s');
    openShop();
    return true;
  }
  const door = (S.doors||[]).find(d=>d.x===fx && d.y===fy);
  if(!door) return false;
  if(door.state==='closed'){
    setDoorState(door,'open');
    SFX.step();
    log(`You open the ${door.type} door.`,'e');
  } else if(door.state==='open'){
    const blocked = (S.enemies||[]).find(e=>!e.dead && e.x===fx && e.y===fy);
    if(!blocked){
      setDoorState(door,'closed');
      SFX.bump();
      log(`You close the ${door.type} door.`,'e');
    } else {
      log('Something blocks the door!','d');
    }
  }
  renderView();updateDUI();
  return true;
}

function movePlayer(dx,dy){
  requestSave();
  if(S.processing||S.mode!=='dun')return;
  const p=S.p;
  const nx=p.x+dx,ny=p.y+dy;
  if(nx<0||nx>=MW||ny<0||ny>=MH)return;

  const door=(S.doors||[]).find(d=>d.x===nx&&d.y===ny);
  if(door&&door.state==='closed'){
    S.facing = dx===1?1:dx===-1?3:dy===1?2:0;
    setDoorState(door,'open');
    SFX.step();
    log(`You open the ${door.type} door.`,'e');
    updateSeen();renderView();updateDUI();
    return;
  }

  const t=S.map.grid[ny][nx];
  if(t==='§'){
    S.facing = dx===1?1:dx===-1?3:dy===1?2:0;
    SFX.shop();
    log('You browse the little shop.','s');
    openShop();
    return;
  }
  if(isBlocked(nx,ny)){
    SFX.bump();
    return;
  }
  const en=S.enemies.find(e=>!e.dead&&e.x===nx&&e.y===ny);
  if(en){
    if(en.isBoss){SFX.boss();log(`★ BOSS: ${en.def.name} blocks your path! ★`,'d');}
    else{SFX.fight();log(`You attack the ${en.def.name}!`,'c');}
    startCombat(en);return;
  }
  p.x=nx;p.y=ny;
  if(t==='>'){
    if(S.floor===10&&!S.kingDead){
      SFX.bump();log('The King still lives. You cannot escape.','d');return;
    }
    SFX.stairs();descend();return;
  }
  if(t==='$'){openTreasure();return;}
  SFX.step();
  updateSeen();
  moveEnemies();
  updateDUI();
}

/* ═══════════════════════════════════════
   SHOP (same)
═══════════════════════════════════════ */
function openShop(reroll=false,entered=false){
  if(S.mode==='dun'&&!entered){dungeonPassage('shop',()=>openShop(reroll,true));return;}
  requestSave();
  S.mode='shop';
  if(reroll||!S.shopItems){
    if(reroll){
      const cost=15*Math.max(1,S.shopRerolls);
      if(S.p.gold<cost){SFX.badswap();log(`Need ${cost}G to reroll!`,'e');return;}
      S.p.gold-=cost;S.shopRerolls++;updateDUI();
    }
    const pool=[...SHOP_ITEMS];
    for(let i=pool.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[pool[i],pool[j]]=[pool[j],pool[i]];}
    S.shopItems=pool.slice(0,6);
  }
  if(S.shopIdx===undefined)S.shopIdx=0;
  S.shopIdx=Math.max(0,Math.min(S.shopIdx,S.shopItems.length-1));
  ge('shop-gold-disp').textContent=S.p.gold;
  ge('shop-hp-disp').textContent=`${S.p.hp}/${S.p.maxHp}`;
  ge('shop-mp-disp').textContent=`${S.p.mp}/${S.p.maxMp}`;
  const nextRerollCost=15*Math.max(1,S.shopRerolls);
  const canReroll=S.p.gold>=nextRerollCost;
  const c=ge('shop-items-list');c.innerHTML='';
  S.shopItems.forEach((item,i)=>{
    const cost=item.cost(S.floor);const ok=S.p.gold>=cost;const isSel=i===S.shopIdx;
    const div=document.createElement('div');
    div.className='shop-row'+(isSel?' shop-sel':'');
    div.setAttribute('role','button');
    div.tabIndex=0;
    div.title=isSel?'Click again to buy':'Click to select';
    div.innerHTML=`<div class="shop-info"><div class="shop-name">${isSel?'▶ ':'\u00a0\u00a0'}${item.icon} ${item.name}</div><div class="shop-desc">${item.desc}</div></div><span class="shop-cost" style="color:${ok?'var(--am)':'#554400'}">${cost}G</span><span style="font-size:12px;color:${ok?(isSel?'var(--g)':'var(--dg)'):'#333'}">${ok?(isSel?'[CLICK BUY]':'[CLICK]'):'X'}</span>`;
    div.addEventListener('click',()=>{
      if(S.shopIdx===i){buyItem(i);}
      else{S.shopIdx=i;SFX.cursor();openShop();}
    });
    c.appendChild(div);
  });
  const actionBar=document.createElement('div');
  actionBar.className='shop-actionbar';
  const leaveBtn=document.createElement('div');
  leaveBtn.className='shop-action';
  leaveBtn.textContent='LEAVE';
  leaveBtn.title='Close shop';
  leaveBtn.addEventListener('click',()=>{SFX.cursor();closeShop();});
  const rerollBtn=document.createElement('div');
  rerollBtn.className='shop-action'+(canReroll?'':' disabled');
  rerollBtn.textContent=`REROLL ${nextRerollCost}G`;
  rerollBtn.title=canReroll?'Roll a fresh stock':'Not enough gold';
  rerollBtn.addEventListener('click',()=>{
    if(!canReroll){SFX.badswap();return;}
    SFX.shop();openShop(true);
  });
  actionBar.appendChild(leaveBtn);
  actionBar.appendChild(rerollBtn);
  c.appendChild(actionBar);
  const hint=document.createElement('div');
  hint.className='shop-hint';
  hint.textContent='Mouse: click to select, click again to buy. Keys: ↑/↓ move · Enter buy · R reroll · Esc leave. Pad: ↑/↓ move · A buy · Y reroll · B leave.';
  c.appendChild(hint);
  ge('shop-overlay').classList.add('on');
}
function buyItem(i){
  const item=S.shopItems[i];if(!item)return;
  const cost=item.cost(S.floor);
  if(S.p.gold<cost){SFX.badswap();return;}
  S.p.gold-=cost;S._lastShopCost=cost;item.apply(S.p,S);delete S._lastShopCost;
  SFX.buy();log(`Bought: ${item.name}`,'l');
  openShop();updateDUI();
}
function closeShop(){
  requestSave();
  S.mode='dun';
  ge('shop-overlay').classList.remove('on');
  renderView();updateDUI();
}

