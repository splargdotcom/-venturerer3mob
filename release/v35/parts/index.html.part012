function drawSpecialTile(ctx,label,rect,bright,color,symbol){
  const cx=(rect.l+rect.r)/2,cy=(rect.t+rect.b)/2;
  const sz=Math.max(8,(rect.b-rect.t)*0.5);

  // Pick image sprite key
  const imgKey = symbol==='▼'?'stairs':symbol==='$'?'chest':symbol==='§'?'merchant':null;
  const sprImg = imgKey ? SPRITE_IMGS[imgKey] : null;

  // Pick fallback pixel sprite
  let spr=null;
  if(symbol==='▼') spr=ITEM_SPRITES.stairs;
  else if(symbol==='$') spr=ITEM_SPRITES.chest;
  else if(symbol==='§') spr=ITEM_SPRITES.merchant;

  if(sprImg && sprImg.complete && sz > 6){
    const aspect = sprImg.width / sprImg.height;
	const scale = SPRITE_SCALE[imgKey] || 1.0;
let sw = sz * 1.6 * scale, sh = sw / aspect;
if(sh > sz * 1.6 * scale){ sh = sz * 1.6 * scale; sw = sh * aspect; }
	const yOff = (symbol==='▼') ? sh*0.1 : -sh/2;
    const yPos = cy + sz*0.7 - sh;
drawImageSprite(ctx, sprImg, cx - sw/2, yPos, sw, sh, bright);
    // Glow underneath
    const gc = symbol==='▼'?[85,187,204]:symbol==='$'?[200,168,78]:[187,136,221];
    const glow = ctx.createRadialGradient(cx, cy, sz*0.1, cx, cy, sz*0.6);
    glow.addColorStop(0, `rgba(${gc[0]},${gc[1]},${gc[2]},${0.15*bright})`);
    glow.addColorStop(1, 'rgba(0,0,0,0)');
    ctx.fillStyle = glow;
    ctx.fillRect(cx-sz, cy-sz, sz*2, sz*2);
  } else if(spr && sz > 6){
    const aspect = spr.w / spr.h;
    let sw = sz * 1.4, sh = sw / aspect;
    if(sh > sz * 1.4){ sh = sz * 1.4; sw = sh * aspect; }
    drawPixelSprite(ctx, spr, cx - sw/2, cy - sh/2, sw, sh, bright);
    const gc = symbol==='▼'?[85,187,204]:symbol==='$'?[200,168,78]:[187,136,221];
    const glow = ctx.createRadialGradient(cx, cy, sz*0.1, cx, cy, sz*0.6);
    glow.addColorStop(0, `rgba(${gc[0]},${gc[1]},${gc[2]},${0.15*bright})`);
    glow.addColorStop(1, 'rgba(0,0,0,0)');
    ctx.fillStyle = glow;
    ctx.fillRect(cx-sz, cy-sz, sz*2, sz*2);
  } else {
    ctx.font=`bold ${Math.floor(sz)}px "VT323",monospace`;
    ctx.fillStyle=color;ctx.textAlign='center';ctx.textBaseline='middle';
    ctx.fillText(symbol,cx,cy);
  }

}

function drawGroundItem(ctx,tile){
  const label=tile==='>'?'STAIRS — PRESS FORWARD':tile==='$'?'TREASURE CHEST':'SHOP — PRESS F';
  const color=tile==='>'?'#55bbcc':tile==='$'?'#c8a84e':'#bb88dd';
  // Stone-framed indicator bar at bottom
  ctx.fillStyle='rgba(20,16,10,0.75)';
  ctx.fillRect(VW/2-160,VH-34,320,28);
  ctx.strokeStyle='#3a2e1e';ctx.lineWidth=1;
  ctx.strokeRect(VW/2-160,VH-34,320,28);
  ctx.font='18px "VT323",monospace';ctx.textAlign='center';
  ctx.fillStyle=color;ctx.shadowColor=color;ctx.shadowBlur=8;
  ctx.fillText('▼ '+label+' ▼',VW/2,VH-15);ctx.shadowBlur=0;ctx.textAlign='left';
}

/* ═══════════════════════════════════════
   VISIBILITY / SEEN
═══════════════════════════════════════ */
function updateSeen(){
  const R=6;
  for(let dy=-R;dy<=R;dy++)for(let dx=-R;dx<=R;dx++){
    if(dx*dx+dy*dy>R*R)continue;
    const nx=S.p.x+dx,ny=S.p.y+dy;
    if(nx>=0&&nx<MW&&ny>=0&&ny<MH)S.seen[ny][nx]=true;
  }
}

/* ═══════════════════════════════════════
   ENEMY AI
═══════════════════════════════════════ */
function moveEnemies(){
  if(S.mode!=='dun')return;
  let combatTriggered=false;
  for(const en of S.enemies){
    if(en.dead||combatTriggered)continue;
    const dx=S.p.x-en.x,dy=S.p.y-en.y;
    const dist=Math.abs(dx)+Math.abs(dy);
    if(dist>14)continue;
    if(dist===0)continue;
    const steps=en.def.speed||1;
    for(let step=0;step<steps&&!combatTriggered;step++){
      const cdx=S.p.x-en.x,cdy=S.p.y-en.y;
      if(Math.abs(cdx)+Math.abs(cdy)===0)break;
      const cands=[];
      if(cdx!==0)cands.push([Math.sign(cdx),0]);
      if(cdy!==0)cands.push([0,Math.sign(cdy)]);
      if(cands.length===2&&Math.random()<0.3)cands.reverse();
      if(cands.length===2)cands.push(cands[Math.floor(Math.random()*2)]);
      let moved=false;
      for(const[mx,my]of cands){
        const nx=en.x+mx,ny=en.y+my;
        if(nx<0||nx>=MW||ny<0||ny>=MH)continue;
         if(isBlocked(nx,ny))continue;
        if(S.enemies.some(e=>!e.dead&&e!==en&&e.x===nx&&e.y===ny))continue;
        if(nx===S.p.x&&ny===S.p.y){
          combatTriggered=true;SFX.fight();
          log(`The ${en.def.name} charges you!`,'d');
          S.processing=true;scheduleGame(()=>{S.processing=false;startCombat(en);},60);break;
        }
        en.x=nx;en.y=ny;
        if(step===0)SFX.enMove();
        moved=true;break;
      }
      if(!moved||combatTriggered)break;
    }
  }
  if(!combatTriggered){renderView();}
}

/* ═══════════════════════════════════════
   PLAYER MOVEMENT (first person)
═══════════════════════════════════════ */
function faceDir(f){
  if(S.facing!==f){
    S.facing=f;
    SFX.turn();
    updateSeen();renderView();updateDUI();
  }
}
function moveNorth(){ faceDir(0); movePlayer(0,-1); }
function moveEast(){ faceDir(1); movePlayer(1,0); }
function moveSouth(){ faceDir(2); movePlayer(0,1); }
function moveWest(){ faceDir(3); movePlayer(-1,0); }

