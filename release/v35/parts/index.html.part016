';

var slateFloorCache=null;
function drawSlateFloor(ctx,x,y,size,wx,wy){
  if(!slateFloorImage.complete||!slateFloorImage.naturalWidth)return false;
  if(!slateFloorCache){
    slateFloorCache=document.createElement('canvas');slateFloorCache.width=128;slateFloorCache.height=128;
    const c=slateFloorCache.getContext('2d');c.imageSmoothingEnabled=true;c.drawImage(slateFloorImage,0,0,128,128);
  }
  const u=((wx%2)+2)%2*64,v=((wy%2)+2)%2*64;
  ctx.save();ctx.imageSmoothingEnabled=false;ctx.drawImage(slateFloorCache,u,v,64,64,x,y,size,size);ctx.restore();
  return true;
}

window.addEventListener('resize',()=>{ if(S.mode==='cmb') requestAnimationFrame(renderCombatSprites); });
</script>
</body>
</html>
